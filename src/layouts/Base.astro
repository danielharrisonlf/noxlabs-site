---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MobileCta from "../components/MobileCta.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Caminho canônico, com barra final: "/" ou "/casos/clinicflow/". */
  path: string;
  type?: "website" | "article";
  /** JSON-LD adicional desta página. */
  schema?: Record<string, unknown>[];
  /** Assunto do e-mail dos botões fixos desta página. */
  mailto?: string;
}

const { title = site.title, description = site.description, path, type = "website", schema = [], mailto = site.talkMailto } = Astro.props;

const canonical = new URL(path, site.url).href;
const ogImage = new URL("/og.png", site.url).href;

const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${site.url}/#org`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  image: ogImage,
  email: site.email,
  description: site.description,
  areaServed: { "@type": "Country", name: "Brasil" },
  founder: { "@id": `${site.url}/#daniel` },
  sameAs: [site.links.linkedin],
  knowsAbout: [
    "Automação de processos para escritórios de contabilidade",
    "Automação de rotinas administrativas",
    "Atendimento por WhatsApp com inteligência artificial",
    "Sistemas sob medida para empresas",
    "Integração entre sistemas de gestão, planilhas e bancos",
    "Painéis de gestão e relatórios",
    "LGPD em sistemas e automações",
  ],
  makesOffer: [
    "Automação de rotinas",
    "Atendimento e WhatsApp com IA",
    "Sistemas sob medida",
    "Integração entre sistemas",
    "Painéis e relatórios para gestores",
    "Diagnóstico de processos",
  ].map((name) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name } })),
};

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site.url}/#daniel`,
  name: site.founder.name,
  jobTitle: site.founder.role,
  url: site.links.portfolio,
  image: `${site.url}/img/daniel-harrison.webp`,
  email: site.email,
  worksFor: { "@id": `${site.url}/#org` },
  sameAs: [site.links.linkedin, site.links.portfolio, site.links.github],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}/#site`,
  url: site.url,
  name: site.name,
  inLanguage: "pt-BR",
  publisher: { "@id": `${site.url}/#org` },
};

const graph = [org, person, website, ...schema];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.founder.name} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f8f4" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Noxlabs: sua equipe não foi contratada para copiar e colar. Ao lado, uma lista de exemplo com rotinas de escritório marcadas como feitas."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/bricolage-grotesque-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/figtree-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add("js");
      // Entradas por rolagem só quando há script e movimento permitido (ver global.css).
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("reveal-on");
      }
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header mailto={mailto} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileCta mailto={mailto} />
    <script>
      import { initMotion } from "../scripts/motion";

      initMotion();
    </script>
  </body>
</html>
