---
import Contact from "../../components/Contact.astro";
import Icon from "../../components/Icon.astro";
import { type CaseStudy, detailCases, srcset } from "../../data/cases";
import { site, talkMailto } from "../../data/site";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return detailCases.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const path = `/casos/${study.slug}/`;
const others = detailCases.filter((c) => c.slug !== study.slug);
const topic = `Um sistema como o ${study.name}`;

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${study.name}: ${study.summary}`,
  description: study.summary,
  inLanguage: "pt-BR",
  url: new URL(path, site.url).href,
  author: { "@id": `${site.url}/#daniel` },
  publisher: { "@id": `${site.url}/#org` },
  ...(study.image ? { image: new URL(study.image.src, site.url).href } : {}),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Noxlabs", item: site.url },
    { "@type": "ListItem", position: 2, name: "Casos", item: `${site.url}/#casos` },
    { "@type": "ListItem", position: 3, name: study.name, item: new URL(path, site.url).href },
  ],
};
---

<Base
  title={`${study.name}: ${study.summary.replace(/\.$/, "")} | Noxlabs`}
  description={`${study.summary} O problema do negócio, o que o sistema faz e o que muda na rotina.`}
  path={path}
  type="article"
  schema={[article, breadcrumb]}
  mailto={talkMailto(topic)}
>
  <article class="case" aria-labelledby="case-title">
    <header class="case-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Trilha">
          <a href="/#casos">O que já construí</a>
          <Icon name="arrow-right" />
          <span aria-current="page">{study.name}</span>
        </nav>
        <div class="case-intro">
          <div class="case-intro-copy">
            <span class="tag tag-done">{study.status}</span>
            <h1 id="case-title">{study.name}</h1>
            <p class="case-summary">{study.summary}</p>
          </div>
          <div class="case-side card">
            <p class="side-label">Serve para</p>
            <ul role="list" class="checks">
              {study.fits.map((f) => <li>{f}</li>)}
            </ul>
            <div class="case-actions" data-cta-anchor>
              <a class="btn btn-primary btn-block" href={talkMailto(topic)}>
                Quero algo assim na minha empresa
                <Icon name="arrow-right" />
              </a>
              {
                study.links.map((l) => (
                  <a class="text-link" href={l.href}>
                    {l.label}
                    <Icon name="arrow-up-right" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </header>

    {
      study.image && (
        <div class="wrap case-visual">
          <figure class="shot">
            <img
              src={study.image.src}
              srcset={srcset(study.image.src, study.image.width)}
              sizes="(min-width: 80rem) 76rem, 94vw"
              width={study.image.width}
              height={study.image.height}
              alt={study.image.alt}
              decoding="async"
              fetchpriority="high"
            />
            <figcaption>{study.image.caption}</figcaption>
          </figure>
        </div>
      )
    }

    <div class="wrap case-body">
      <section class="problem" aria-labelledby="b-problema" data-reveal>
        <h2 id="b-problema" class="block-title">O problema do negócio</h2>
        <p class="problem-text">{study.problem}</p>
      </section>

      <div class="duo">
        <section aria-labelledby="b-faz" data-reveal>
          <h2 id="b-faz" class="block-title">O que o sistema faz</h2>
          <ul role="list" class="checks">
            {study.does.map((d) => <li>{d}</li>)}
          </ul>
        </section>

        <section class="gains" aria-labelledby="b-ganho" data-reveal style="--i:1">
          <h2 id="b-ganho" class="block-title">O que muda na rotina</h2>
          <ul role="list" class="gain-list">
            {study.gains.map((g) => <li>{g}</li>)}
          </ul>
          <p class="gain-note">Ganhos descritos pelo que o sistema faz, não números medidos em uma empresa.</p>
        </section>
      </div>

      <details class="tech">
        <summary>
          <span>Detalhes técnicos, para quem cuida da TI</span>
          <Icon name="plus" />
        </summary>
        <ul role="list">
          {study.tech.map((t) => <li>{t}</li>)}
        </ul>
      </details>
    </div>

    <nav class="wrap case-next" aria-labelledby="next-title">
      <h2 id="next-title" class="block-title">Outros sistemas que construí</h2>
      <div class="next-list">
        {
          others.map((o, i) => (
            <a class="next" href={`/casos/${o.slug}/`} data-reveal style={`--i:${i}`}>
              <span class="next-icon">
                <Icon name={o.icon} />
              </span>
              <span class="next-name">{o.name}</span>
              <span class="next-summary">{o.summary}</span>
              <span class="next-go" aria-hidden="true">
                <Icon name="arrow-right" />
              </span>
            </a>
          ))
        }
      </div>
    </nav>
  </article>

  <Contact topic={topic} />
</Base>

<style>
  .case-head {
    padding: calc(var(--header-h) + clamp(1.5rem, 1rem + 3vw, 3.5rem)) 0 clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .case-head:has(+ .case-visual) {
    padding-bottom: clamp(6rem, 10vw, 10rem);
    background: var(--sunken);
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--caneta);
    font-weight: 700;
  }

  .crumbs :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .case-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    margin-top: var(--s-5);
    align-items: start;
  }

  .case-intro-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }

  .case-intro h1 {
    font-size: clamp(2.75rem, 1.6rem + 5vw, 6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .case-summary {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.3;
    max-width: 30ch;
  }

  .case-side {
    display: grid;
    gap: var(--s-4);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .side-label {
    font-weight: 700;
  }

  .case-actions {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }

  .case-visual {
    position: relative;
    margin-top: calc(-1 * clamp(4.5rem, 8vw, 8rem));
  }

  .shot {
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-3);
  }

  .shot img {
    width: 100%;
  }

  .shot figcaption {
    padding: var(--s-3) var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
    color: var(--ink-3);
  }

  .case-body {
    display: grid;
    gap: clamp(3.5rem, 6vw, 6rem);
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }

  .block-title {
    font-size: var(--t-xl);
    margin-bottom: var(--s-5);
  }

  .problem-text {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.4;
    max-width: 46ch;
  }

  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .gains {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--pine-deep);
    color: #f2f7f3;
  }

  .gain-list {
    display: grid;
    gap: var(--s-4);
  }

  .gain-list li {
    position: relative;
    padding-left: var(--s-5);
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 500;
    line-height: 1.35;
  }

  .gain-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 0.4rem;
    height: 1em;
    border-radius: 2px;
    background: var(--marca);
  }

  .gain-note {
    margin-top: var(--s-5);
    font-size: var(--t-xs);
    color: #c3d8cd;
  }

  .tech {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .tech summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.5rem;
    padding: var(--s-3) var(--s-5);
    font-weight: 700;
    color: var(--ink-2);
    cursor: pointer;
    list-style: none;
  }

  .tech summary::-webkit-details-marker {
    display: none;
  }

  .tech summary :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--d-base) var(--ease-spring);
  }

  .tech[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .tech ul {
    display: grid;
    gap: var(--s-2);
    padding: 0 var(--s-5) var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .case-next {
    padding-bottom: var(--section-y);
  }

  .next-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .next {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-6) 5rem var(--s-6) var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    text-decoration: none;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out);
  }

  .next-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-sm);
    background: var(--pine-soft);
    color: var(--pine-ink);
  }

  .next-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .next-name {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .next-summary {
    color: var(--ink-2);
    font-size: var(--t-sm);
    max-width: 44ch;
  }

  .next-go {
    position: absolute;
    right: var(--s-5);
    top: var(--s-5);
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--sunken);
    transition:
      background-color var(--d-base) var(--ease-out),
      transform var(--d-base) var(--ease-spring);
  }

  .next-go :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  @media (hover: hover) {
    .next:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-2);
    }
    .next:hover .next-go {
      background: var(--marca);
      transform: translateX(3px);
    }
  }

  @media (max-width: 63.99rem) {
    .case-intro,
    .duo,
    .next-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .next {
      padding: var(--s-5) 4.25rem var(--s-5) var(--s-5);
    }

    .next-go {
      right: var(--s-4);
      top: var(--s-4);
    }
  }
</style>
