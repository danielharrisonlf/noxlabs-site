---
import Contact from "../../components/Contact.astro";
import Icon from "../../components/Icon.astro";
import KairosDiagram from "../../components/KairosDiagram.astro";
import { type CaseStudy, detailCases } from "../../data/cases";
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return detailCases.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const path = `/casos/${study.slug}/`;
const others = detailCases.filter((c) => c.slug !== study.slug);
const isKairos = study.slug === "kairos";

/* Caminho de um evento no Kairos: é uma sequência real, por isso numerada. */
const eventFlow = [
  { title: "Comando", text: "Uma pessoa ou um agente altera uma tarefa com o próprio token." },
  { title: "Transação", text: "A alteração e o evento entram no PostgreSQL juntos, ou nenhum dos dois entra." },
  { title: "Relay", text: "Um processo reivindica os eventos pendentes, com prazo de posse e nova tentativa." },
  { title: "Filas", text: "Cada evento segue para tempo real, notificações e auditoria, com o próprio ID como chave." },
  { title: "Consumidores", text: "Cada serviço deduplica pelo ID e atualiza a tela, avisa as pessoas ou grava a trilha." },
];

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${study.name}: ${study.summary}`,
  description: study.summary,
  inLanguage: "pt-BR",
  url: new URL(path, site.url).href,
  author: { "@id": `${site.url}/#daniel` },
  publisher: { "@id": `${site.url}/#org` },
  ...(study.image ? { image: new URL(study.image.src, site.url).href } : {}),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Noxlabs", item: site.url },
    { "@type": "ListItem", position: 2, name: "Casos", item: `${site.url}/#casos` },
    { "@type": "ListItem", position: 3, name: study.name, item: new URL(path, site.url).href },
  ],
};
---

<Base
  title={`${study.name}: estudo de caso | Noxlabs`}
  description={`${study.summary} Problema, solução, arquitetura e resultado, contados como foram.`}
  path={path}
  type="article"
  schema={[article, breadcrumb]}
>
  <article class="case" aria-labelledby="case-title">
    <header class="wrap grid case-head">
      <nav class="crumbs" aria-label="Trilha">
        <a href="/#casos">Casos</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{study.name}</span>
      </nav>
      <h1 id="case-title">{study.name}</h1>
      <p class="case-summary">{study.summary}</p>
      <dl class="case-facts">
        <div>
          <dt>Situação</dt>
          <dd class:list={{ live: study.status.live }}>{study.status.label}</dd>
        </div>
        <div>
          <dt>O que comprova</dt>
          <dd>{study.proves}</dd>
        </div>
      </dl>
      <div class="case-links">
        {
          study.links.map((l, i) => (
            <a class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]} href={l.href}>
              {l.label}
              <Icon name="arrow-up-right" />
            </a>
          ))
        }
      </div>
    </header>

    <div class="wrap case-visual">
      {isKairos && <KairosDiagram id="kd-case" />}
      {
        study.image && (
          <figure class="shot">
            <img
              src={study.image.src}
              width={study.image.width}
              height={study.image.height}
              alt={study.image.alt}
              decoding="async"
              fetchpriority="high"
            />
            <figcaption>{study.image.caption}</figcaption>
          </figure>
        )
      }
    </div>

    <div class="wrap grid case-body">
      <section class="block" aria-labelledby="b-problema">
        <h2 id="b-problema">O problema</h2>
        <div class="block-content">
          <p class="block-lede">{study.problem}</p>
        </div>
      </section>

      <section class="block" aria-labelledby="b-construido">
        <h2 id="b-construido">O que construí</h2>
        <div class="block-content">
          <ul role="list" class="squares">
            {study.built.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </section>

      {
        isKairos && (
          <section class="block" aria-labelledby="b-evento">
            <h2 id="b-evento">O caminho de um evento</h2>
            <div class="block-content">
              <ol role="list" class="flow">
                {eventFlow.map((s, i) => (
                  <li>
                    <span class="flow-num tabular" aria-hidden="true">
                      {i + 1}
                    </span>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )
      }

      {
        study.architecture && (
          <section class="block" aria-labelledby="b-arquitetura">
            <h2 id="b-arquitetura">Arquitetura e decisões</h2>
            <div class="block-content">
              <ul role="list" class="squares">
                {study.architecture.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      <section class="block" aria-labelledby="b-resultado">
        <h2 id="b-resultado">Resultado</h2>
        <div class="block-content">
          <ul role="list" class="outcomes">
            {study.outcome.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      </section>

      {
        study.limits && (
          <section class="block" aria-labelledby="b-limites">
            <h2 id="b-limites">Limites conhecidos</h2>
            <div class="block-content">
              <ul role="list" class="squares squares-ink">
                {study.limits.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      <section class="block" aria-labelledby="b-stack">
        <h2 id="b-stack">Stack</h2>
        <div class="block-content">
          <ul role="list" class="stack">
            {study.stack.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </section>
    </div>

    <nav class="wrap grid case-next" aria-label="Outros casos">
      {
        others.map((o) => (
          <a class="next" href={`/casos/${o.slug}/`}>
            <span class="next-label">Próximo caso</span>
            <span class="next-name">{o.name}</span>
            <span class="next-summary">{o.summary}</span>
            <Icon name="arrow-right" class="next-icon" />
          </a>
        ))
      }
    </nav>
  </article>

  <Contact />
</Base>

<style>
  .case-head {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) var(--s-7);
    row-gap: var(--s-5);
    align-items: end;
  }

  .crumbs {
    grid-column: 1 / -1;
    display: flex;
    gap: var(--s-2);
    font-size: var(--t-sm);
    color: var(--fg-2);
  }

  .crumbs a {
    color: var(--link);
    font-weight: 600;
  }

  .case-head h1 {
    grid-column: 1 / -1;
    font-size: clamp(3.25rem, 1.8rem + 7vw, 9rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }

  .case-summary {
    grid-column: 1 / span 7;
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    max-width: 26ch;
  }

  .case-facts {
    grid-column: 8 / -1;
    display: grid;
    gap: var(--s-3);
    font-size: var(--t-sm);
  }

  .case-facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }

  .case-facts dt {
    color: var(--fg-2);
  }

  .case-facts dd {
    font-weight: 600;
  }

  .case-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .case-visual {
    margin-bottom: var(--section-y);
  }

  .shot {
    border: 1px solid var(--rule-strong);
    background: var(--bg-2);
  }

  .shot img {
    width: 100%;
  }

  .shot figcaption {
    padding: var(--s-3) var(--s-4);
    border-top: 1px solid var(--rule);
    font-size: var(--t-xs);
    color: var(--fg-2);
  }

  .case-body {
    row-gap: 0;
  }

  .block {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: var(--s-4);
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule-strong);
  }

  .block h2 {
    grid-column: 1 / span 4;
    font-size: var(--t-xl);
  }

  .block-content {
    grid-column: 6 / -1;
    max-width: 62ch;
  }

  .block-lede {
    font-size: var(--t-md);
    line-height: 1.55;
  }

  .squares li,
  .outcomes li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--fg-2);
  }

  .squares li + li,
  .outcomes li + li {
    margin-top: var(--s-3);
  }

  .squares li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--anil);
  }

  .squares-ink li::before {
    background: var(--fg);
  }

  .outcomes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.65rem;
    height: 0.65rem;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
  }

  .outcomes li:first-child {
    color: var(--fg);
    font-weight: 500;
  }

  .flow {
    display: grid;
    gap: 0;
  }

  .flow li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .flow li:first-child {
    padding-top: 0;
  }

  .flow-num {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 1;
    color: var(--link);
  }

  .flow h3 {
    font-family: var(--font-text);
    font-size: var(--t-base);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .flow p {
    color: var(--fg-2);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .stack li {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--rule-strong);
    font-size: var(--t-sm);
    font-weight: 500;
  }

  .case-next {
    padding-block: var(--s-8) var(--section-y);
    row-gap: var(--col-gap);
  }

  .next {
    grid-column: span 6;
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-6) var(--s-8) var(--s-6) var(--s-6);
    border: 1px solid var(--rule-strong);
    text-decoration: none;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }

  .next-label {
    font-size: var(--t-sm);
    color: var(--fg-2);
  }

  .next-name {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 1.1;
  }

  .next-summary {
    color: var(--fg-2);
    font-size: var(--t-sm);
    max-width: 44ch;
  }

  .next :global(.next-icon) {
    position: absolute;
    right: var(--s-6);
    top: var(--s-6);
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (hover: hover) {
    .next:hover {
      background: var(--fg);
      color: var(--bg);
    }
    .next:hover .next-label,
    .next:hover .next-summary {
      color: var(--bg);
    }
  }

  @media (max-width: 63.99rem) {
    .case-summary,
    .case-facts,
    .block h2,
    .block-content {
      grid-column: 1 / -1;
    }
    .next {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .case-facts div {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
    .case-links .btn {
      width: 100%;
    }
  }
</style>
