---
import Contact from "../../components/Contact.astro";
import Icon from "../../components/Icon.astro";
import KairosFlow from "../../components/KairosFlow.astro";
import { type CaseStudy, detailCases, srcset } from "../../data/cases";
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return detailCases.map((c) => ({ params: { slug: c.slug }, props: { study: c } }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const path = `/casos/${study.slug}/`;
const others = detailCases.filter((c) => c.slug !== study.slug);
const isKairos = study.slug === "kairos";

/* "Medido: ..." e "Qualitativo: ..." viram um rótulo e o texto. */
const outcomes = study.outcome.map((o) => {
  const match = o.match(/^(Medido|Qualitativo):\s*(.+)$/);
  if (!match) return { kind: null, text: o };
  const text = match[2];
  return { kind: match[1], text: text.charAt(0).toUpperCase() + text.slice(1) };
});

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: `${study.name}: ${study.summary}`,
  description: study.summary,
  inLanguage: "pt-BR",
  url: new URL(path, site.url).href,
  author: { "@id": `${site.url}/#daniel` },
  publisher: { "@id": `${site.url}/#org` },
  ...(study.image ? { image: new URL(study.image.src, site.url).href } : {}),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Noxlabs", item: site.url },
    { "@type": "ListItem", position: 2, name: "Casos", item: `${site.url}/#casos` },
    { "@type": "ListItem", position: 3, name: study.name, item: new URL(path, site.url).href },
  ],
};
---

<Base
  title={`${study.name}: estudo de caso | Noxlabs`}
  description={`${study.summary} Problema, solução, arquitetura e resultado, contados como foram.`}
  path={path}
  type="article"
  schema={[article, breadcrumb]}
>
  <article class="case" aria-labelledby="case-title">
    <header class="case-sky grain">
      <div class="wrap case-head">
        <nav class="crumbs" aria-label="Trilha">
          <a href="/#casos">Casos</a>
          <Icon name="arrow-right" class="crumb-sep" />
          <span aria-current="page">{study.name}</span>
        </nav>
        <h1 id="case-title" style={`view-transition-name: title-${study.slug}`}>{study.name}</h1>
        <div class="case-intro">
          <p class="case-summary">{study.summary}</p>
          <div class="case-side">
            <dl class="case-facts">
              <div>
                <dt>Situação</dt>
                <dd class:list={{ live: study.status.live }}>{study.status.label}</dd>
              </div>
              <div>
                <dt>Serviço relacionado</dt>
                <dd>{study.proves}</dd>
              </div>
            </dl>
            <div class="case-links" data-cta-anchor>
              {
                study.links.map((l, i) => (
                  <a class:list={["btn", i === 0 ? "btn-primary" : "btn-ghost"]} href={l.href}>
                    {l.label}
                    <Icon name="arrow-up-right" />
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </header>

    {
      study.image && (
        <div class="wrap case-visual">
          <figure class="shot">
            <img
              src={study.image.src}
              srcset={srcset(study.image.src, study.image.width)}
              sizes="(min-width: 84rem) 80rem, 94vw"
              width={study.image.width}
              height={study.image.height}
              alt={study.image.alt}
              decoding="async"
              fetchpriority="high"
              style={`view-transition-name: shot-${study.slug}`}
            />
            <figcaption>{study.image.caption}</figcaption>
          </figure>
        </div>
      )
    }

    <div class="wrap case-body">
      <section class="problem" aria-labelledby="b-problema" data-reveal>
        <h2 id="b-problema" class="block-title">O problema</h2>
        <p class="problem-text">{study.problem}</p>
      </section>

      {
        isKairos && (
          <section class="walk" aria-labelledby="b-pedido">
            <div class="walk-head" data-reveal>
              <h2 id="b-pedido" class="block-title">Siga um pedido</h2>
              <p>
                O caminho de um pedido feito a um agente de IA, do seu login à trilha de auditoria. Use os passos ou deixe
                reproduzir.
              </p>
            </div>
            <KairosFlow id="kf-case" />
          </section>
        )
      }

      <div class="duo">
        <section aria-labelledby="b-construido" data-reveal="left">
          <h2 id="b-construido" class="block-title">O que construí</h2>
          <ul role="list" class="dots">
            {study.built.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </section>

        {
          study.architecture && (
            <section aria-labelledby="b-arquitetura" data-reveal="right" style="--i:1">
              <h2 id="b-arquitetura" class="block-title">Arquitetura e decisões</h2>
              <ul role="list" class="dots dots-cool">
                {study.architecture.map((a) => (
                  <li>{a}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <section class="result" aria-labelledby="b-resultado" data-reveal="stage">
        <h2 id="b-resultado" class="block-title">Resultado</h2>
        <ul role="list" class="outcomes">
          {
            outcomes.map((o) => (
              <li class:list={{ "is-measured": o.kind === "Medido" }}>
                {o.kind && <span class="outcome-kind">{o.kind}</span>}
                <p>{o.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="duo duo-end">
        {
          study.limits && (
            <section class="limits" aria-labelledby="b-limites" data-reveal>
              <h2 id="b-limites" class="block-title">Limites conhecidos</h2>
              <ul role="list" class="dots dots-warm">
                {study.limits.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
            </section>
          )
        }

        <section aria-labelledby="b-stack" data-reveal style="--i:1">
          <h2 id="b-stack" class="block-title">Stack</h2>
          <ul role="list" class="chips">
            {study.stack.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <nav class="wrap case-next" aria-labelledby="next-title">
      <h2 id="next-title" class="block-title">Outros casos</h2>
      <div class="next-list">
        {
          others.map((o) => (
            <a class="next" href={`/casos/${o.slug}/`} data-reveal style={`--i:${others.indexOf(o)}`}>
              <span class="next-name" style={`view-transition-name: title-${o.slug}`}>
                {o.name}
              </span>
              <span class="next-summary">{o.summary}</span>
              <span class="next-go" aria-hidden="true">
                <Icon name="arrow-right" />
              </span>
            </a>
          ))
        }
      </div>
    </nav>
  </article>

  <Contact />
</Base>

<style>
  .case-sky {
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(2rem, 5vw, 5rem)) 0 clamp(3rem, 6vw, 6rem);
    background:
      radial-gradient(70% 55% at 20% 85%, var(--haze), transparent 70%),
      radial-gradient(70% 60% at 100% 0%, var(--haze-2), transparent 60%),
      linear-gradient(180deg, var(--sky-top), var(--sky-mid) 50%, var(--sky-low) 88%, var(--bg));
  }

  .case-sky:has(+ .case-visual) {
    padding-bottom: clamp(7rem, 14vw, 13rem);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-sm);
    color: var(--fg-2);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--link);
    font-weight: 700;
  }

  .crumbs :global(.crumb-sep) {
    width: 1rem;
    height: 1rem;
  }

  .case-head h1 {
    margin-top: var(--s-4);
    font-size: clamp(3.25rem, 1.6rem + 7vw, 8.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .case-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    margin-top: var(--s-7);
    align-items: start;
  }

  .case-summary {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  .case-facts {
    display: grid;
    gap: var(--s-4);
  }

  .case-facts dt {
    font-size: var(--t-sm);
    color: var(--fg-3);
  }

  .case-facts dd {
    font-weight: 700;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  /* A captura sobe sobre a borda do céu: duas camadas, profundidade real. */
  .case-visual {
    position: relative;
    margin-top: calc(-1 * clamp(5rem, 11vw, 10rem));
  }

  .shot {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: var(--shadow-2);
  }

  .shot img {
    width: 100%;
  }

  .shot figcaption {
    padding: var(--s-3) var(--s-5);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
    color: var(--fg-3);
  }

  .case-body {
    display: grid;
    gap: clamp(4rem, 8vw, 7rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .block-title {
    font-size: var(--t-xl);
    margin-bottom: var(--s-5);
  }

  .problem-text {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.35;
    letter-spacing: -0.01em;
    max-width: 44ch;
  }

  .walk-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-4) clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: var(--s-6);
  }

  .walk-head .block-title {
    margin-bottom: 0;
  }

  .walk-head p {
    color: var(--fg-2);
    max-width: 50ch;
  }

  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8) clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .dots-cool li::before {
    background: var(--mercurio);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--mercurio) 18%, transparent);
  }

  .dots-warm li::before {
    background: var(--freio);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--freio) 18%, transparent);
  }

  .result {
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--r-xl);
    background: var(--bg-3);
  }

  .outcomes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--s-6) clamp(1.5rem, 3vw, 3rem);
  }

  .outcomes li {
    display: grid;
    align-content: start;
    gap: var(--s-3);
  }

  .outcomes li p {
    color: var(--fg-2);
  }

  .outcomes li.is-measured p {
    font-family: var(--font-display);
    font-size: var(--t-md);
    line-height: 1.35;
    color: var(--fg);
  }

  .outcome-kind {
    justify-self: start;
    padding: 0.2rem 0.75rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-2);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--fg-2);
  }

  .is-measured .outcome-kind {
    border-color: transparent;
    background: var(--accent);
    color: var(--accent-fg);
  }

  .case-next {
    padding-bottom: var(--section-y);
  }

  .next-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .next {
    position: relative;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-6) 5rem var(--s-6) var(--s-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-2);
    text-decoration: none;
    box-shadow: var(--shadow-1);
    transition:
      transform 500ms var(--ease-spring),
      box-shadow 400ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .next-name {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .next-summary {
    color: var(--fg-2);
    font-size: var(--t-sm);
    max-width: 44ch;
  }

  .next-go {
    position: absolute;
    right: var(--s-5);
    top: var(--s-5);
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--bg-3);
    transition:
      background-color 300ms var(--ease-out),
      color 300ms var(--ease-out),
      transform 500ms var(--ease-spring);
  }

  .next-go :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  @media (hover: hover) {
    .next:hover {
      transform: translateY(-4px);
      border-color: var(--line-2);
      box-shadow: var(--shadow-2);
    }
    .next:hover .next-go {
      background: var(--accent);
      color: var(--accent-fg);
      transform: translateX(3px);
    }
  }

  @media (max-width: 63.99rem) {
    .case-intro,
    .walk-head,
    .duo,
    .next-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .case-links .btn {
      width: 100%;
    }

    .next {
      padding: var(--s-5) 4.25rem var(--s-5) var(--s-5);
    }

    .next-go {
      right: var(--s-4);
      top: var(--s-4);
    }
  }
</style>
