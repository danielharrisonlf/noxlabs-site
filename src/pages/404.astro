---
import Icon from "../components/Icon.astro";
import Ill from "../components/Ill.astro";
import type { IllustrationName } from "../data/illustrations";
import Base from "../layouts/Base.astro";

/** O mosaico do topo com uma peça faltando: esta página. */
const tiles: ({ ill: IllustrationName; tone: string } | null)[] = [
  { ill: "clinica", tone: "lila" },
  { ill: "loja", tone: "goiaba" },
  { ill: "industria", tone: "caju" },
  { ill: "imobiliaria", tone: "goiaba" },
  null,
  { ill: "escola", tone: "lila" },
  { ill: "agro", tone: "white" },
  { ill: "distribuidora", tone: "white" },
  { ill: "escritorio", tone: "lila" },
];
---

<Base title="Página não encontrada | Noxlabs" description="Este endereço não existe no site da Noxlabs." path="/404/">
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="nf-code">Página não encontrada</p>
        <h1 id="nf-title">Esta peça não está no mosaico.</h1>
        <p>
          O link pode estar errado ou a página mudou de lugar. O que eu faço, os projetos e o contato estão na página inicial.
        </p>
        <div class="nf-actions">
          <a class="btn btn-primary" href="/">
            Ir para a página inicial
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn-secondary" href="/#na-sua-empresa">Ver como seria no seu ramo</a>
        </div>
      </div>

      <div class="nf-mosaic" aria-hidden="true">
        {
          tiles.map((t) =>
            t ? (
              <span class:list={["tile", `tile-${t.tone}`]}>
                <Ill name={t.ill} />
              </span>
            ) : (
              <span class="nf-gap" />
            ),
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: min(92svh, 50rem);
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + 2.5rem) 4rem;
  }

  .nf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--s-7) clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .nf-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .nf-code {
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: var(--goiaba-soft);
    color: var(--goiaba-ink);
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .nf h1 {
    font-size: var(--t-display);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 13ch;
  }

  .nf-copy > p:not(.nf-code) {
    font-size: var(--t-md);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .nf-mosaic {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
    max-width: 26rem;
    width: 100%;
    justify-self: center;
  }

  .nf-mosaic > * {
    aspect-ratio: 1;
    border-radius: 22px;
  }

  .nf-mosaic .tile {
    padding: 14%;
  }

  .nf-gap {
    border: 2px dashed var(--line-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nf-mosaic .tile:nth-child(4) {
      animation: nf-nudge 2.4s var(--ease-in-out) 0.6s infinite alternate;
    }
  }

  @keyframes nf-nudge {
    to {
      transform: translateX(6px);
    }
  }

  @media (max-width: 52rem) {
    .nf-grid {
      grid-template-columns: 1fr;
    }

    .nf-mosaic {
      max-width: 18rem;
      justify-self: start;
    }
  }

  @media (max-width: 39.99rem) {
    .nf-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
