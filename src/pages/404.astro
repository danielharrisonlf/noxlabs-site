---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Página não encontrada | Noxlabs" description="Este endereço não existe no site da Noxlabs." path="/404/">
  <section class="nf grain" aria-labelledby="nf-title">
    <!-- Um rastro que sai de fora da tela e se apaga no meio do caminho. -->
    <svg class="nf-trail" viewBox="0 0 1200 600" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="nf-fade" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" class="nf-stop-on"></stop>
          <stop offset="0.62" class="nf-stop-on"></stop>
          <stop offset="0.8" class="nf-stop-off"></stop>
        </linearGradient>
      </defs>
      <path class="nf-glow" d="M -60 590 C 300 590, 620 560, 860 470 S 1140 300, 1260 220"></path>
      <path class="nf-core" d="M -60 590 C 300 590, 620 560, 860 470 S 1140 300, 1260 220"></path>
    </svg>

    <div class="wrap nf-body">
      <h1 id="nf-title">Nenhuma luz neste endereço.</h1>
      <p>O link pode estar errado ou a página mudou de lugar. Os serviços, os casos e o contato estão na página inicial.</p>
      <a class="btn btn-primary" href="/">
        Ir para a página inicial
        <Icon name="arrow-right" />
      </a>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    overflow: hidden;
    min-height: min(90svh, 46rem);
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + 3rem) 5rem;
    background:
      radial-gradient(90% 70% at 0% 100%, var(--haze), transparent 60%),
      linear-gradient(180deg, var(--sky-top), var(--sky-mid) 60%, var(--sky-low));
  }

  .nf-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .nf-trail path {
    fill: none;
    stroke: url(#nf-fade);
    stroke-linecap: round;
  }

  .nf-stop-on {
    stop-color: var(--sodio);
    stop-opacity: 1;
  }

  .nf-stop-off {
    stop-color: var(--sodio);
    stop-opacity: 0;
  }

  .nf-glow {
    stroke-width: 12;
    opacity: var(--trail-glow);
  }

  .nf-core {
    stroke-width: 2;
  }

  .nf-body {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .nf h1 {
    font-size: var(--t-display);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }

  .nf p {
    font-size: var(--t-md);
    color: var(--fg-2);
    max-width: 46ch;
  }

</style>
