---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Página não encontrada | Noxlabs" description="Este endereço não existe no site da Noxlabs." path="/404/">
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap nf-grid">
      <div class="nf-copy">
        <p class="nf-code" aria-hidden="true">Página não encontrada</p>
        <h1 id="nf-title">Este documento não está na pasta.</h1>
        <p>
          O link pode estar errado ou a página mudou de lugar. As soluções, os casos e o contato estão na página inicial.
        </p>
        <div class="nf-actions">
          <a class="btn btn-primary" href="/">
            Ir para a página inicial
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn-secondary" href="/contabilidade/">Automação para contabilidade</a>
        </div>
      </div>

      <div class="nf-folder card" aria-hidden="true">
        <p class="nf-folder-title">Pasta: site da Noxlabs</p>
        <ul role="list">
          <li><span class="tag tag-done">Encontrado</span> Página inicial</li>
          <li><span class="tag tag-done">Encontrado</span> Contabilidade</li>
          <li><span class="tag tag-done">Encontrado</span> Casos</li>
          <li><span class="tag tag-late">Não encontrado</span> <span class="nf-missing">Esta página</span></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: min(92svh, 48rem);
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + 3rem) 5rem;
  }

  .nf-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--s-7) clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .nf-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .nf-code {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 700;
    padding: 0.1rem 0.6rem;
    border-radius: var(--r-xs);
    background: var(--marca);
    color: var(--marca-ink);
  }

  .nf h1 {
    font-size: var(--t-display);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    max-width: 13ch;
  }

  .nf-copy > p:not(.nf-code) {
    font-size: var(--t-md);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .nf-folder {
    padding: var(--s-6);
    border-radius: var(--r-xl);
    rotate: 1.5deg;
  }

  .nf-folder-title {
    font-weight: 700;
    margin-bottom: var(--s-3);
  }

  .nf-folder li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding-block: 0.65rem;
    border-bottom: 1px dashed var(--line);
  }

  .nf-folder li:last-child {
    border-bottom: 0;
  }

  .nf-missing {
    color: var(--ink-3);
    text-decoration: line-through;
  }

  @media (max-width: 52rem) {
    .nf-grid {
      grid-template-columns: 1fr;
    }

    .nf-folder {
      max-width: 24rem;
      rotate: none;
    }
  }

  @media (max-width: 39.99rem) {
    .nf-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
