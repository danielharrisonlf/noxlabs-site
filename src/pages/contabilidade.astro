---
import Contact from "../components/Contact.astro";
import Estimator from "../components/Estimator.astro";
import Faq from "../components/Faq.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Icon from "../components/Icon.astro";
import MarketData from "../components/MarketData.astro";
import { faq } from "../data/content";
import { accountingFaq, accountingKeeps, accountingPains, accountingScenarios } from "../data/segments";
import { site, talkMailto } from "../data/site";
import Base from "../layouts/Base.astro";

const topic = "Automação para escritório de contabilidade";
const mailto = talkMailto(topic);
const items = [...accountingFaq, ...faq.filter((f) => ["Quanto custa?", "E os dados dos meus clientes?"].includes(f.q))];
const path = "/contabilidade/";

const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Automação para escritórios de contabilidade",
  serviceType: "Automação de processos e atendimento para escritórios contábeis",
  provider: { "@id": `${site.url}/#org` },
  areaServed: { "@type": "Country", name: "Brasil" },
  audience: { "@type": "BusinessAudience", name: "Escritórios de contabilidade" },
  url: new URL(path, site.url).href,
  description:
    "Coleta de documentos dos clientes, controle de prazos e obrigações, status pelo WhatsApp, importação de notas e extratos, entrada de clientes novos e organização do fechamento.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.join(" ") },
  })),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Noxlabs", item: site.url },
    { "@type": "ListItem", position: 2, name: "Contabilidade", item: new URL(path, site.url).href },
  ],
};
---

<Base
  title="Automação para escritório de contabilidade | Noxlabs"
  description="Automação para escritórios de contabilidade: coleta de documentos, prazos e obrigações, atendimento no WhatsApp com IA, fim da digitação dupla e fechamento sem correria. Comece por uma conversa de 30 minutos."
  path={path}
  schema={[service, faqSchema, breadcrumb]}
  mailto={mailto}
>
  <section class="acc-hero" aria-labelledby="acc-title">
    <div class="wrap acc-hero-grid">
      <div class="acc-hero-copy">
        <nav class="crumbs" aria-label="Trilha">
          <a href="/">Início</a>
          <Icon name="arrow-right" />
          <span aria-current="page">Contabilidade</span>
        </nav>
        <h1 id="acc-title">Automação para escritório de contabilidade, do documento do cliente ao fechamento.</h1>
        <p class="acc-lede">
          O mês do escritório repete a mesma rotina para cada cliente: pedir documento, conferir, lançar, avisar, responder.
          A Noxlabs automatiza o que se repete e deixa para a equipe o que precisa de um contador.
        </p>
        <div class="acc-actions" data-cta-anchor>
          <a class="btn btn-primary" href={mailto}>
            Pedir uma conversa de 30 min
            <Icon name="mail" class="no-nudge" />
          </a>
          <a class="btn btn-secondary" href="#cenarios">Ver os cenários</a>
        </div>
      </div>

      <div class="pains card">
        <h2>Alguma dessas soa familiar?</h2>
        <ul role="list">
          {
            accountingPains.map((p) => (
              <li>
                <Icon name={p.icon} />
                {p.text}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <MarketData
    id="setor"
    ids={["cfc-escritorios", "cfc-profissionais", "contabil-retrabalho", "contabil-ia-semanal", "ibpt-normas", "tr-5h"]}
    title="Um setor grande, com regra que muda toda hora."
    lede="Números públicos sobre o tamanho da contabilidade no Brasil, a complexidade dos impostos e o que os próprios profissionais dizem da rotina."
  />

  <section class="section scenarios band" id="cenarios" aria-labelledby="cenarios-title">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 id="cenarios-title" class="section-title">Como funcionaria no seu escritório.</h2>
        <p class="section-lede">
          Seis rotinas, contadas como são hoje e como poderiam ficar. São ilustrações do que dá para construir; o desenho
          final sai do diagnóstico do seu escritório.
        </p>
      </header>

      <ol role="list" class="scn-list">
        {
          accountingScenarios.map((s, i) => (
            <li class="scn" id={`cenario-${s.id}`} data-reveal style={`--i:${i % 2}`}>
              <div class="scn-head">
                <span class="scn-icon">
                  <Icon name={s.icon} />
                </span>
                <h3>{s.title}</h3>
              </div>
              <div class="scn-cols">
                <div class="scn-today">
                  <p class="scn-label">Hoje</p>
                  <p>{s.today}</p>
                </div>
                <div class="scn-then">
                  <p class="scn-label">Com a automação</p>
                  <ul role="list" class="checks">
                    {s.then.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <p class="scn-gain">
                <strong>O que você ganha:</strong> {s.gain}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section keeps" aria-labelledby="keeps-title">
    <div class="wrap keeps-grid">
      <header data-reveal>
        <h2 id="keeps-title" class="section-title">O que não muda.</h2>
        <p class="section-lede">Automação ajuda o escritório; não toma o lugar do contador nem do seu jeito de atender.</p>
      </header>
      <ul role="list" class="checks keeps-list" data-reveal style="--i:1">
        {accountingKeeps.map((k) => <li>{k}</li>)}
      </ul>
    </div>
  </section>

  <HowItWorks />
  <Estimator />
  <Faq
    items={items}
    id="perguntas-contabilidade"
    title="Perguntas de quem tem escritório."
    lede="O que os sócios de escritórios contábeis costumam perguntar antes de começar."
  />
  <Contact topic={topic} title="Qual rotina do seu escritório você tiraria da mão da equipe primeiro?" />
</Base>

<style>
  .acc-hero {
    position: relative;
    padding: calc(var(--header-h) + clamp(1.5rem, 1rem + 3vw, 4rem)) 0 clamp(3rem, 2rem + 4vw, 6rem);
    isolation: isolate;
    overflow: hidden;
  }

  .acc-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.55;
    mask-image: radial-gradient(60% 70% at 80% 40%, #000 10%, transparent 75%);
  }

  .acc-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--s-7) clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .acc-hero-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--caneta);
    font-weight: 700;
  }

  .crumbs :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .acc-hero h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.25rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.022em;
    max-width: 18ch;
  }

  .acc-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .acc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .pains {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-3);
  }

  .pains h2 {
    font-size: var(--t-md);
    line-height: 1.25;
    margin-bottom: var(--s-3);
  }

  .pains li {
    display: flex;
    align-items: start;
    gap: var(--s-3);
    padding-block: 0.6rem;
    border-bottom: 1px dashed var(--line);
    color: var(--ink-2);
  }

  .pains li:last-child {
    border-bottom: 0;
  }

  .pains :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2em;
    color: var(--pine);
  }

  /* ---- Cenários ---- */
  .scn-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .scn {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--s-5);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
  }

  .scn-head {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .scn-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--r-md);
    background: rgb(255 225 90 / 0.14);
    color: var(--marca);
  }

  .scn-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .scn h3 {
    font-size: var(--t-lg);
  }

  .scn-cols {
    display: grid;
    gap: var(--s-4);
  }

  .scn-label {
    margin-bottom: var(--s-2);
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--ink-3);
  }

  .scn-today p:not(.scn-label) {
    color: var(--ink-2);
  }

  .scn-then .scn-label {
    color: var(--marca);
  }

  .scn-then li {
    color: var(--ink);
  }

  .scn-gain {
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: rgb(255 225 90 / 0.1);
    border: 1px solid rgb(255 225 90 / 0.35);
  }

  .scn-gain strong {
    color: var(--marca);
  }

  /* ---- O que não muda ---- */
  .keeps-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-6) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .keeps-grid header {
    display: grid;
    gap: var(--s-4);
  }

  .keeps-list li {
    font-size: var(--t-md);
    color: var(--ink);
  }

  .keeps-list li + li {
    margin-top: var(--s-4);
  }

  .keeps-list li::before {
    top: 0.3em;
  }

  @media (max-width: 63.99rem) {
    .acc-hero-grid,
    .keeps-grid {
      grid-template-columns: 1fr;
    }

    .scn-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .acc-actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Telas de 320 px: o botão principal continua na primeira tela. */
  @media (max-width: 24rem) {
    .acc-hero-copy {
      gap: var(--s-4);
    }

    .acc-hero h1 {
      font-size: 2rem;
    }

    .acc-lede {
      font-size: var(--t-base);
    }
  }
</style>
