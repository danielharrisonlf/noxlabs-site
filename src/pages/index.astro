---
import About from "../components/About.astro";
import AccountingBlock from "../components/AccountingBlock.astro";
import Contact from "../components/Contact.astro";
import Estimator from "../components/Estimator.astro";
import Faq from "../components/Faq.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import MarketData from "../components/MarketData.astro";
import Security from "../components/Security.astro";
import Segments from "../components/Segments.astro";
import Solutions from "../components/Solutions.astro";
import Work from "../components/Work.astro";
import { faq } from "../data/content";
import Base from "../layouts/Base.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.join(" ") },
  })),
};
---

<Base path="/" schema={[faqSchema]}>
  <Hero />
  <MarketData
    ids={["ms-sem-tempo", "mckinsey-potencial", "sebrae-whatsapp"]}
    title="Falta tempo na equipe. Sobra tarefa que dava para automatizar."
    lede="Três pesquisas sobre o tempo das equipes, o que já dá para automatizar e onde os clientes estão. São dados do mercado, não resultados da Noxlabs."
  />
  <AccountingBlock />
  <Solutions />
  <HowItWorks />
  <Segments />
  <Work />
  <Estimator />
  <About />
  <Security />
  <Faq items={faq} />
  <Contact />
</Base>
