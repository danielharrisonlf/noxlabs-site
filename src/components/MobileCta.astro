---
/**
 * Botão de polegar no celular: aparece quando os botões do topo saem da tela e
 * some quando o contato, o rodapé ou a calculadora entram. Respeita a barra
 * inferior do aparelho (safe-area). Fora do celular, o cabeçalho já carrega o CTA.
 */
import { site, whatsappHref } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  mailto?: string;
}

const { mailto = site.talkMailto } = Astro.props;
const whats = whatsappHref();
---

<div class="dock" data-dock data-visible="false" inert>
  <div class="dock-bar">
    <a class="btn btn-primary dock-cta" href={mailto}>
      <Icon name="mail" class="no-nudge" />
      Pedir uma conversa de 30 min
    </a>
    {
      whats && (
        <a class="btn btn-secondary dock-whats" href={whats} aria-label="Chamar no WhatsApp">
          <Icon name="phone" class="no-nudge" />
        </a>
      )
    }
  </div>
</div>

<script>
  const dock = document.querySelector<HTMLElement>("[data-dock]");
  const narrow = window.matchMedia("(max-width: 39.99rem)");

  if (dock && "IntersectionObserver" in window) {
    const anchors = [...document.querySelectorAll<HTMLElement>("[data-cta-anchor]")];
    // Some também sobre a calculadora e o seletor de ramos, para não cobrir campos e controles.
    const blockers = [
      document.getElementById("contato"),
      document.querySelector("footer"),
      ...document.querySelectorAll("[data-estimator], [data-scenarios]"),
    ].filter((el): el is HTMLElement => el !== null);
    const seen = new Map<Element, boolean>();

    const update = () => {
      const anchorVisible = anchors.some((el) => seen.get(el));
      const blocked = blockers.some((el) => seen.get(el));
      const show = narrow.matches && !anchorVisible && !blocked && window.scrollY > 240;
      dock.dataset.visible = String(show);
      dock.inert = !show;
    };

    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) seen.set(entry.target, entry.isIntersecting);
      update();
    });
    for (const el of [...anchors, ...blockers]) io.observe(el);
    narrow.addEventListener("change", update);
    window.addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: none;
    padding: 0 max(0.75rem, env(safe-area-inset-right)) calc(0.75rem + env(safe-area-inset-bottom))
      max(0.75rem, env(safe-area-inset-left));
    pointer-events: none;
  }

  @media (max-width: 39.99rem) {
    .dock {
      display: block;
    }
  }

  .dock-bar {
    display: flex;
    gap: var(--s-2);
    pointer-events: auto;
    transform: translateY(calc(100% + 1.5rem));
    opacity: 0;
    transition:
      transform 380ms var(--ease-out),
      opacity 280ms var(--ease-out);
  }

  .dock-cta {
    flex: 1;
    box-shadow: 0 14px 30px -10px rgb(42 20 48 / 0.6);
  }

  .dock-whats {
    flex: none;
    width: 3.375rem;
    padding: 0;
  }

  .dock[data-visible="true"] .dock-bar {
    transform: none;
    opacity: 1;
  }

  :global(html.menu-open) .dock {
    visibility: hidden;
  }
</style>
