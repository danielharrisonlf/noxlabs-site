---
/**
 * Fio condutor: um rastro de luz que desce pela margem esquerda da página e se
 * desenha com a rolagem, de seção em seção. Cada seção tem um ponto que acende
 * quando a luz chega. Só em telas com margem para ele (>= 72rem); o caminho é
 * calculado no navegador a partir das posições reais das seções.
 */
const sections = ["servicos", "kairos", "casos", "processo", "sobre", "perguntas", "contato"];
---

<svg class="thread" aria-hidden="true" focusable="false" data-thread data-sections={sections.join(",")}>
  <path class="thread-key" d=""></path>
  <path class="thread-glow" d="" pathLength="1"></path>
  <path class="thread-core" d="" pathLength="1"></path>
  <path class="thread-tip" d="" pathLength="1"></path>
  <g class="thread-nodes"></g>
</svg>

<script>
  import { reducedMotion } from "../scripts/motion";

  const svg = document.querySelector<SVGSVGElement>("[data-thread]");
  const wide = window.matchMedia("(min-width: 72rem)");
  const NS = "http://www.w3.org/2000/svg";

  if (svg) {
    const ids = (svg.dataset.sections ?? "").split(",");
    const paths = [...svg.querySelectorAll<SVGPathElement>("path")];
    const draw = paths.filter((p) => !p.classList.contains("thread-key"));
    const nodesGroup = svg.querySelector<SVGGElement>(".thread-nodes");
    const scrollTimeline = CSS.supports("animation-timeline: scroll()");
    let nodes: { el: SVGCircleElement; y: number }[] = [];
    let start = 0;
    let end = 1;
    let frame = 0;

    const layout = () => {
      if (!wide.matches) return;
      const main = svg.parentElement;
      const content = document.querySelector<HTMLElement>("#servicos .wrap");
      if (!main || !content) return;
      // O fio corre no meio da margem esquerda do conteúdo.
      const gutter = content.getBoundingClientRect().left + parseFloat(getComputedStyle(content).paddingLeft);
      const x = Math.max(gutter / 2, 14);
      const amp = Math.min(gutter * 0.28, 22);
      const tops = ids
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null)
        .map((el) => {
          // Posição de layout (offset), que ignora as entradas animadas em andamento.
          let node: HTMLElement | null = el.querySelector("h2") ?? el;
          let y = 14;
          while (node && node !== main) {
            y += node.offsetTop;
            node = node.offsetParent as HTMLElement | null;
          }
          return y;
        });
      if (tops.length < 2) return;
      const y0 = tops[0] - 220;
      let d = `M ${x} ${y0}`;
      let prev = y0;
      tops.forEach((y, i) => {
        const swing = i % 2 === 0 ? amp : -amp;
        const mid = (prev + y) / 2;
        d += ` C ${x + swing} ${mid - (y - prev) * 0.2}, ${x - swing} ${mid + (y - prev) * 0.2}, ${x} ${y}`;
        prev = y;
      });
      const height = prev + 40;
      svg.setAttribute("viewBox", `0 0 ${Math.ceil(x * 2)} ${Math.ceil(height)}`);
      svg.style.width = `${Math.ceil(x * 2)}px`;
      svg.style.height = `${Math.ceil(height)}px`;
      for (const p of paths) p.setAttribute("d", d);

      if (nodesGroup) {
        nodesGroup.replaceChildren();
        nodes = tops.map((y) => {
          const c = document.createElementNS(NS, "circle");
          c.setAttribute("cx", String(x));
          c.setAttribute("cy", String(y));
          c.setAttribute("r", "4");
          nodesGroup.append(c);
          return { el: c, y };
        });
      }

      // A ponta da luz fica a 60% da altura da janela: a rolagem que leva o
      // começo do fio até ali é o início; a que leva o fim é o término.
      const mainTop = main.offsetTop;
      start = mainTop + y0 - innerHeight * 0.6;
      end = mainTop + prev - innerHeight * 0.6;
      svg.style.setProperty("--thread-start", `${Math.max(start, 0)}px`);
      svg.style.setProperty("--thread-end", `${end}px`);
      svg.dataset.ready = "true";
      update();
    };

    // Pontos acendem quando a luz passa; sem animation-timeline, o próprio fio segue a rolagem aqui.
    const update = () => {
      frame = 0;
      const p = Math.min(Math.max((window.scrollY - start) / Math.max(end - start, 1), 0), 1);
      if (!scrollTimeline || reducedMotion()) {
        const offset = reducedMotion() ? 0 : 1 - p;
        for (const path of draw) {
          if (path.classList.contains("thread-tip")) path.style.strokeDashoffset = String(0.004 - p);
          else path.style.strokeDashoffset = String(offset);
        }
      }
      const tip = window.scrollY + innerHeight * 0.6 - (svg.parentElement?.offsetTop ?? 0);
      for (const n of nodes) n.el.classList.toggle("lit", reducedMotion() || tip >= n.y - 2);
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    if ("ResizeObserver" in window) new ResizeObserver(() => requestAnimationFrame(layout)).observe(document.body);
    document.fonts?.ready.then(layout);
    wide.addEventListener("change", layout);
    layout();
  }
</script>

<style>
  .thread {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 3;
    display: none;
    overflow: visible;
    pointer-events: none;
  }

  @media (min-width: 72rem) {
    .thread[data-ready="true"] {
      display: block;
    }
  }

  .thread path {
    fill: none;
    stroke-linecap: round;
  }

  .thread-key {
    stroke: var(--line-2);
    stroke-width: 1;
    stroke-dasharray: 2 7;
    opacity: 0.7;
  }

  .thread-glow,
  .thread-core {
    stroke: var(--sodio);
    stroke-dasharray: 1;
  }

  .thread-glow {
    stroke-width: 8;
    opacity: calc(var(--trail-glow) * 0.8);
  }

  .thread-core {
    stroke-width: 1.75;
  }

  .thread-tip {
    stroke: color-mix(in srgb, #fff calc(var(--packet-white) * 100%), var(--sodio));
    stroke-width: 6;
    stroke-dasharray: 0.004 2;
    filter: drop-shadow(0 0 6px var(--sodio));
  }

  @media (prefers-reduced-motion: reduce) {
    .thread-tip {
      display: none;
    }
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .thread-glow,
      .thread-core {
        animation: thread-draw linear both;
        animation-timeline: scroll(root);
        animation-range: var(--thread-start) var(--thread-end);
      }

      .thread-tip {
        animation: thread-tip linear both;
        animation-timeline: scroll(root);
        animation-range: var(--thread-start) var(--thread-end);
      }
    }
  }

  @keyframes thread-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes thread-tip {
    from {
      stroke-dashoffset: 0.004;
    }
    to {
      stroke-dashoffset: -0.996;
    }
  }

  .thread :global(circle) {
    fill: var(--bg);
    stroke: var(--line-2);
    stroke-width: 1.5;
    transition:
      fill 400ms var(--ease-out),
      stroke 400ms var(--ease-out),
      r 400ms var(--ease-out);
  }

  .thread :global(circle.lit) {
    fill: var(--sodio);
    stroke: var(--sodio);
    r: 5px;
  }
</style>
