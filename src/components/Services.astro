---
import { services } from "../data/services";
import { diagnosisMailto } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="section services" id="servicos" aria-labelledby="servicos-title">
  <div class="wrap">
    <header class="svc-head">
      <h2 id="servicos-title" class="section-title" data-reveal="head">Qual destes problemas é o seu?</h2>
      <p class="section-lede" data-reveal style="--i:1">
        Seis frentes de trabalho, do agente de IA à conta da nuvem. Escolha o que mais parece com o seu caso e veja o que
        eu entregaria, com uma prova que você pode abrir.
      </p>
    </header>

    <div class="svc" data-svc data-dir="next">
      <div class="svc-scroller">
        <ul class="svc-list" role="list" data-tablist aria-label="Problemas">
          {
            services.map((s, i) => (
              <li style={`--i:${i}`} data-reveal="left">
                <a class="svc-tab" href={`#svc-${s.id}`} data-tab={s.id}>
                  <span class="svc-dot" aria-hidden="true" />
                  <span class="svc-problem">{s.problem}</span>
                  <span class="svc-short">{s.short}</span>
                  <Icon name="arrow-right" class="svc-arrow" />
                </a>
              </li>
            ))
          }
          <li class="svc-ind" role="presentation" aria-hidden="true"></li>
        </ul>
      </div>

      <svg class="svc-link" aria-hidden="true" focusable="false">
        <path class="svc-link-glow" d=""></path>
        <path class="svc-link-core" d=""></path>
      </svg>

      <div class="svc-panels" data-reveal style="--i:2">
        {
          services.map((s) => (
            <article class="svc-panel" id={`svc-${s.id}`} data-panel={s.id} aria-labelledby={`svc-${s.id}-title`}>
              <h3 id={`svc-${s.id}-title`} style="--k:0">
                {s.title}
              </h3>
              <p class="svc-when" style="--k:1">
                {s.when}
              </p>
              <div class="svc-cols" style="--k:2">
                <div>
                  <h4>O que você recebe</h4>
                  <ul role="list" class="dots">
                    {s.deliver.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4>Resultado</h4>
                  <p class="svc-outcome">{s.outcome}</p>
                </div>
              </div>
              <div class="svc-foot" style="--k:3">
                <p class="svc-proof">
                  {s.proof.text}{" "}
                  <a href={s.proof.href}>
                    {s.proof.label}
                    <Icon name={s.proof.href.startsWith("http") ? "arrow-up-right" : "arrow-right"} />
                  </a>
                </p>
                <a class="btn btn-primary" href={diagnosisMailto(s.problem)}>
                  Falar sobre isso
                  <Icon name="mail" class="no-nudge" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { onSwipe, reducedMotion } from "../scripts/motion";
  import { type TabsController, enhanceTabs } from "../scripts/tabs";

  const root = document.querySelector<HTMLElement>("[data-svc]");
  if (root) {
    const list = root.querySelector<HTMLElement>(".svc-list");
    const scroller = root.querySelector<HTMLElement>(".svc-scroller");
    const ind = root.querySelector<HTMLElement>(".svc-ind");
    const svg = root.querySelector<SVGSVGElement>(".svc-link");
    const paths = svg ? [...svg.querySelectorAll<SVGPathElement>("path")] : [];
    const wide = window.matchMedia("(min-width: 64rem)");
    let last = 0;
    let tabs: TabsController | null = null;

    // Indicador que desliza até a aba escolhida: barra vertical no desktop, traço sob o chip no celular.
    const moveIndicator = () => {
      const tab = root.querySelector<HTMLElement>('[aria-selected="true"]');
      if (!tab || !ind) return;
      ind.style.setProperty("--ty", `${tab.offsetTop}px`);
      ind.style.setProperty("--th", `${tab.offsetHeight / 100}`);
      ind.style.setProperty("--tx", `${tab.offsetLeft}px`);
      ind.style.setProperty("--tw", `${tab.offsetWidth / 100}`);
      ind.dataset.on = "true";
    };

    const offsetIn = (el: HTMLElement) => {
      let x = 0;
      let y = 0;
      let node: HTMLElement | null = el;
      while (node && node !== root) {
        x += node.offsetLeft;
        y += node.offsetTop;
        node = node.offsetParent as HTMLElement | null;
      }
      return { x, y };
    };

    // Um rastro de luz liga o problema escolhido à resposta (desktop).
    const drawLink = (animate: boolean) => {
      if (!svg || !wide.matches) return;
      const tab = root.querySelector<HTMLElement>('[aria-selected="true"]');
      const panels = root.querySelector<HTMLElement>(".svc-panels");
      if (!tab || !panels) return;
      // Posições de layout (offset), que ignoram as entradas animadas em andamento.
      const t = offsetIn(tab);
      const p = offsetIn(panels);
      const x1 = t.x + tab.offsetWidth - 6;
      const y1 = t.y + tab.offsetHeight / 2;
      const x2 = p.x + 2;
      const y2 = Math.min(Math.max(y1, p.y + 48), p.y + panels.offsetHeight - 48);
      const mid = (x1 + x2) / 2;
      const d = `M ${x1} ${y1} C ${mid} ${y1}, ${mid} ${y2}, ${x2} ${y2}`;
      svg.setAttribute("viewBox", `0 0 ${root.offsetWidth} ${root.offsetHeight}`);
      for (const path of paths) {
        path.setAttribute("d", d);
        if (animate && !reducedMotion()) {
          const length = path.getTotalLength();
          path.animate(
            [
              { strokeDasharray: `${length}`, strokeDashoffset: `${length}` },
              { strokeDasharray: `${length}`, strokeDashoffset: "0" },
            ],
            { duration: 650, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
          );
        }
      }
    };

    tabs = enhanceTabs(root, {
      orientation: wide,
      onChange: (_id, index, source) => {
        root.dataset.dir = index >= last ? "next" : "prev";
        last = index;
        moveIndicator();
        requestAnimationFrame(() => drawLink(source !== "init"));
        // No celular, o chip escolhido vem para dentro da faixa rolável.
        const tab = root.querySelector<HTMLElement>('[aria-selected="true"]');
        if (source !== "init" && scroller && tab && !wide.matches) {
          const left = tab.offsetLeft - (scroller.clientWidth - tab.offsetWidth) / 2;
          scroller.scrollTo({ left, behavior: reducedMotion() ? "auto" : "smooth" });
        }
      },
    });

    const ctl = tabs;
    const panels = root.querySelector<HTMLElement>(".svc-panels");
    if (ctl && panels) {
      onSwipe(
        panels,
        () => ctl.select(Math.min(ctl.current() + 1, ctl.count - 1), "user"),
        () => ctl.select(Math.max(ctl.current() - 1, 0), "user"),
      );
    }

    if ("ResizeObserver" in window) {
      new ResizeObserver(() => {
        moveIndicator();
        drawLink(false);
      }).observe(root);
    }
    document.fonts?.ready.then(() => {
      moveIndicator();
      drawLink(false);
    });
    if (list) list.dataset.ready = "true";
  }
</script>

<style>
  .svc-head {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .svc {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .svc-scroller {
    position: relative;
  }

  .svc-list {
    position: relative;
    list-style: none;
    padding: 0 0 0 0.9rem;
    display: grid;
    gap: var(--s-2);
  }

  /* Trilho à esquerda da lista; a luz desliza até a aba escolhida. */
  .svc-list::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
  }

  .svc-ind {
    position: absolute;
    left: 0;
    top: 0;
    width: 2px;
    height: 100px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--sodio), var(--freio));
    box-shadow: 0 0 12px var(--sodio);
    transform-origin: top center;
    transform: translateY(var(--ty, 0)) scaleY(var(--th, 0));
    opacity: 0;
    transition:
      transform 560ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  .svc-ind[data-on="true"] {
    opacity: 1;
  }

  .svc-tab {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-4);
    min-height: 3.75rem;
    padding: 0.9rem 1.1rem 0.9rem 1.25rem;
    border: 1px solid transparent;
    border-radius: var(--r-md);
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--fg-2);
    text-decoration: none;
    transition:
      color 220ms var(--ease-out),
      background-color 280ms var(--ease-out),
      border-color 280ms var(--ease-out),
      box-shadow 300ms var(--ease-out),
      transform 300ms var(--ease-spring);
  }

  .svc-tab:active {
    transform: scale(0.985);
  }

  .svc-short {
    display: none;
  }

  .svc-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid var(--line-2);
    transition:
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out),
      transform 500ms var(--ease-spring);
  }

  .svc :global(.svc-arrow) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--sodio);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 220ms var(--ease-out),
      transform 400ms var(--ease-spring);
  }

  @media (hover: hover) {
    .svc-tab:hover {
      color: var(--fg);
      background: color-mix(in srgb, var(--fg) 5%, transparent);
    }
    .svc-tab:hover :global(.svc-arrow) {
      opacity: 0.6;
      transform: translateX(0);
    }
  }

  .svc-tab[aria-selected="true"] {
    color: var(--fg);
    background: var(--bg-2);
    border-color: var(--line);
    box-shadow: var(--shadow-1);
  }

  .svc-tab[aria-selected="true"] .svc-dot {
    background: var(--sodio);
    border-color: var(--sodio);
    box-shadow:
      0 0 0 5px color-mix(in srgb, var(--sodio) 20%, transparent),
      0 0 14px var(--sodio);
    transform: scale(1.15);
  }

  .svc-tab[aria-selected="true"] :global(.svc-arrow) {
    opacity: 1;
    transform: translateX(0);
  }

  .svc-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 64rem) {
    .svc[data-enhanced="true"] .svc-link {
      display: block;
    }
  }

  .svc-link path {
    fill: none;
    stroke: var(--sodio);
    stroke-linecap: round;
  }

  .svc-link-glow {
    stroke-width: 7;
    opacity: var(--trail-glow);
  }

  .svc-link-core {
    stroke-width: 1.75;
  }

  .svc-panels {
    display: grid;
    gap: var(--s-6);
  }

  /*
   * Com script, as seis respostas ocupam a mesma célula: o cartão não muda de
   * tamanho ao trocar, só o conteúdo, que entra na direção da escolha.
   */
  .svc[data-enhanced="true"] .svc-panel {
    grid-area: 1 / 1;
  }

  .svc[data-enhanced="true"] .svc-panel[hidden] {
    display: flex !important;
    visibility: hidden;
  }

  .svc-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background:
      radial-gradient(90% 60% at 100% 0%, color-mix(in srgb, var(--sodio) 9%, transparent), transparent 70%),
      var(--bg-2);
    box-shadow: var(--shadow-2);
    touch-action: pan-y;
  }

  .svc-panel:focus-visible {
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc[data-enhanced="true"] .svc-panel:not([hidden]) > * {
      animation: svc-in 520ms var(--ease-out) both;
      animation-delay: calc(var(--k, 0) * 55ms);
    }

    .svc[data-dir="prev"] .svc-panel:not([hidden]) > * {
      animation-name: svc-in-prev;
    }
  }

  @keyframes svc-in {
    from {
      opacity: 0;
      translate: var(--svc-dx, 0) var(--svc-dy, 18px);
    }
  }

  @keyframes svc-in-prev {
    from {
      opacity: 0;
      translate: calc(var(--svc-dx, 0) * -1) calc(var(--svc-dy, 18px) * -1);
    }
  }

  .svc-panel h3 {
    font-size: var(--t-xl);
    max-width: 18ch;
  }

  .svc-when {
    margin-top: var(--s-4);
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--fg-2);
    max-width: 50ch;
  }

  .svc-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-6);
    margin-top: var(--s-7);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .svc-cols h4 {
    margin-bottom: var(--s-3);
    font-family: var(--font-text);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--fg);
  }

  .svc-outcome {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .svc-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s-5);
    margin-top: auto;
    padding-top: var(--s-7);
  }

  .svc-proof {
    font-size: var(--t-sm);
    color: var(--fg-2);
    max-width: 46ch;
  }

  .svc-proof a {
    color: var(--link);
    font-weight: 700;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }

  .svc-proof a :global(svg) {
    display: inline-block;
    width: 1em;
    height: 1em;
    margin-left: 0.25em;
    vertical-align: -0.15em;
    transition: transform 300ms var(--ease-spring);
  }

  @media (hover: hover) {
    .svc-proof a:hover {
      text-decoration-color: currentColor;
    }
    .svc-proof a:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  /* ---- Abaixo de 64rem: chips roláveis com o polegar, painel abaixo ---- */
  @media (max-width: 63.99rem) {
    .svc {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      --svc-dx: 28px;
      --svc-dy: 0;
    }

    .svc-scroller {
      margin-inline: calc(-1 * var(--gutter));
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
      mask-image: linear-gradient(90deg, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
    }

    .svc-scroller::-webkit-scrollbar {
      display: none;
    }

    .svc-list {
      display: flex;
      gap: var(--s-2);
      width: max-content;
      padding: 0 var(--gutter) 0.6rem;
    }

    .svc-list::before {
      left: var(--gutter);
      right: var(--gutter);
      top: auto;
      bottom: 0;
      width: auto;
      height: 2px;
    }

    .svc-ind {
      top: auto;
      bottom: 0;
      width: 100px;
      height: 2px;
      transform-origin: left center;
      transform: translateX(var(--tx, 0)) scaleX(var(--tw, 0));
      background: linear-gradient(90deg, var(--sodio), var(--freio));
    }

    .svc-list li {
      scroll-snap-align: start;
    }

    .svc-tab {
      display: inline-flex;
      gap: var(--s-2);
      min-height: 2.875rem;
      padding: 0.55rem 1rem;
      border-color: var(--line-2);
      border-radius: var(--r-pill);
      font-family: var(--font-text);
      font-size: var(--t-sm);
      font-weight: 700;
      white-space: nowrap;
    }

    .svc-problem,
    .svc-dot,
    .svc :global(.svc-arrow) {
      display: none;
    }

    .svc-short {
      display: inline;
    }

    .svc-tab[aria-selected="true"] {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--accent-fg);
      box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--sodio) 70%, transparent);
    }

    .svc-cols,
    .svc-foot {
      grid-template-columns: 1fr;
    }

    .svc-foot .btn {
      justify-self: start;
    }
  }

  /* Sem script, os chips não existem: a lista completa aparece como índice. */
  @media (max-width: 63.99rem) {
    .svc:not([data-enhanced="true"]) .svc-scroller {
      overflow: visible;
      margin-inline: 0;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .svc:not([data-enhanced="true"]) .svc-list {
      flex-wrap: wrap;
      width: auto;
      padding-inline: 0;
    }

    .svc:not([data-enhanced="true"]) .svc-tab {
      white-space: normal;
    }
  }

  @media (max-width: 30rem) {
    .svc-foot .btn {
      width: 100%;
    }
  }
</style>
