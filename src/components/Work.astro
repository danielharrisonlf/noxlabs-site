---
/**
 * O que já construí: os dois sistemas em destaque em faixas alternadas, com o
 * recorte legível da tela real numa peça de cor ao lado do texto; os outros
 * em peças pequenas (faixa rolável com contador no celular).
 */
import { featuredCases, moreCases } from "../data/cases";
import Icon from "./Icon.astro";

const tones = ["lila", "caju", "goiaba", "lila"];
---

<section class="section work" id="casos" aria-labelledby="casos-title">
  <div class="wrap">
    <header class="section-head split" data-reveal>
      <h2 id="casos-title" class="section-title">Feito por mim, do começo ao fim</h2>
      <p class="section-lede">Sistemas que eu construí, contados pelo problema que resolvem. São produtos e projetos meus, não clientes.</p>
    </header>

    <ul role="list" class="rows">
      {
        featuredCases.map((c, i) => (
          <li class:list={["row", { flip: i % 2 === 1 }]} data-reveal>
            <div class:list={["row-visual", "tile", i % 2 ? "tile-goiaba" : "tile-lila"]}>
              {c.thumb ? (
                <img src={c.thumb.src} width={c.thumb.width} height={c.thumb.height} alt={c.thumb.alt} loading="lazy" decoding="async" />
              ) : (
                <span class="plain-icon" aria-hidden="true">
                  <Icon name={c.icon} />
                </span>
              )}
              <span class="row-tag">Tela real, dados de demonstração</span>
            </div>
            <div class="row-copy">
              <span class="case-status">{c.status}</span>
              <h3 class="case-name">{c.name}</h3>
              <p class="case-summary">{c.summary}</p>
              <p class="case-problem">
                <strong>O problema:</strong> {c.hook}
              </p>
              <a class="text-link" href={`/casos/${c.slug}/`}>
                Ver como funciona
                <span class="visually-hidden">: {c.name}</span>
                <Icon name="arrow-right" />
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="more-head" data-reveal>
      <h3 class="more-title">Também construí</h3>
      <p class="more-count" aria-hidden="true" data-more-count>1 de {moreCases.length}</p>
    </div>
    <ul role="list" class="more" data-more>
      {
        moreCases.map((c, i) => (
          <li class:list={["tile", `tile-${tones[i % tones.length]}`]} data-reveal style={`--i:${i % 4}`}>
            <span class="more-icon">
              <Icon name={c.icon} />
            </span>
            {c.href ? (
              <a class="more-name more-link" href={c.href}>
                {c.name}
                <Icon name="arrow-right" />
              </a>
            ) : (
              <span class="more-name">{c.name}</span>
            )}
            <span class="more-summary">{c.summary}</span>
            <span class="more-status">{c.status}</span>
          </li>
        ))
      }
    </ul>
    <script>
      // Contador "2 de 4" da faixa que rola de lado no celular.
      const list = document.querySelector<HTMLElement>("[data-more]");
      const count = document.querySelector<HTMLElement>("[data-more-count]");
      if (list && count) {
        const items = [...list.children] as HTMLElement[];
        const update = () => {
          const mid = list.scrollLeft + list.clientWidth / 3;
          let i = items.findIndex((el) => el.offsetLeft - list.offsetLeft + el.offsetWidth > mid);
          if (list.scrollLeft + list.clientWidth >= list.scrollWidth - 4) i = items.length - 1;
          count.textContent = `${Math.max(i, 0) + 1} de ${items.length}`;
        };
        list.addEventListener("scroll", update, { passive: true });
      }
    </script>
    <p class="work-note">
      Os ganhos descritos são o que cada sistema muda na rotina, não números medidos em empresas.
    </p>
  </div>
</section>

<style>
  .rows {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
  }

  .row.flip .row-visual {
    order: 2;
  }

  .row-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(15rem, 10rem + 10vw, 21rem);
    padding: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(1rem, 0.5rem + 2vw, 3rem);
    border-radius: var(--r-xl);
  }

  .row-visual img {
    width: 100%;
    max-width: 34rem;
    height: auto;
    border-radius: 16px;
    border: 8px solid #fff;
    background: #fff;
    box-shadow: var(--shadow-2);
  }

  .row-tag {
    position: absolute;
    left: 1rem;
    bottom: 0.85rem;
    font-size: var(--t-xs);
    font-weight: 650;
    color: var(--ink-2);
  }

  .plain-icon {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: var(--r-lg);
    background: var(--jabu);
    color: var(--caju);
  }

  .plain-icon :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .row-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-3);
  }

  .case-status {
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: var(--tint);
    color: var(--lila-ink);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .case-name {
    font-size: var(--t-xl);
    letter-spacing: -0.025em;
  }

  .case-summary {
    font-size: var(--t-md);
    font-weight: 600;
    line-height: 1.4;
  }

  .case-problem {
    color: var(--ink-2);
  }

  .case-problem strong {
    color: var(--ink);
  }

  .more-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    margin-bottom: var(--s-4);
  }

  .more-title {
    font-size: var(--t-lg);
  }

  .more-count {
    display: none;
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--ink-3);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .more li {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border-radius: var(--r-lg);
  }

  .more-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--s-2);
    border-radius: 50%;
    background: var(--surface);
    color: var(--goiaba-ink);
  }

  .more-icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .more-name {
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 700;
    line-height: 1.2;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    color: var(--goiaba-ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.25em;
  }

  .more-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .more-summary {
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .more-status {
    margin-top: auto;
    padding-top: var(--s-2);
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--jabu);
  }

  .work-note {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-3);
    max-width: 70ch;
  }

  @media (max-width: 75rem) {
    .more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .row {
      grid-template-columns: 1fr;
    }

    .row.flip .row-visual {
      order: 0;
    }
  }

  @media (max-width: 47.99rem) {
    .more-count {
      display: block;
    }

    .more {
      display: flex;
      margin-inline: calc(-1 * max(var(--gutter), env(safe-area-inset-left)));
      padding: 0.25rem max(var(--gutter), env(safe-area-inset-left)) 0.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
      scrollbar-width: none;
    }

    .more::-webkit-scrollbar {
      display: none;
    }

    .more li {
      flex: none;
      width: min(80vw, 19rem);
      scroll-snap-align: start;
    }

    .row-visual {
      min-height: 0;
      padding: 2rem 0.75rem 2.75rem;
      border-radius: var(--r-lg);
    }

    .row-visual img {
      border-width: 5px;
    }
  }
</style>
