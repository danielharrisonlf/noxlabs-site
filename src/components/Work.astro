---
/** O que já construí: histórias em linguagem de negócio, com link para a página de cada caso. */
import { featuredCases, moreCases, srcset } from "../data/cases";
import Icon from "./Icon.astro";
---

<section class="section work" id="casos" aria-labelledby="casos-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="casos-title" class="section-title">O que eu já construí</h2>
      <p class="section-lede">
        Sistemas que construí do começo ao fim, contados pelo problema que resolvem. Cada um começou por uma rotina, não por
        uma tecnologia.
      </p>
    </header>

    <ul role="list" class="cases">
      {
        featuredCases.map((c, i) => (
          <li class:list={["case", i % 2 ? "tone-goiaba" : "tone-lila"]} data-reveal style={`--i:${i % 2}`}>
            <a class="case-link" href={`/casos/${c.slug}/`} aria-label={`${c.name}: ${c.summary} Ver o caso.`}>
              {c.image ? (
                <span class="case-shot">
                  <img
                    src={c.image.src}
                    srcset={srcset(c.image.src, c.image.width)}
                    sizes="(min-width: 64rem) 36rem, 92vw"
                    width={c.image.width}
                    height={c.image.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : (
                <span class="case-shot case-shot-plain" aria-hidden="true">
                  <span class="plain-icon">
                    <Icon name={c.icon} />
                  </span>
                </span>
              )}
              <span class="case-body">
                <span class="case-status">{c.status}</span>
                <span class="case-name">{c.name}</span>
                <span class="case-summary">{c.summary}</span>
                <span class="case-problem">
                  <strong>O problema:</strong> {c.hook}
                </span>
                <span class="case-go">
                  Ver o caso
                  <Icon name="arrow-right" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="more-head" data-reveal>
      <h3 class="more-title">Também construí</h3>
      <p class="more-count" aria-hidden="true" data-more-count>1 de {moreCases.length}</p>
    </div>
    <ul role="list" class="more" data-more>
      {
        moreCases.map((c, i) => (
          <li class="tile tile-white" data-reveal style={`--i:${i % 4}`}>
            <span class="more-icon">
              <Icon name={c.icon} />
            </span>
            {c.href ? (
              <a class="more-name more-link" href={c.href}>
                {c.name}
                <Icon name="arrow-right" />
              </a>
            ) : (
              <span class="more-name">{c.name}</span>
            )}
            <span class="more-summary">{c.summary}</span>
            <span class="tag tag-neutral">{c.status}</span>
          </li>
        ))
      }
    </ul>
    <script>
      // Contador "2 de 5" da faixa que rola de lado no celular.
      const list = document.querySelector<HTMLElement>("[data-more]");
      const count = document.querySelector<HTMLElement>("[data-more-count]");
      if (list && count) {
        const items = [...list.children] as HTMLElement[];
        const update = () => {
          const mid = list.scrollLeft + list.clientWidth / 3;
          let i = items.findIndex((el) => el.offsetLeft - list.offsetLeft + el.offsetWidth > mid);
          if (list.scrollLeft + list.clientWidth >= list.scrollWidth - 4) i = items.length - 1;
          count.textContent = `${Math.max(i, 0) + 1} de ${items.length}`;
        };
        list.addEventListener("scroll", update, { passive: true });
      }
    </script>
    <p class="work-note">
      São sistemas próprios e projetos que construí, não clientes. Os ganhos descritos são o que cada sistema muda na rotina,
      não números medidos em empresas.
    </p>
  </div>
</section>

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .case-link {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    text-decoration: none;
    transition:
      transform var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out);
  }

  /* A captura assenta num azulejo de cor, como uma peça do mosaico. */
  .case-shot {
    display: block;
    padding: clamp(1rem, 0.6rem + 1.5vw, 2rem) clamp(1rem, 0.6rem + 1.5vw, 2rem) 0;
    background: var(--lila);
    overflow: hidden;
  }

  .tone-goiaba .case-shot {
    background: var(--goiaba-soft);
  }

  .case-shot img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: left top;
    border-radius: 14px 14px 0 0;
    box-shadow: var(--shadow-2);
    transition: transform var(--d-slow) var(--ease-out);
  }

  .case-shot-plain {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 0;
  }

  .plain-icon {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: var(--r-lg);
    background: var(--jabu);
    color: var(--caju);
  }

  .plain-icon :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .case-body {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .case-status {
    justify-self: start;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    background: var(--tint);
    color: var(--lila-ink);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .case-name {
    font-family: var(--font-display);
    font-size: var(--t-xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .case-summary {
    font-size: var(--t-base);
    font-weight: 600;
  }

  .case-problem {
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .case-problem strong {
    color: var(--ink);
  }

  .case-go {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    margin-top: var(--s-2);
    color: var(--goiaba-ink);
    font-weight: 700;
  }

  .case-go :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform var(--d-base) var(--ease-spring);
  }

  @media (hover: hover) {
    .case-link:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-2);
    }

    .case-link:hover img {
      transform: translateY(-4px);
    }

    .case-link:hover .case-go :global(svg) {
      transform: translateX(3px);
    }
  }

  .more-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    margin-bottom: var(--s-4);
  }

  .more-title {
    font-size: var(--t-lg);
  }

  .more-count {
    display: none;
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--ink-3);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--s-3);
  }

  .more li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-areas:
      "icon name"
      "text text"
      "tag tag";
    gap: var(--s-3);
    align-content: start;
    padding: var(--s-5);
    border-radius: var(--r-lg);
  }

  .more-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: var(--goiaba-soft);
    color: var(--goiaba-ink);
  }

  .more-icon :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .more-name {
    grid-area: name;
    align-self: center;
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 700;
    line-height: 1.2;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    color: var(--goiaba-ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.25em;
  }

  .more-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .more-summary {
    grid-area: text;
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .more .tag {
    grid-area: tag;
    justify-self: start;
  }

  .work-note {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-3);
    max-width: 70ch;
  }

  @media (max-width: 52rem) {
    .cases {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.99rem) {
    /* Faixa que rola de lado, com contador. */
    .more-count {
      display: block;
    }

    .more {
      display: flex;
      margin-inline: calc(-1 * max(var(--gutter), env(safe-area-inset-left)));
      padding: 0.25rem max(var(--gutter), env(safe-area-inset-left)) 0.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
      scrollbar-width: none;
    }

    .more::-webkit-scrollbar {
      display: none;
    }

    .more li {
      flex: none;
      width: min(80vw, 19rem);
      scroll-snap-align: start;
    }
  }
</style>
