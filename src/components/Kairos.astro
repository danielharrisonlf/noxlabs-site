---
import { kairos } from "../data/cases";
import Icon from "./Icon.astro";
import KairosFlow from "./KairosFlow.astro";

const notes = [
  {
    title: "Em produção",
    text: "Sete serviços, PostgreSQL e Redis numa única VPS com Dokploy, com cadastro aberto de empresas e convites.",
  },
  {
    title: "Limite assumido",
    text: "O bloqueio por projeto pode virar gargalo com muitas escritas simultâneas. Os limites estão escritos no caso, junto das decisões.",
  },
];
---

<section class="section kairos" id="kairos" aria-labelledby="kairos-title">
  <div class="wrap">
    <div class="k-head">
      <h2 id="kairos-title" class="section-title">Siga um pedido pelo Kairos.</h2>
      <div class="k-intro">
        <p class="k-lede">
          O Kairos é a plataforma de gestão de projetos que construí e mantenho no ar. Pessoas e agentes de IA trabalham
          nos mesmos dados, com as mesmas regras. Avance os passos e veja o caminho de um pedido feito a um agente.
        </p>
        <p class="k-status live">No ar em kairos.noxlabs.tech</p>
        <div class="k-links">
          <a class="btn btn-primary" href={kairos.links[0].href}>
            {kairos.links[0].label}
            <Icon name="arrow-up-right" />
          </a>
          <a class="btn btn-ghost" href="/casos/kairos/">
            Ler o caso completo
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>

    <KairosFlow id="kf-home" />

    <div class="k-proof">
      <div class="k-measure">
        <p class="k-kind">Medido</p>
        <p class="k-measure-text">
          Num A/B local com o mesmo código, ligar o keep-alive no gateway levou o p50 de <code>GET /projects</code> de
          <strong class="tabular">1,9 s para 27 ms</strong> e zerou os erros do teste.
        </p>
      </div>
      <dl class="k-notes">
        {
          notes.map((n) => (
            <div>
              <dt>{n.title}</dt>
              <dd>{n.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <p class="k-code">
      O código é aberto:
      <a class="text-link" href={kairos.links[1].href}>
        {kairos.links[1].label}
        <Icon name="arrow-up-right" />
      </a>
    </p>
  </div>
</section>

<style>
  .k-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .k-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--fg-2);
    max-width: 48ch;
  }

  .k-status {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .k-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .k-proof {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .k-kind {
    display: inline-flex;
    padding: 0.2rem 0.75rem;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--accent-fg);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .k-measure-text {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }

  .k-measure-text strong {
    font-weight: 600;
    color: var(--sodio);
  }

  :global(:root:not([data-theme="dark"])) .k-measure-text strong {
    color: var(--fg);
    background: linear-gradient(transparent 62%, color-mix(in srgb, var(--sodio) 28%, transparent) 62%);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .k-measure-text strong {
      color: var(--sodio);
      background: none;
    }
  }

  .k-measure-text code {
    font-size: 0.8em;
  }

  .k-notes {
    display: grid;
    gap: var(--s-5);
    padding-top: var(--s-2);
  }

  .k-notes dt {
    font-weight: 700;
  }

  .k-notes dd {
    margin-top: var(--s-1);
    color: var(--fg-2);
    max-width: 44ch;
  }

  .k-code {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    margin-top: var(--s-6);
    color: var(--fg-2);
  }

  @media (max-width: 63.99rem) {
    .k-head,
    .k-proof {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .k-links .btn {
      width: 100%;
    }
  }
</style>
