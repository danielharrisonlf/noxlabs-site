---
import { kairos } from "../data/cases";
import Icon from "./Icon.astro";
import KairosFlow from "./KairosFlow.astro";

const facts = [
  {
    title: "Medido",
    text: "Num A/B local com o mesmo código, ligar o keep-alive no gateway levou o p50 de GET /projects de 1,9 s para 27 ms e zerou os erros do teste.",
  },
  {
    title: "Em produção",
    text: "Sete serviços, PostgreSQL e Redis numa única VPS com Dokploy, com cadastro aberto de empresas e convites.",
  },
  {
    title: "Limite assumido",
    text: "O bloqueio por projeto pode virar gargalo com muitas escritas simultâneas. Os limites estão escritos no caso, junto das decisões.",
  },
];
---

<section class="section kairos" id="kairos" aria-labelledby="kairos-title">
  <div class="wrap">
    <div class="k-head">
      <h2 id="kairos-title" class="section-title">Siga um pedido pelo Kairos.</h2>
      <div class="k-intro">
        <p class="k-lede">
          O Kairos é a plataforma de gestão de projetos que construí e mantenho no ar. Pessoas e agentes de IA trabalham
          nos mesmos dados, com as mesmas regras. Avance os passos e veja o caminho de um pedido feito a um agente.
        </p>
        <p class="k-status live">No ar em kairos.noxlabs.tech</p>
        <div class="k-links">
          <a class="btn btn-primary" href={kairos.links[0].href}>
            {kairos.links[0].label}
            <Icon name="arrow-up-right" />
          </a>
          <a class="btn btn-ghost" href="/casos/kairos/">
            Ler o caso completo
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>

    <KairosFlow id="kf-home" />

    <ul class="k-facts" role="list">
      {
        facts.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="k-code">
      O código é aberto:
      <a class="text-link" href={kairos.links[1].href}>
        {kairos.links[1].label}
        <Icon name="arrow-up-right" />
      </a>
    </p>
  </div>
</section>

<style>
  .k-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-6) clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }

  .k-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--fg-2);
    max-width: 48ch;
  }

  .k-status {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .k-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .k-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) clamp(1.5rem, 3vw, 3rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .k-facts li {
    position: relative;
    padding-top: var(--s-5);
  }

  /* Cada fato abre com um rastro curto que esmaece. */
  .k-facts li::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4.5rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--sodio), transparent);
  }

  .k-facts li:nth-child(2)::before {
    background: linear-gradient(90deg, var(--mercurio), transparent);
  }

  .k-facts li:nth-child(3)::before {
    background: linear-gradient(90deg, var(--freio), transparent);
  }

  .k-facts h3 {
    font-size: var(--t-lg);
    margin-bottom: var(--s-2);
  }

  .k-facts p {
    color: var(--fg-2);
    max-width: 40ch;
  }

  .k-code {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    margin-top: var(--s-6);
    color: var(--fg-2);
  }

  @media (max-width: 63.99rem) {
    .k-head,
    .k-facts {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .k-links .btn {
      width: 100%;
    }
  }
</style>
