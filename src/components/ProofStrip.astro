---
import { site } from "../data/site";

/* Provas verificáveis, não logos: cada item aponta para algo que se pode abrir. */
const items = [
  {
    title: "Kairos no ar",
    live: true,
    text: "Produto próprio em produção, com sete serviços numa VPS.",
    link: { label: "kairos.noxlabs.tech", href: site.links.kairos },
  },
  {
    title: "Código aberto",
    text: "Repositórios públicos para você ler antes de contratar.",
    link: { label: "github.com/danielharrisonlf", href: site.links.github },
  },
  {
    title: "IA com permissão",
    text: "Agentes via MCP que entram com o login e o escopo de cada usuário.",
  },
  {
    title: "Stack",
    text: "TypeScript, NestJS, React, PostgreSQL, Redis, Docker, Rust e Kotlin.",
  },
];
---

<section class="proof seam" aria-labelledby="provas-title">
  <h2 id="provas-title" class="visually-hidden">O que você pode conferir</h2>
  <ul class="wrap proof-list" role="list">
    {
      items.map((item) => (
        <li>
          <h3 class:list={["proof-title", { live: item.live }]}>{item.title}</h3>
          <p>{item.text}</p>
          {item.link && (
            <a class="proof-link" href={item.link.href}>
              {item.link.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .proof-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .proof-list li {
    padding: var(--s-6) var(--s-5) var(--s-6) 0;
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  .proof-list li + li {
    padding-left: var(--s-5);
    border-left: 1px solid var(--rule);
  }

  .proof-title {
    font-family: var(--font-text);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
    margin-bottom: var(--s-1);
  }

  .proof-list p {
    color: var(--fg-2);
  }

  .proof-link {
    display: inline-block;
    margin-top: var(--s-2);
    padding-block: var(--s-1);
    color: var(--link);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  @media (max-width: 63.99rem) {
    .proof-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .proof-list li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .proof-list li:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  @media (max-width: 30rem) {
    .proof-list {
      grid-template-columns: 1fr;
    }
    .proof-list li,
    .proof-list li + li {
      padding: var(--s-5) 0;
      border-left: 0;
    }
    .proof-list li + li {
      border-top: 1px solid var(--rule);
    }
  }
</style>
