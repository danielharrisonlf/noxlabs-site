---
import { faq } from "../data/content";
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="section faq" id="perguntas" aria-labelledby="perguntas-title">
  <div class="wrap faq-grid">
    <header class="faq-head">
      <h2 id="perguntas-title" class="section-title">Perguntas antes de contratar.</h2>
      <p class="section-lede">As dúvidas que aparecem em quase todo diagnóstico, respondidas sem rodeio.</p>
      <p class="faq-ask">
        Ficou alguma?
        <a class="text-link" href={site.diagnosisMailto}>
          Pergunte por e-mail
          <Icon name="arrow-right" />
        </a>
      </p>
    </header>

    <div class="faq-list">
      {
        faq.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-sign" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="faq-answer">
              {item.a.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .faq-head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .faq-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    margin-top: var(--s-5);
    color: var(--fg-2);
  }

  .faq-list {
    border-top: 1px solid var(--line-2);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 4.5rem;
    padding-block: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 200ms var(--ease-out);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* Pergunta aberta ganha um ponto de luz à esquerda, como a seção atual no menu. */
  .faq-item summary > span:first-child {
    position: relative;
    padding-left: 1.25rem;
  }

  .faq-item summary > span:first-child::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sodio);
    box-shadow: 0 0 10px var(--sodio);
    opacity: 0;
    transform: scale(0.3);
    transition:
      opacity 300ms var(--ease-out),
      transform 400ms var(--ease-spring);
  }

  .faq-item[open] summary > span:first-child::before {
    opacity: 1;
    transform: scale(1);
  }

  .faq-sign {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--fg-2);
    transition:
      transform 450ms var(--ease-spring),
      color 250ms var(--ease-out);
  }

  .faq-sign :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .faq-item[open] .faq-sign {
    transform: rotate(45deg);
    color: var(--sodio);
  }

  @media (hover: hover) {
    .faq-item summary:hover {
      color: var(--link);
    }
  }

  /* Abre e fecha com altura animada onde o navegador sabe animar detalhes. */
  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 450ms var(--ease-out),
        content-visibility 450ms allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  .faq-answer {
    display: grid;
    gap: var(--s-3);
    padding: 0 clamp(0rem, 5vw, 3.5rem) var(--s-6) 1.25rem;
    max-width: 64ch;
  }

  .faq-answer p {
    color: var(--fg-2);
  }

  @media (max-width: 63.99rem) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-head {
      position: static;
    }
  }
</style>
