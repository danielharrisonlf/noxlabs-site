---
import { talkMailto } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  items: readonly { q: string; a: readonly string[] }[];
  title?: string;
  lede?: string;
  id?: string;
}

const {
  items,
  title = "Perguntas que todo dono faz antes de começar.",
  lede = "Custo, prazo, sistemas, equipe e dados: as dúvidas que aparecem em quase toda conversa, respondidas sem rodeio.",
  id = "perguntas",
} = Astro.props;
---

<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap faq-grid">
    <header class="faq-head" data-reveal>
      <h2 id={`${id}-title`} class="section-title">{title}</h2>
      <p class="section-lede">{lede}</p>
      <p class="faq-ask">
        Ficou alguma?
        <a class="text-link" href={talkMailto("Uma pergunta")}>
          Pergunte por e-mail
          <Icon name="arrow-right" />
        </a>
      </p>
    </header>

    <div class="faq-list">
      {
        items.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-sign" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="faq-answer">
              {item.a.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-7) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .faq-head {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .faq-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    color: var(--ink-2);
  }

  .faq-list {
    display: grid;
    gap: var(--s-3);
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    transition:
      border-color var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out);
  }

  .faq-item[open] {
    border-color: var(--line-2);
    box-shadow: var(--shadow-1);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 4rem;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5);
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.012em;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-sign {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--sunken);
    color: var(--pine-ink);
    transition:
      transform var(--d-base) var(--ease-spring),
      background-color var(--d-base) var(--ease-out);
  }

  .faq-sign :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .faq-item[open] .faq-sign {
    transform: rotate(45deg);
    background: var(--marca);
    color: var(--marca-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 380ms var(--ease-out),
        content-visibility 380ms allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  .faq-answer {
    display: grid;
    gap: var(--s-3);
    padding: 0 var(--s-5) var(--s-5);
    max-width: 64ch;
  }

  .faq-answer p {
    color: var(--ink-2);
  }

  @media (max-width: 63.99rem) {
    .faq-grid {
      grid-template-columns: 1fr;
    }

    .faq-head {
      position: static;
    }
  }
</style>
