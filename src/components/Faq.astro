---
import { talkMailto } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  items: readonly { q: string; a: readonly string[] }[];
  title?: string;
  lede?: string;
  id?: string;
}

const {
  items,
  title = "Antes de começar",
  lede = "Custo, prazo, sistemas, equipe, dados e o seu ramo: as dúvidas que aparecem em quase toda primeira conversa.",
  id = "perguntas",
} = Astro.props;
---

<section class="section faq" id={id} aria-labelledby={`${id}-title`}>
  <div class="wrap faq-grid">
    <header class="faq-head" data-reveal>
      <h2 id={`${id}-title`} class="section-title">{title}</h2>
      <p class="section-lede">{lede}</p>
      <p class="faq-ask">
        Ficou alguma?
        <a class="text-link" href={talkMailto("Uma pergunta")}>
          Pergunte por e-mail
          <Icon name="arrow-right" />
        </a>
      </p>
    </header>

    <div class="faq-list">
      {
        items.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <span class="faq-sign" aria-hidden="true">
                <Icon name="plus" />
              </span>
            </summary>
            <div class="faq-answer">
              {item.a.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--surface);
  }

  .faq-grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .faq-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4) var(--s-8);
    align-items: end;
  }

  .faq-head > :not(h2) {
    grid-column: 2;
  }

  .faq-head h2 {
    grid-row: span 2;
  }

  .faq-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
    color: var(--ink-2);
  }

  /* Perguntas em duas colunas de peças; cada coluna empilha as suas. */
  .faq-list {
    columns: 2;
    column-gap: var(--s-3);
  }

  .faq-item {
    break-inside: avoid;
    margin-bottom: var(--s-3);
    border-radius: var(--r-lg);
    background: var(--tint);
    transition: background-color var(--d-base) var(--ease-out);
  }

  .faq-item[open] {
    background: var(--goiaba-soft);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 4rem;
    padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5);
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.012em;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-sign {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--goiaba-ink);
    transition: transform var(--d-base) var(--ease-spring);
  }

  .faq-sign :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .faq-item[open] .faq-sign {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 380ms var(--ease-out),
        content-visibility 380ms allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  .faq-answer {
    display: grid;
    gap: var(--s-3);
    padding: 0 var(--s-5) var(--s-5);
  }

  .faq-answer p {
    color: var(--ink-2);
  }

  @media (max-width: 56rem) {
    .faq-head {
      grid-template-columns: 1fr;
    }

    .faq-head > :not(h2) {
      grid-column: auto;
    }

    .faq-list {
      columns: 1;
    }
  }
</style>
