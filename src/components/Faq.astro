---
import { faq } from "../data/content";
---

<section class="section seam" id="perguntas" aria-labelledby="perguntas-title">
  <div class="wrap grid">
    <header class="faq-head">
      <h2 id="perguntas-title">Perguntas antes de contratar.</h2>
      <p>As dúvidas que aparecem em quase todo diagnóstico, respondidas sem rodeio.</p>
    </header>

    <div class="faq-list">
      {
        faq.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-sign" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              {item.a.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-head {
    grid-column: 1 / span 4;
    align-self: start;
    position: sticky;
    top: 7rem;
  }

  .faq-head h2 {
    font-size: var(--t-2xl);
    margin-bottom: var(--s-4);
  }

  .faq-head p {
    color: var(--fg-2);
    max-width: 30ch;
  }

  .faq-list {
    grid-column: 6 / -1;
    border-top: 1px solid var(--rule-strong);
  }

  .faq-item {
    border-bottom: 1px solid var(--rule);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    min-height: 4.5rem;
    padding-block: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* Sinal de abrir/fechar: um quadrado que vira barra. */
  .faq-sign {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .faq-sign::before,
  .faq-sign::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    background: var(--fg);
    transition: transform 180ms var(--ease-out);
  }

  .faq-sign::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-sign::after {
    transform: rotate(0deg);
  }

  @media (hover: hover) {
    .faq-item summary:hover span:first-child {
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 0.2em;
    }
  }

  .faq-answer {
    display: grid;
    gap: var(--s-3);
    padding-bottom: var(--s-6);
    max-width: 62ch;
  }

  .faq-answer p {
    color: var(--fg-2);
  }

  @media (max-width: 63.99rem) {
    .faq-head,
    .faq-list {
      grid-column: 1 / -1;
    }
    .faq-head {
      position: static;
      margin-bottom: var(--s-6);
    }
  }
</style>
