---
/**
 * Topo: a promessa em uma frase, a ação principal e o mosaico. Cada azulejo
 * é um ramo diferente (nenhum é o foco) ou uma tela de exemplo do que roda
 * sozinho. Um único momento orquestrado: os azulejos se assentam, a conversa
 * recebe a resposta e o painel marca as rotinas do dia. Com movimento
 * reduzido ou sem script, tudo já nasce no estado final.
 */
import { site } from "../data/site";
import Icon from "./Icon.astro";
import Ill from "./Ill.astro";

const panel = [
  { text: "38 pedidos lançados no sistema", time: "09:12" },
  { text: "Agenda de amanhã confirmada", time: "11:40" },
  { text: "12 lembretes de pagamento enviados", time: "13:05" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">Tire o trabalho repetitivo da rotina da sua empresa.</h1>
      <p class="hero-lede">
        Automações, atendimento pelo WhatsApp com IA e sistemas sob medida para pequenas e médias empresas de qualquer ramo.
      </p>
      <div class="hero-actions" data-cta-anchor>
        <a class="btn btn-primary" href={site.talkMailto}>
          <Icon name="mail" class="no-nudge" />
          Pedir uma conversa de 30&nbsp;min
        </a>
        <a class="btn btn-secondary" href="#na-sua-empresa">
          Ver como seria no seu ramo
          <Icon name="arrow-right" />
        </a>
      </div>
      <ul role="list" class="hero-assure">
        <li><Icon name="person" class="no-nudge" />Você fala com quem constrói</li>
        <li><Icon name="link" class="no-nudge" />Começa pelo que você já usa</li>
        <li><Icon name="shield" class="no-nudge" />Pensado para a LGPD</li>
      </ul>
    </div>

    <figure class="mosaic" aria-labelledby="mosaic-cap">
      <div class="mosaic-grid">
        <div class="tile tile-lila m-ill m-a" style="--i:0"><Ill name="clinica" /></div>

        <div class="tile m-chat" style="--i:1">
          <p class="m-chat-head"><span class="m-dot"></span>Loja, 21h40</p>
          <div class="m-chat-body">
            <p class="bubble in">Tem o sofá cinza? Entregam sábado?</p>
            <p class="typing" aria-hidden="true"><i></i><i></i><i></i></p>
            <p class="bubble out m-reply">
              Tem, e entregamos sábado das 8h às 12h. Quer que eu reserve?<small>Assistente da loja</small>
            </p>
          </div>
        </div>

        <div class="tile tile-goiaba m-ill m-c" style="--i:2"><Ill name="loja" /></div>
        <div class="tile tile-caju m-ill m-d" style="--i:3"><Ill name="industria" /></div>

        <div class="tile tile-white m-panel" style="--i:4">
          <p class="m-panel-title">Hoje, enquanto a equipe atendia</p>
          <ul role="list" class="m-rows">
            {
              panel.map((row, i) => (
                <li style={`--r:${i}`}>
                  <span class="m-ok" aria-hidden="true">
                    <Icon name="check" class="no-nudge" />
                  </span>
                  <span>{row.text}</span>
                  <time class="tabular">{row.time}</time>
                </li>
              ))
            }
            <li class="m-review" style="--r:3">
              <span class="m-ok" aria-hidden="true">
                <Icon name="eye" class="no-nudge" />
              </span>
              <span>2 notas com valor diferente, separadas para você</span>
              <time class="tabular">14:58</time>
            </li>
          </ul>
          <div class="m-week">
            <p>
              <strong class="tabular">26 h</strong>
              <span>voltaram para a equipe nesta semana</span>
            </p>
            <span class="m-bars" aria-hidden="true">
              <i style="--h:38%"></i><i style="--h:52%"></i><i style="--h:46%"></i><i style="--h:68%"></i><i
                class="on"
                style="--h:92%"></i>
            </span>
          </div>
        </div>

        <div class="tile tile-goiaba m-ill m-f" style="--i:5"><Ill name="imobiliaria" /></div>
        <div class="tile tile-white m-ill m-g" style="--i:6"><Ill name="agro" /></div>
        <div class="tile tile-lila m-ill m-h" style="--i:7"><Ill name="escola" /></div>
      </div>
      <figcaption id="mosaic-cap" class="example-note">
        Ramos atendidos e telas de exemplo: conversa de uma loja e o resumo do dia de uma empresa. Não são dados de clientes.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + env(safe-area-inset-top) + clamp(1rem, 0.2rem + 3vw, 3.5rem));
    padding-bottom: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  h1 {
    font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 15ch;
  }

  .hero-lede {
    margin-top: var(--s-5);
    max-width: 34rem;
    font-size: var(--t-md);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero-assure {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .hero-assure li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-assure svg {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--goiaba-ink);
  }

  /* ---- Mosaico ---- */
  .mosaic {
    display: grid;
    gap: var(--s-3);
  }

  .mosaic-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(3, clamp(9.5rem, 2rem + 10.5vw, 12.75rem));
    gap: clamp(0.5rem, 0.3rem + 0.6vw, 0.85rem);
  }

  .mosaic-grid > .tile {
    border-radius: clamp(18px, 1rem + 0.6vw, 28px);
  }

  .m-ill {
    display: grid;
    place-items: center;
    padding: 14%;
  }

  .m-chat {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.8rem;
    background: var(--tint);
    border: 1px solid var(--line);
  }

  .m-chat-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--t-xs);
    font-weight: 650;
    color: var(--ink-3);
  }

  .m-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--goiaba);
  }

  .m-chat-body {
    position: relative;
    display: grid;
    gap: 0.35rem;
    align-content: end;
    flex: 1;
  }

  .m-chat .bubble {
    font-size: 0.8125rem;
    padding: 0.45rem 0.65rem;
  }

  .typing {
    position: absolute;
    right: 0;
    bottom: 0;
    display: none;
    gap: 3px;
    padding: 0.55rem 0.7rem;
    border-radius: 14px 14px 5px 14px;
    background: var(--goiaba-soft);
  }

  .typing i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--goiaba-ink);
    opacity: 0.5;
  }

  .m-panel {
    grid-column: 2 / span 2;
    grid-row: 2 / span 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(0.85rem, 0.6rem + 0.6vw, 1.25rem);
    box-shadow: var(--shadow-2);
  }

  .m-panel-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .m-rows {
    display: grid;
  }

  .m-rows li {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr) auto;
    gap: 0.55rem;
    align-items: center;
    padding: 0.32rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.8125rem;
    line-height: 1.3;
  }

  .m-rows time {
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .m-ok {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--goiaba-soft);
    color: var(--goiaba-ink);
  }

  .m-ok svg {
    width: 0.8rem;
    height: 0.8rem;
    stroke-width: 3;
  }

  .m-review .m-ok {
    background: var(--caju-soft);
    color: var(--caju-ink);
  }

  .m-week {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-3);
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .m-week p {
    display: grid;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink-3);
  }

  .m-week strong {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1vw, 2.2rem);
    line-height: 1.05;
    color: var(--ink);
  }

  .m-bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 2.6rem;
    flex: none;
    width: 5.5rem;
  }

  .m-bars i {
    flex: 1;
    height: var(--h);
    border-radius: 4px 4px 2px 2px;
    background: var(--lila);
  }

  .m-bars i.on {
    background: var(--goiaba);
  }

  /* ---- O momento orquestrado ---- */
  @media (prefers-reduced-motion: no-preference) {
    .mosaic-grid > .tile {
      animation: tile-in 700ms var(--ease-out) both;
      animation-delay: calc(120ms + var(--i) * 70ms);
    }

    .typing {
      display: inline-flex;
      animation: typing-out 0s linear 2.1s both;
    }

    .typing i {
      animation: typing-dot 900ms ease-in-out infinite;
    }

    .typing i:nth-child(2) {
      animation-delay: 150ms;
    }

    .typing i:nth-child(3) {
      animation-delay: 300ms;
    }

    .m-reply {
      animation: bubble-in 420ms var(--ease-out) 2.1s both;
    }

    .m-rows li {
      animation: row-in 460ms var(--ease-out) both;
      animation-delay: calc(1.1s + var(--r) * 260ms);
    }

    .m-bars i {
      transform-origin: bottom;
      animation: bar-in 700ms var(--ease-out) 1.6s both;
    }
  }

  @keyframes tile-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.94);
    }
  }

  @keyframes typing-out {
    to {
      visibility: hidden;
    }
  }

  @keyframes typing-dot {
    50% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  @keyframes bar-in {
    from {
      transform: scaleY(0.1);
    }
  }

  /* ---- Tablet e celular ---- */
  @media (max-width: 63.99rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 16ch;
    }
  }

  @media (max-width: 47.99rem) {
    /* O mosaico vira uma faixa que rola de lado, com o próximo azulejo aparecendo na borda. */
    /* Duas linhas de azulejos que rolam juntas: o painel e a conversa ocupam
       duas colunas por duas linhas; os ramos ficam em quadrados empilhados. */
    .mosaic-grid {
      grid-template-columns: none;
      grid-template-rows: repeat(2, 9.5rem);
      grid-auto-flow: column dense;
      grid-auto-columns: 9.5rem;
      gap: 0.6rem;
      margin-inline: calc(-1 * max(var(--gutter), env(safe-area-inset-left)));
      padding: 0.25rem max(var(--gutter), env(safe-area-inset-left)) 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
      scrollbar-width: none;
    }

    .mosaic-grid::-webkit-scrollbar {
      display: none;
    }

    .mosaic-grid > .tile {
      scroll-snap-align: start;
    }

    .m-panel {
      order: 0;
      grid-row: 1 / span 2;
      grid-column: span 2;
    }

    .m-chat {
      order: 1;
      grid-row: 1 / span 2;
      grid-column: span 2;
    }

    .m-chat-body {
      align-content: start;
      padding-top: 0.25rem;
    }

    .m-ill {
      order: 2;
    }

    .m-chat .bubble,
    .m-rows li {
      font-size: 0.875rem;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }

    .hero-assure {
      gap: var(--s-2) var(--s-4);
      font-size: var(--t-xs);
    }
  }
</style>
