---
import { site } from "../data/site";
import Icon from "./Icon.astro";

/* A rotina do exemplo: cada item se marca como feito, em sequência, uma vez. */
const routine = [
  { time: "08:00", text: "Lembrete de vencimento enviado aos clientes do mês" },
  { time: "08:04", text: "Extratos do banco importados e conferidos" },
  { time: "08:10", text: "Notas fiscais salvas na pasta de cada cliente" },
  { time: "08:15", text: "Documentos que faltam pedidos pelo WhatsApp" },
  { time: "08:16", text: "Dois lançamentos que não bateram, separados para conferência", review: true },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="kicker hero-kicker">
        <Icon name="building" />
        Para contabilidade e pequenas e médias empresas
      </p>
      <h1 id="hero-title">Sua equipe não foi contratada para copiar e colar.</h1>
      <p class="hero-lede">
        A Noxlabs cria automações, assistentes de WhatsApp com IA e sistemas sob medida que tiram da rotina o trabalho
        repetitivo: cobrar documento, digitar de novo, responder a mesma pergunta, vigiar prazo.
      </p>
      <div class="hero-actions" data-cta-anchor>
        <a class="btn btn-primary" href={site.talkMailto}>
          Marcar conversa de 30 min
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn-secondary" href="#estimativa">
          <Icon name="calculator" class="no-nudge" />
          Estimar horas liberadas
        </a>
      </div>
      <ul class="hero-assure" role="list">
        <li><Icon name="check" />Você fala com quem constrói</li>
        <li><Icon name="check" />Começa pelos sistemas que você já usa</li>
        <li><Icon name="check" />Dados de clientes tratados conforme a LGPD</li>
      </ul>
    </div>

    <figure class="routine" aria-labelledby="routine-cap">
      <div class="routine-card">
        <div class="routine-head">
          <div>
            <p class="routine-title">Rotina de segunda-feira</p>
            <p class="routine-sub">Escritório contábil de exemplo</p>
          </div>
          <span class="tag tag-neutral">Exemplo</span>
        </div>
        <div class="routine-progress" aria-hidden="true">
          <span class="routine-bar"></span>
        </div>
        <ol role="list" class="routine-list">
          {
            routine.map((item, i) => (
              <li class:list={["routine-item", { "is-review": item.review }]} style={`--i:${i}`}>
                <span class="routine-time tabular">{item.time}</span>
                <span class="routine-status" aria-hidden="true">
                  <span class="st-pending" />
                  <span class="st-done">
                    {item.review ? <Icon name="eye" /> : <Icon name="check" />}
                  </span>
                </span>
                <span class="routine-text">{item.text}</span>
                <span class="routine-tag">
                  <span class="tag tag-neutral tag-wait" aria-hidden="true">
                    Na fila
                  </span>
                  {item.review ? (
                    <span class="tag tag-review tag-final">Para você revisar</span>
                  ) : (
                    <span class="tag tag-done tag-final">Feito</span>
                  )}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <figcaption id="routine-cap">
        Ilustração de uma rotina automatizada: o sistema faz o repetitivo e separa para a equipe só o que precisa de olho
        humano. Não é dado de cliente.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 5rem)) 0 clamp(3.5rem, 2rem + 5vw, 7rem);
    isolation: isolate;
  }

  /* Papel quadriculado que some nas bordas: a planilha ao fundo, sem pesar. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: center top;
    opacity: 0.55;
    mask-image: radial-gradient(70% 70% at 75% 45%, #000 10%, transparent 75%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: var(--s-5);
  }

  .hero-kicker {
    align-items: start;
  }

  .hero-kicker :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15em;
  }

  .hero h1 {
    font-size: var(--t-display);
    font-weight: 650;
    line-height: 1.03;
    letter-spacing: -0.025em;
    max-width: 15ch;
  }

  .hero-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .hero-assure {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .hero-assure li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-assure :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--pine);
    stroke-width: 2.4;
  }

  /* ---- Rotina de exemplo ---- */
  .routine {
    display: grid;
    gap: var(--s-3);
  }

  .routine-card {
    padding: clamp(1.1rem, 0.8rem + 1.2vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow-3);
  }

  .routine-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--s-3);
  }

  .routine-title {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .routine-sub {
    font-size: var(--t-sm);
    color: var(--ink-3);
  }

  .routine-progress {
    height: 6px;
    margin-block: var(--s-4) var(--s-2);
    border-radius: 6px;
    background: var(--sunken);
    overflow: hidden;
  }

  .routine-bar {
    display: block;
    height: 100%;
    width: 80%;
    border-radius: inherit;
    background: var(--pine);
    transform-origin: left center;
    animation: bar-fill 2.4s var(--ease-in-out) 0.5s both;
  }

  .routine-item {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-3);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .routine-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .routine-time {
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--ink-3);
  }

  .routine-status {
    position: relative;
    display: grid;
    width: 1.6rem;
    height: 1.6rem;
  }

  .st-pending,
  .st-done {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }

  .st-pending {
    border: 2px dashed var(--line-2);
  }

  .st-done {
    background: var(--pine);
    color: #ffffff;
  }

  .is-review .st-done {
    background: var(--marca);
    color: var(--marca-ink);
  }

  .st-done :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    stroke-width: 2.6;
  }

  .routine-text {
    font-size: var(--t-sm);
    line-height: 1.4;
  }

  .routine-tag {
    display: grid;
    justify-items: end;
  }

  .routine-tag .tag {
    grid-area: 1 / 1;
  }

  /* Coreografia única da página: cada item vira "feito" em sequência. */
  .st-pending,
  .tag-wait {
    animation: st-out 240ms var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 420ms);
  }

  .st-done,
  .tag-final {
    animation: st-in 420ms var(--ease-spring) both;
    animation-delay: calc(700ms + var(--i) * 420ms);
  }

  @keyframes st-out {
    to {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @keyframes st-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes bar-fill {
    from {
      transform: scaleX(0);
    }
  }

  .routine figcaption {
    font-size: var(--t-xs);
    color: var(--ink-3);
    max-width: 52ch;
    padding-inline: var(--s-2);
  }

  @media (max-width: 63.99rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .routine {
      max-width: 36rem;
    }
  }

  @media (max-width: 39.99rem) {
    .hero {
      padding-top: calc(var(--header-h) + 1.25rem);
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }

    .routine-item {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .routine-time {
      display: none;
    }
  }

  @media (max-width: 23rem) {
    .routine-item {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .routine-tag {
      grid-column: 2;
      justify-items: start;
    }
  }
</style>
