---
/**
 * Topo: a mensagem é uma peça no meio do mosaico de ramos. Em volta, nove
 * ramos diferentes com o mesmo tamanho e uma peça vazia, "o seu ramo", que
 * leva aos exemplos. No celular, quatro ramos vêm antes do título (a
 * abrangência aparece na primeira tela) e os outros seis logo depois da ação.
 * Um único momento orquestrado: as peças se assentam em volta da mensagem.
 */
import type { IllustrationName } from "../data/illustrations";
import { site } from "../data/site";
import Icon from "./Icon.astro";
import Ill from "./Ill.astro";

type Piece = { name: string; ill: IllustrationName; tone: "lila" | "goiaba" | "caju" | "white" };

/** Os quatro primeiros abrem o topo no celular; a ordem não privilegia nenhum ramo de escritório. */
const pieces: Piece[] = [
  { name: "Loja", ill: "loja", tone: "goiaba" },
  { name: "Indústria", ill: "industria", tone: "caju" },
  { name: "Clínica", ill: "clinica", tone: "lila" },
  { name: "Agro", ill: "agro", tone: "white" },
  { name: "Escola", ill: "escola", tone: "lila" },
  { name: "Transportadora", ill: "transportadora", tone: "white" },
  { name: "Imobiliária", ill: "imobiliaria", tone: "goiaba" },
  { name: "Distribuidora", ill: "distribuidora", tone: "white" },
  { name: "E-commerce", ill: "ecommerce", tone: "caju" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="board">
      {
        pieces.map((p, i) => (
          <div class:list={["piece", `p${i + 1}`]} style={`--i:${i}`} aria-hidden="true">
            <span class:list={["tile", `tile-${p.tone}`, "piece-tile"]}>
              <Ill name={p.ill} />
            </span>
            <span class="piece-name">{p.name}</span>
          </div>
        ))
      }

      <a class="piece p10 piece-open" href="#na-sua-empresa" style="--i:9">
        <span class="piece-tile open-tile">
          <span class="open-plus" aria-hidden="true"><Icon name="plus" class="no-nudge" /></span>
          <span class="open-text">E o seu ramo?</span>
        </span>
        <span class="piece-name">Ver exemplos</span>
      </a>

      <div class="message">
        <h1 id="hero-title"><span>Cada negócio é de um jeito.</span> <span>O trabalho repetitivo é igual em todos.</span></h1>
        <p class="lede">
          É esse trabalho que eu tiro da rotina da sua empresa, com automações, atendimento pelo WhatsApp com IA e sistemas
          feitos do jeito que vocês trabalham.
        </p>
        <div class="actions" data-cta-anchor>
          <a class="btn btn-primary" href={site.talkMailto}>
            <Icon name="mail" class="no-nudge" />
            Contar como é a minha rotina
          </a>
          <a class="text-link" href="#na-sua-empresa">
            Ver exemplos no meu ramo
            <Icon name="arrow-right" />
          </a>
        </div>
        <p class="note">Abre um e-mail com um roteiro curto. Quem responde é o Daniel, que também constrói.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + env(safe-area-inset-top) + clamp(0.75rem, 0.2rem + 1.5vw, 1.75rem));
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }

  /* ---- Mosaico: 6 colunas; a mensagem ocupa o miolo ---- */
  .board {
    --gap: clamp(0.5rem, 0.3rem + 0.5vw, 0.8rem);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: auto auto auto;
    gap: var(--gap);
  }

  .piece {
    position: relative;
    display: grid;
    text-decoration: none;
    color: var(--ink);
  }

  .piece-tile {
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: 18% 18% 26%;
    border-radius: var(--r-lg);
  }

  .piece-tile :global(.ill) {
    max-width: 6.5rem;
  }

  .piece-name {
    position: absolute;
    left: 1rem;
    bottom: 0.8rem;
    font-size: var(--t-sm);
    font-weight: 650;
    line-height: 1.2;
  }

  /* Primeira linha: seis peças quadradas. */
  .p1,
  .p2,
  .p3,
  .p4,
  .p5,
  .p6 {
    grid-row: 1;
    aspect-ratio: 1;
  }

  .p7 {
    grid-area: 2 / 1;
  }

  .p8 {
    grid-area: 3 / 1;
  }

  .p9 {
    grid-area: 2 / 6;
  }

  .p10 {
    grid-area: 3 / 6;
  }

  /* A peça vazia: o lugar do ramo de quem está lendo. */
  .open-tile {
    align-content: center;
    gap: 0.6rem;
    border: 2px dashed var(--line-2);
    background: transparent;
    transition:
      border-color var(--d-base) var(--ease-out),
      background-color var(--d-base) var(--ease-out);
  }

  .open-plus {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--goiaba-ink);
    color: #fff;
  }

  .open-plus svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  .open-text {
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 700;
    text-align: center;
    line-height: 1.15;
  }

  .piece-open .piece-name {
    color: var(--goiaba-ink);
  }

  @media (hover: hover) {
    .piece-open:hover .open-tile {
      border-color: var(--goiaba-ink);
      background: var(--goiaba-soft);
    }
  }

  .message {
    grid-column: 2 / span 4;
    grid-row: 2 / span 2;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s-5);
    padding: clamp(1.5rem, 0.8rem + 2.4vw, 3.25rem);
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-2);
  }

  h1 {
    font-size: clamp(2.25rem, 1.5rem + 2.3vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  /* Uma frase por bloco: nada de "O" sozinho no fim da linha. */
  h1 span {
    display: block;
  }

  .lede {
    max-width: 42rem;
    font-size: var(--t-md);
    line-height: 1.55;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
  }

  .note {
    font-size: var(--t-sm);
    color: var(--ink-3);
  }

  /* ---- As peças se assentam uma vez ---- */
  @media (prefers-reduced-motion: no-preference) {
    .piece {
      animation: piece-in 640ms var(--ease-out) both;
      animation-delay: calc(80ms + var(--i) * 55ms);
    }

    .message {
      animation: message-in 700ms var(--ease-out) 40ms both;
    }
  }

  @keyframes piece-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.92);
    }
  }

  @keyframes message-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
  }

  /* ---- Até 64rem: quatro peças, a mensagem, e as outras seis em três colunas ---- */
  @media (max-width: 63.99rem) {
    .board {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: none;
    }

    .p1,
    .p2,
    .p3,
    .p4 {
      grid-row: 1;
      grid-column: span 3;
    }

    .message {
      grid-row: 2;
      grid-column: 1 / -1;
      margin-block: var(--s-2);
    }

    .p5,
    .p6,
    .p7,
    .p8,
    .p9,
    .p10 {
      grid-area: auto;
      grid-column: span 4;
      aspect-ratio: auto;
    }

    .p5,
    .p6,
    .p7 {
      grid-row: 3;
    }

    .p8,
    .p9,
    .p10 {
      grid-row: 4;
    }

    .p5 .piece-tile,
    .p6 .piece-tile,
    .p7 .piece-tile,
    .p8 .piece-tile,
    .p9 .piece-tile,
    .p10 .piece-tile {
      min-height: 8.5rem;
    }
  }

  @media (max-width: 47.99rem) {
    .board {
      --gap: 0.6rem;
    }

    /* Nome embaixo da peça: dentro dela ficaria miúdo. */
    .piece {
      gap: 0.35rem;
    }

    .piece-name {
      position: static;
      font-size: var(--t-xs);
      text-align: center;
    }

    .piece-tile {
      padding: 16%;
      border-radius: 18px;
      aspect-ratio: 1;
      min-height: 0;
    }

    .p1,
    .p2,
    .p3,
    .p4 {
      aspect-ratio: auto;
    }

    .p5 .piece-tile,
    .p6 .piece-tile,
    .p7 .piece-tile,
    .p8 .piece-tile,
    .p9 .piece-tile,
    .p10 .piece-tile {
      min-height: 0;
    }

    .open-tile {
      gap: 0.3rem;
      padding: 0.5rem;
    }

    .open-plus {
      width: 2rem;
      height: 2rem;
    }

    .open-text {
      font-size: var(--t-sm);
    }

    .message {
      padding: 0;
      border: 0;
      background: none;
      box-shadow: none;
      border-radius: 0;
      gap: var(--s-4);
      margin-block: var(--s-4) var(--s-3);
    }

    h1 {
      font-size: clamp(2.05rem, 1.2rem + 4.2vw, 2.6rem);
    }

    .actions {
      width: 100%;
      gap: var(--s-2) var(--s-4);
    }

    .actions .btn {
      width: 100%;
    }

    .actions .text-link {
      min-height: 3rem;
    }
  }
</style>
