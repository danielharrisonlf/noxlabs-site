---
import { site } from "../data/site";
import Icon from "./Icon.astro";

/*
 * O processo como poema concreto: a repetição de "entrega" é o argumento.
 * Cada entrega ganha uma barra maior; a operação é o único ponto vermelho.
 */
const poem = [
  { word: "diagnóstico", shape: "ring" },
  { word: "proposta", shape: "square" },
  { word: "entrega", shape: "bar", step: 1 },
  { word: "entrega", shape: "bar", step: 2 },
  { word: "entrega", shape: "bar", step: 3 },
  { word: "operação", shape: "live" },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <h1 id="hero-title">Software e IA que entram em produção.</h1>
    <p class="hero-lede">
      A Noxlabs é a consultoria de Daniel Harrison. Desenho, construo e coloco no ar produtos, integrações e agentes de IA
      para empresas que precisam de sistema funcionando, não de apresentação.
    </p>
    <p class="hero-own">Você fala direto com quem escreve o código. E o código é seu.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={site.diagnosisMailto}>
        Pedir diagnóstico de 30 min
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn-ghost" href="#kairos">Ver o Kairos, no ar</a>
    </div>
    <p class="hero-note">
      Gratuito, por vídeo. Você sai com um próximo passo, mesmo que a gente não trabalhe junto.
    </p>
  </div>

  <div class="hero-field on-anil">
    <ol class="poem" role="list" aria-label="Como um projeto anda">
      {
        poem.map((line, i) => (
          <li class={`poem-line is-${line.shape}`} style={`--i:${i}`}>
            <span class="poem-shape" aria-hidden="true" />
            <span class="poem-word">
              {line.word}
              {"step" in line && <span class="visually-hidden"> {line.step} de 3</span>}
            </span>
            {"step" in line && <span class="poem-bar" aria-hidden="true" style={`--w:${line.step / 3}`} />}
          </li>
        ))
      }
    </ol>
    <p class="poem-caption">
      Um diagnóstico, uma proposta, entregas a cada ciclo e o sistema no ar. Você usa o software antes do fim do projeto.
    </p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] repeat(12, minmax(0, calc((var(--max) - 11 * var(--col-gap)) / 12)))
      [content-end] minmax(var(--gutter), 1fr) [full-end];
    column-gap: var(--col-gap);
    min-height: min(calc(100svh - 4.5rem - 6.5rem), 52rem);
  }

  .hero-copy {
    grid-column: content-start / span 7;
    align-self: center;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem);
  }

  .hero h1 {
    font-size: var(--t-display);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 500;
    max-width: 11ch;
  }

  .hero-lede {
    margin-top: var(--s-6);
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--fg-2);
    max-width: 34ch;
  }

  .hero-own {
    margin-top: var(--s-4);
    font-size: var(--t-md);
    line-height: 1.5;
    font-weight: 600;
    max-width: 34ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-7);
  }

  .hero-note {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    color: var(--fg-2);
    max-width: 44ch;
  }

  /* O campo anil sangra até a borda direita da janela. */
  .hero-field {
    grid-column: 10 / full-end;
    background: var(--anil);
    color: var(--anil-sobre);
    display: grid;
    align-content: center;
    gap: var(--s-6);
    padding: clamp(2.5rem, 2rem + 3vw, 5rem) var(--gutter) clamp(2.5rem, 2rem + 3vw, 5rem) clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
  }

  .poem {
    display: grid;
    gap: clamp(0.35rem, 0.2rem + 0.4vw, 0.6rem);
  }

  .poem-line {
    display: grid;
    grid-template-columns: 1.5rem auto 1fr;
    align-items: center;
    column-gap: var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 1.1rem + 1.7vw, 2.75rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .poem-shape {
    width: 1.1rem;
    height: 1.1rem;
    justify-self: center;
  }

  .is-ring .poem-shape {
    border: 2px solid currentColor;
    border-radius: 50%;
  }

  .is-square .poem-shape {
    background: currentColor;
  }

  .is-bar .poem-shape {
    width: 0.55rem;
    height: 0.55rem;
    background: currentColor;
  }

  .is-live .poem-shape {
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--vermelhao) 0 34%, var(--anil-sobre) 36%);
  }

  .poem-bar {
    height: 0.32em;
    background: currentColor;
    transform-origin: left center;
    width: calc(var(--w) * 100%);
    min-width: 0.5em;
  }

  .poem-caption {
    max-width: 30ch;
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--anil-sobre-2);
  }

  /* O único momento orquestrado do site: o poema se monta uma vez. */
  @media (prefers-reduced-motion: no-preference) {
    .poem-line {
      animation: poem-in 700ms var(--ease-out) both;
      animation-delay: calc(120ms + var(--i) * 110ms);
    }

    .poem-bar {
      animation: bar-grow 900ms var(--ease-out) both;
      animation-delay: calc(260ms + var(--i) * 110ms);
    }
  }

  @keyframes poem-in {
    from {
      opacity: 0;
      transform: translateX(-0.4em);
    }
  }

  @keyframes bar-grow {
    from {
      transform: scaleX(0);
    }
  }

  @media (max-width: 63.99rem) {
    .hero {
      min-height: 0;
    }

    .hero-copy {
      grid-column: content-start / content-end;
      padding-bottom: var(--s-7);
    }

    .hero-field {
      grid-column: full-start / full-end;
      padding-inline: var(--gutter);
    }

    .poem {
      max-width: 32rem;
    }
  }

  @media (max-width: 30rem) {
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
