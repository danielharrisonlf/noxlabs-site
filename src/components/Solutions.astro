---
/**
 * O que a Noxlabs faz: seis ofertas contadas pela rotina que mudam. Duas
 * colunas no desktop, uma no celular, cada oferta com uma peça de cor e
 * exemplos em texto corrido (nada de telas miúdas).
 */
import { site, talkMailto } from "../data/site";
import { solutions } from "../data/solutions";
import Icon from "./Icon.astro";

const order = ["atendimento", "rotinas", "sistemas", "integracoes", "paineis", "diagnostico"];
const items = order.map((id) => solutions.find((s) => s.id === id)).filter((s) => s !== undefined);
const tones = ["goiaba", "caju", "lila", "goiaba", "caju", "lila"];

/** "a, b e c" em português. */
const list = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(", ")} e ${xs[xs.length - 1]}` : xs[0]);
---

<section class="section solutions" id="solucoes" aria-labelledby="solucoes-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="solucoes-title" class="section-title">O que eu faço</h2>
      <p class="section-lede">
        Cada trabalho começa por uma rotina que já existe na sua empresa e termina com ela dando menos trabalho, menos espera
        e menos erro.
      </p>
    </header>

    <ul role="list" class="offers">
      {
        items.map((s, i) => (
          <li class="offer" data-reveal style={`--i:${i % 2}`}>
            <span class:list={["tile", `tile-${tones[i]}`, "offer-ico"]}>
              <Icon name={s.icon} class="no-nudge" />
            </span>
            <div class="offer-body">
              <h3>{s.title}</h3>
              <p>{s.promise}</p>
              <p class="offer-ex">
                <span>Por exemplo:</span> {list(s.examples.map((e, j) => (j === 0 ? e : e.charAt(0).toLowerCase() + e.slice(1))))}.
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="sol-foot" data-reveal>
      Não achou a sua rotina aqui?
      <a class="text-link" href={talkMailto("Uma rotina que não está no site")}>
        Conte qual é por e-mail
        <Icon name="arrow-right" />
      </a>
      <span class="visually-hidden">({site.email})</span>
    </p>
  </div>
</section>

<style>
  .offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 5rem);
    border-top: 1px solid var(--line-2);
  }

  .offer {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-bottom: 1px solid var(--line);
  }

  .offer-ico {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 16px;
    color: var(--jabu);
  }

  .offer-ico :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .offer-body {
    display: grid;
    gap: var(--s-2);
  }

  .offer h3 {
    font-size: var(--t-lg);
  }

  .offer p {
    color: var(--ink-2);
  }

  .offer-ex {
    font-size: var(--t-sm);
  }

  .offer-ex span {
    font-weight: 700;
    color: var(--ink);
  }

  .sol-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    margin-top: var(--s-6);
    color: var(--ink-2);
  }

  @media (max-width: 52rem) {
    .offers {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .offer {
      gap: var(--s-4);
    }

    .offer-ico {
      width: 3rem;
      height: 3rem;
    }
  }
</style>
