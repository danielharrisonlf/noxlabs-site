---
import { site, talkMailto } from "../data/site";
import { solutions } from "../data/solutions";
import Icon from "./Icon.astro";
---

<section class="section solutions" id="solucoes" aria-labelledby="solucoes-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="solucoes-title" class="section-title">Menos tarefa manual. Mais tempo para o que dá resultado.</h2>
      <p class="section-lede">
        Cada solução começa por uma rotina que já existe na sua empresa e termina com ela acontecendo com menos esforço,
        menos espera e menos erro.
      </p>
    </header>

    <ul role="list" class="sol-grid">
      {
        solutions.map((s, i) => (
          <li class="sol" data-reveal style={`--i:${i % 2}`}>
            <span class="sol-icon">
              <Icon name={s.icon} />
            </span>
            <div class="sol-body">
              <h3>{s.title}</h3>
              <p>{s.promise}</p>
              <ul role="list" class="chips" aria-label={`Exemplos de ${s.title.toLowerCase()}`}>
                {s.examples.map((e) => (
                  <li>{e}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="sol-foot" data-reveal>
      Não achou a sua rotina aqui?
      <a class="text-link" href={talkMailto("Uma rotina da minha empresa")}>
        Conte qual é por e-mail
        <Icon name="arrow-right" />
      </a>
      <span class="visually-hidden">({site.email})</span>
    </p>
  </div>
</section>

<style>
  .sol-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 4vw, 4rem);
    border-top: 1px solid var(--line-2);
  }

  .sol {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    border-bottom: 1px solid var(--line);
  }

  .sol-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--pine-soft);
    color: var(--pine-ink);
  }

  .sol-icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .sol-body {
    display: grid;
    gap: var(--s-3);
  }

  .sol h3 {
    font-size: var(--t-lg);
  }

  .sol p {
    color: var(--ink-2);
    max-width: 46ch;
  }

  .sol .chips {
    margin-top: var(--s-1);
  }

  .sol-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    margin-top: var(--s-6);
    color: var(--ink-2);
  }

  @media (max-width: 52rem) {
    .sol-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .sol {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>
