---
/**
 * O que a Noxlabs faz: seis ofertas como peças de um mosaico de cor, em
 * xadrez de goiaba, caju e lilás. Cada peça diz a rotina que muda e três
 * exemplos curtos; nada de telas miúdas.
 */
import { site, talkMailto } from "../data/site";
import { solutions } from "../data/solutions";
import Icon from "./Icon.astro";

const order = ["atendimento", "rotinas", "sistemas", "paineis", "integracoes", "diagnostico"];
const items = order.map((id) => solutions.find((s) => s.id === id)).filter((s) => s !== undefined);
const tones = ["goiaba", "caju", "lila", "lila", "goiaba", "caju"];

/** "e-mail" protegido contra quebra no hífen. */
const keep = (text: string) => text.split(/(e-mail)/);
---

<section class="section solutions" id="solucoes" aria-labelledby="solucoes-title">
  <div class="wrap">
    <header class="section-head split" data-reveal>
      <h2 id="solucoes-title" class="section-title">O que eu faço</h2>
      <p class="section-lede">
        Seis jeitos de tirar trabalho da equipe. Cada um começa por uma rotina que já existe na sua empresa.
      </p>
    </header>

    <ul role="list" class="pieces">
      {
        items.map((s, i) => (
          <li class:list={["tile", `tile-${tones[i]}`, "offer"]} data-reveal style={`--i:${i % 3}`}>
            <span class="offer-ico">
              <Icon name={s.icon} class="no-nudge" />
            </span>
            <h3>{s.title}</h3>
            <p class="offer-promise">{s.promise}</p>
            <ul role="list" class="offer-ex" aria-label="Exemplos">
              {s.examples.slice(0, 3).map((e) => (
                <li>{keep(e).map((part) => (part === "e-mail" ? <span class="nowrap">e-mail</span> : part))}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="sol-foot" data-reveal>
      Não achou a sua rotina aqui?
      <a class="text-link" href={talkMailto("Uma rotina que não está no site")}>
        Conte qual é por e-mail
        <Icon name="arrow-right" />
      </a>
      <span class="visually-hidden">({site.email})</span>
    </p>
  </div>
</section>

<style>
  .pieces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.6rem, 0.4rem + 0.6vw, 1rem);
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    color: var(--jabu);
  }

  .offer-ico {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: var(--s-3);
    border-radius: 50%;
    background: var(--surface);
    color: var(--goiaba-ink);
    box-shadow: var(--shadow-1);
  }

  .offer-ico :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .offer h3 {
    font-size: var(--t-lg);
  }

  .offer-promise {
    color: var(--ink-2);
  }

  .offer-ex {
    display: grid;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px solid rgb(42 20 48 / 0.14);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--jabu);
  }

  .offer-ex li {
    position: relative;
    padding-left: 1rem;
  }

  .offer-ex li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--goiaba-ink);
  }

  .sol-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
    margin-top: var(--s-6);
    color: var(--ink-2);
  }

  @media (max-width: 63.99rem) {
    .pieces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .pieces {
      grid-template-columns: 1fr;
    }

    .offer-ico {
      width: 3rem;
      height: 3rem;
      margin-bottom: var(--s-1);
    }
  }
</style>
