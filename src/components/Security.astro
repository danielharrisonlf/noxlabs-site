---
/** Segurança e LGPD em português simples: cinco pontos curtos numa grade. */
import { security } from "../data/content";
import Icon from "./Icon.astro";
---

<section class="section sec" id="seguranca" aria-labelledby="seg-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="seg-title" class="section-title">Seus dados e os dos seus clientes</h2>
      <p class="section-lede">
        Automação e IA mexem com informação sensível. A LGPD entra no desenho desde a primeira conversa; a responsabilidade
        legal continua sendo da sua empresa, com o seu jurídico.
      </p>
    </header>

    <ul role="list" class="sec-list">
      {
        security.map((item, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <span class="sec-icon">
              <Icon name={item.icon} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sec {
    background: var(--tint);
  }

  .sec-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--s-6) var(--s-5);
  }

  .sec-list li {
    display: grid;
    align-content: start;
    gap: var(--s-2);
  }

  .sec-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--s-2);
    border-radius: 14px;
    background: var(--surface);
    color: var(--goiaba-ink);
  }

  .sec-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .sec-list h3 {
    font-size: var(--t-md);
    line-height: 1.25;
  }

  .sec-list p {
    color: var(--ink-2);
    font-size: var(--t-sm);
  }
</style>
