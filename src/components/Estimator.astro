---
/**
 * Estimativa ilustrativa de horas liberadas. Sem JS, mostra a conta com os
 * valores iniciais; com JS, recalcula a cada ajuste e monta o e-mail com os
 * números. Nada é enviado a lugar nenhum: a conta roda no navegador.
 */
import {
  brl,
  estimate,
  estimateMail,
  estimatorDefaults as d,
  estimatorLimits as lim,
  FULL_TIME_HOURS,
  fteText,
  HOURS_PER_MONTH,
  moneyInput,
  num,
  WEEKS_PER_MONTH,
} from "../data/estimator";
import { talkMailto } from "../data/site";
import Icon from "./Icon.astro";

const r = estimate(d);
/** Quanto do trilho fica preenchido, em %. */
const fill = (v: number, l: { min: number; max: number }) => Math.round(((v - l.min) / (l.max - l.min)) * 100);
const freedPct = Math.round((r.freed / r.repetitive) * 100);
const initialMail = talkMailto("Estimativa de horas liberadas", estimateMail(d));
---

<section class="section est" id="estimativa" aria-labelledby="est-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="est-title" class="section-title">Quanto tempo a sua equipe pode recuperar?</h2>
      <p class="section-lede">
        Ajuste os números para a sua empresa. A conta é simples, as premissas estão logo abaixo e o cálculo é feito aqui na página: nada é enviado.
      </p>
    </header>

    <div class="est-grid" data-estimator>
      <form class="est-form" aria-labelledby="est-title" data-est-form>
        <div class="field">
          <label for="est-people">Pessoas que fazem tarefas repetitivas</label>
          <div class="range-row">
            <input
              id="est-people"
              name="people"
              type="range"
              min={lim.people.min}
              max={lim.people.max}
              step={lim.people.step}
              value={d.people}
              style={`--fill:${fill(d.people, lim.people)}%`}
              aria-describedby="est-people-hint"
            />
            <output for="est-people" class="range-val tabular" data-out="people">{d.people}</output>
          </div>
          <p class="hint" id="est-people-hint">Quem digita, confere, cobra, responde ou organiza a mesma coisa toda semana.</p>
        </div>

        <div class="field">
          <label for="est-hours">Horas por semana, por pessoa, nessas tarefas</label>
          <div class="range-row">
            <input
              id="est-hours"
              name="hours"
              type="range"
              min={lim.hours.min}
              max={lim.hours.max}
              step={lim.hours.step}
              value={d.hours}
              style={`--fill:${fill(d.hours, lim.hours)}%`}
              aria-describedby="est-hours-hint"
            />
            <output for="est-hours" class="range-val tabular" data-out="hours">{d.hours} h</output>
          </div>
          <p class="hint" id="est-hours-hint">Se não souber, pergunte à equipe quanto tempo vai em cópia, cobrança e conferência.</p>
        </div>

        <div class="field">
          <label for="est-cost">Custo mensal de cada pessoa, com encargos</label>
          <div class="money">
            <span aria-hidden="true">R$</span>
            <input
              id="est-cost"
              name="cost"
              type="text"
              inputmode="decimal"
              autocomplete="off"
              value={moneyInput(d.cost)}
              data-min={lim.cost.min}
              data-max={lim.cost.max}
              aria-describedby="est-cost-hint est-cost-error"
            />
          </div>
          <p class="hint" id="est-cost-hint">Salário mais encargos e benefícios. Uma média serve, por exemplo 4.000.</p>
          <p class="field-error" id="est-cost-error" data-cost-error hidden></p>
        </div>

        <div class="field">
          <label for="est-share">Parte dessas tarefas que dá para automatizar</label>
          <div class="range-row">
            <input
              id="est-share"
              name="share"
              type="range"
              min={lim.share.min}
              max={lim.share.max}
              step={lim.share.step}
              value={d.share}
              style={`--fill:${fill(d.share, lim.share)}%`}
              aria-describedby="est-share-hint"
            />
            <output for="est-share" class="range-val tabular" data-out="share">{d.share}%</output>
          </div>
          <p class="hint" id="est-share-hint">Uma hipótese sua. Começamos em 30% para não exagerar.</p>
        </div>

        <!-- Celular: o resultado fica longe dos campos, então um resumo acompanha a rolagem. -->
        <p class="est-mini tabular" aria-hidden="true">
          <span><strong data-mini="freed">{num(r.freed)}</strong> h por mês</span>
          <span><strong data-mini="month">{brl(r.month)}</strong> por mês</span>
        </p>
      </form>

      <div class="est-result" data-est-result>
        <p class="res-tag">Estimativa ilustrativa</p>
        <p class="res-label">Horas que podem voltar para a equipe</p>
        <p class="res-big tabular"><span data-res="freed">{num(r.freed)}</span> <span class="res-unit">horas por mês</span></p>

        <div class="res-bar" aria-hidden="true">
          <span class="res-bar-fill" data-res-bar style={`--p:${freedPct}%`}></span>
        </div>
        <p class="res-bar-legend">
          de <strong class="tabular" data-res="repetitive">{num(r.repetitive)}</strong> horas por mês hoje em tarefas repetitivas
        </p>

        <dl class="res-list">
          <div>
            <dt>Equivale a</dt>
            <dd class="tabular" data-res-fte>{fteText(r.fte)}</dd>
          </div>
          <div>
            <dt>Em horas de trabalho</dt>
            <dd class="tabular"><span data-res="month">{brl(r.month)}</span> por mês</dd>
          </div>
          <div>
            <dt>Em um ano</dt>
            <dd class="tabular"><span data-res="year">{brl(r.year)}</span></dd>
          </div>
        </dl>

        <a class="btn btn-primary btn-block" href={initialMail} data-est-mail>
          <Icon name="mail" class="no-nudge" />
          Enviar esta estimativa por e-mail
        </a>
        <p class="res-disclaimer">
          Não é promessa de resultado. Horas liberadas viram capacidade para atender mais clientes ou fazer trabalho de mais
          valor; não são economia automática de salário.
        </p>
        <p class="visually-hidden" aria-live="polite" data-est-live></p>
      </div>
    </div>

    <div class="assumptions">
      <h3>Como a conta é feita</h3>
      <ul role="list" class="checks">
        <li>
          Horas repetitivas por mês = pessoas × horas por semana × {WEEKS_PER_MONTH} semanas. O mês tem cerca de 4,3 semanas;
          usamos {WEEKS_PER_MONTH} para não inflar.
        </li>
        <li>Horas liberadas = horas repetitivas × a parte que você indicou como automatizável.</li>
        <li>
          Custo da hora = custo mensal ÷ {HOURS_PER_MONTH} horas, o divisor usado na CLT para a jornada de 44 horas semanais.
          Um divisor maior deixa a hora mais barata e o resultado mais baixo.
        </li>
        <li>
          Tempo integral = horas liberadas ÷ {FULL_TIME_HOURS} horas (44 horas por semana nas mesmas {WEEKS_PER_MONTH}
          semanas).
        </li>
        <li>Não entram na conta: erros evitados, multas por atraso, clientes a mais atendidos nem o custo da automação.</li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { brl, estimate, estimateMail, estimateSummary, fteText, num, parseMoney } from "../data/estimator";
  import { talkMailto } from "../data/site";

  const form = document.querySelector<HTMLFormElement>("[data-est-form]");
  const result = document.querySelector<HTMLElement>("[data-est-result]");
  const mail = document.querySelector<HTMLAnchorElement>("[data-est-mail]");
  const bar = document.querySelector<HTMLElement>("[data-res-bar]");
  const live = document.querySelector<HTMLElement>("[data-est-live]");
  const costError = document.querySelector<HTMLElement>("[data-cost-error]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (form && result) {
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const out = (name: string) => form.querySelector<HTMLOutputElement>(`[data-out="${name}"]`);
    const res = (name: string) => result.querySelector<HTMLElement>(`[data-res="${name}"]`);
    const mini = (name: string) => form.querySelector<HTMLElement>(`[data-mini="${name}"]`);
    const shown = new Map<string, number>();
    const frames = new Map<string, number>();
    const cost = field("cost");
    const costMin = Number(cost.dataset.min);
    const costMax = Number(cost.dataset.max);
    let lastCost = parseMoney(cost.value) ?? costMin;
    let liveTimer: number | undefined;

    const range = (input: HTMLInputElement) => Math.min(Math.max(Number(input.value), Number(input.min)), Number(input.max));

    // Custo digitado: aceita "4000", "4.000" e "4.000,50"; fora do formato ou do intervalo, avisa e mantém o último válido.
    const readCost = () => {
      const value = parseMoney(cost.value);
      let message = "";
      if (value === null) message = "Digite só números, por exemplo 4.000 ou 4.000,50.";
      else if (value < costMin || value > costMax) message = `Use um valor entre ${brl(costMin)} e ${brl(costMax)}.`;
      if (costError) {
        costError.textContent = message;
        costError.hidden = message === "";
      }
      cost.setAttribute("aria-invalid", String(message !== ""));
      if (!message && value !== null) lastCost = value;
      return lastCost;
    };

    // O número desliza até o novo valor; com movimento reduzido, troca direto.
    const tween = (el: HTMLElement | null, key: string, to: number, fmt: (n: number) => string) => {
      if (!el) return;
      const from = shown.get(key) ?? to;
      shown.set(key, to);
      cancelAnimationFrame(frames.get(key) ?? 0);
      if (reduce.matches || from === to) {
        el.textContent = fmt(to);
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 320, 1);
        const e = 1 - (1 - t) ** 3;
        el.textContent = fmt(from + (to - from) * e);
        if (t < 1) frames.set(key, requestAnimationFrame(step));
      };
      frames.set(key, requestAnimationFrame(step));
    };

    const update = (announce = true) => {
      const x = { people: range(field("people")), hours: range(field("hours")), cost: readCost(), share: range(field("share")) };
      const r = estimate(x);
      for (const name of ["people", "hours", "share"]) {
        const input = field(name);
        const pct = ((Number(input.value) - Number(input.min)) / (Number(input.max) - Number(input.min))) * 100;
        input.style.setProperty("--fill", `${pct}%`);
      }
      const p = out("people");
      const h = out("hours");
      const s = out("share");
      if (p) p.textContent = String(x.people);
      if (h) h.textContent = `${x.hours} h`;
      if (s) s.textContent = `${x.share}%`;
      field("people").setAttribute("aria-valuetext", `${x.people} pessoas`);
      field("hours").setAttribute("aria-valuetext", `${x.hours} horas por semana`);
      field("share").setAttribute("aria-valuetext", `${x.share} por cento`);

      tween(res("freed"), "freed", r.freed, (n) => num(n));
      tween(res("repetitive"), "repetitive", r.repetitive, (n) => num(n));
      tween(res("month"), "month", r.month, brl);
      tween(res("year"), "year", r.year, brl);
      tween(mini("freed"), "mini-freed", r.freed, (n) => num(n));
      tween(mini("month"), "mini-month", r.month, brl);
      const fte = result.querySelector<HTMLElement>("[data-res-fte]");
      if (fte) fte.textContent = fteText(r.fte);
      bar?.style.setProperty("--p", `${Math.round((r.freed / r.repetitive) * 100)}%`);
      if (mail) mail.href = talkMailto("Estimativa de horas liberadas", estimateMail(x));

      // O leitor de tela ouve só o resultado final, quando a pessoa para de ajustar.
      window.clearTimeout(liveTimer);
      if (announce && live) liveTimer = window.setTimeout(() => (live.textContent = estimateSummary(x)), 700);
    };

    form.addEventListener("input", () => update());
    form.addEventListener("submit", (event) => event.preventDefault());
    // Ao sair do campo de custo, o valor válido volta formatado ("4000" vira "4.000").
    cost.addEventListener("change", () => {
      if (cost.getAttribute("aria-invalid") !== "true") cost.value = num(lastCost, Number.isInteger(lastCost) ? 0 : 2);
    });
    update(false);
  }
</script>

<style>
  .est {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .est-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-5);
    align-items: stretch;
  }

  .est-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    background-blend-mode: normal;
  }

  .field {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .field label {
    font-weight: 700;
    line-height: 1.3;
  }

  .hint {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  .range-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    gap: var(--s-4);
    align-items: center;
  }

  .range-val {
    justify-self: end;
    min-width: 4.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--r-sm);
    background: var(--marca-soft);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--t-md);
    font-weight: 700;
    text-align: center;
  }

  /* Controle deslizante: trilho fino, alça grande o bastante para o polegar. */
  input[type="range"] {
    --track: var(--line);
    width: 100%;
    height: 2.75rem;
    margin: 0;
    background: transparent;
    appearance: none;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--pine) var(--fill, 0%), var(--track) var(--fill, 0%));
  }

  input[type="range"]::-moz-range-track {
    height: 6px;
    border-radius: 6px;
    background: var(--track);
  }

  input[type="range"]::-moz-range-progress {
    height: 6px;
    border-radius: 6px;
    background: var(--pine);
  }

  input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: calc(3px - 0.875rem);
    border: 3px solid #ffffff;
    border-radius: 50%;
    background: var(--pine);
    box-shadow: 0 2px 8px rgb(15 42 34 / 0.35);
    transition: transform var(--d-fast) var(--ease-out);
  }

  input[type="range"]::-moz-range-thumb {
    width: 1.75rem;
    height: 1.75rem;
    border: 3px solid #ffffff;
    border-radius: 50%;
    background: var(--pine);
    box-shadow: 0 2px 8px rgb(15 42 34 / 0.35);
  }

  input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.12);
  }

  input[type="range"]:focus-visible {
    outline-offset: 2px;
    border-radius: var(--r-sm);
  }

  .money {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 3rem;
    padding-inline: var(--s-4);
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-sm);
    background: var(--surface);
    font-weight: 700;
    color: var(--ink-2);
  }

  .money:focus-within {
    border-color: var(--pine);
    box-shadow: 0 0 0 3px var(--pine-soft);
  }

  .money input {
    flex: 1;
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .money input:focus-visible {
    outline: none;
  }

  .money:has(input[aria-invalid="true"]) {
    border-color: var(--prazo);
  }

  .field-error {
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--prazo);
  }

  /* Resumo que acompanha os campos no celular. */
  .est-mini {
    display: none;
  }

  @media (max-width: 56rem) {
    .est-mini {
      position: sticky;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--s-1) var(--s-4);
      padding: var(--s-3) var(--s-4);
      border-radius: var(--r-md);
      background: var(--pine-deep);
      color: #f2f7f3;
      font-size: var(--t-sm);
      box-shadow: 0 12px 28px -12px rgb(11 58 47 / 0.6);
    }

    .est-mini strong {
      color: var(--marca);
      font-family: var(--font-display);
      font-size: var(--t-md);
    }
  }

  /* ---- Resultado ---- */
  .est-result {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border-radius: var(--r-xl);
    background: var(--pine-deep);
    color: #f2f7f3;
    box-shadow: var(--shadow-2);
  }

  .res-tag {
    justify-self: start;
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-xs);
    background: var(--marca);
    color: #1d2a12;
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .res-label {
    font-weight: 650;
    color: #c3d8cd;
  }

  .res-big {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 2.2rem + 4vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--marca);
  }

  .res-unit {
    display: inline-block;
    font-size: 0.32em;
    letter-spacing: -0.01em;
    color: #f2f7f3;
  }

  .res-bar {
    height: 12px;
    margin-top: var(--s-2);
    border-radius: 12px;
    background: rgb(255 255 255 / 0.14);
    overflow: hidden;
  }

  .res-bar-fill {
    display: block;
    height: 100%;
    width: var(--p);
    border-radius: inherit;
    background: var(--marca);
    transition: width var(--d-slow) var(--ease-out);
  }

  .res-bar-legend {
    font-size: var(--t-sm);
    color: #c3d8cd;
  }

  .res-bar-legend strong {
    color: #f2f7f3;
  }

  .res-list {
    display: grid;
    gap: 0;
    margin-block: var(--s-3);
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .res-list div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }

  .res-list dt {
    color: #c3d8cd;
  }

  .res-list dd {
    font-weight: 700;
  }

  .est-result .btn-primary {
    background: var(--marca);
    color: #1d2a12;
  }

  @media (hover: hover) {
    .est-result .btn-primary:hover {
      background: #ffeb8a;
    }
  }

  .est-result :focus-visible {
    outline-color: var(--marca);
  }

  .res-disclaimer {
    font-size: var(--t-xs);
    color: #c3d8cd;
  }

  .assumptions {
    margin-top: var(--s-5);
    padding: var(--s-5) clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
  }

  .assumptions h3 {
    margin-bottom: var(--s-4);
    font-size: var(--t-md);
  }

  .assumptions ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3) var(--s-6);
    font-size: var(--t-sm);
  }

  .assumptions li + li {
    margin-top: 0;
  }

  @media (max-width: 48rem) {
    .assumptions ul {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 56rem) {
    .est-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 26rem) {
    .range-row {
      grid-template-columns: minmax(0, 1fr) 3.75rem;
      gap: var(--s-2);
    }

    .range-val {
      min-width: 3.75rem;
    }

    .field {
      padding: var(--s-3);
    }
  }
</style>
