---
/**
 * "Faça a conta": a estimativa é uma frase que a pessoa completa, com botões
 * de menos e mais em cada número, e a resposta ao lado. Sem JS, mostra a conta
 * com os valores iniciais; com JS, recalcula a cada ajuste e monta o e-mail
 * com os números. Nada é enviado: a conta roda no navegador.
 */
import {
  brl,
  estimate,
  estimateMail,
  estimatorDefaults as d,
  estimatorLimits as lim,
  FULL_TIME_HOURS,
  fteText,
  HOURS_PER_MONTH,
  moneyInput,
  num,
  WEEKS_PER_MONTH,
} from "../data/estimator";
import { talkMailto } from "../data/site";
import Icon from "./Icon.astro";

const r = estimate(d);
const freedPct = Math.round((r.freed / r.repetitive) * 100);
const initialMail = talkMailto("Estimativa de horas liberadas", estimateMail(d));

const stepper = (name: "people" | "hours" | "share", label: string) => ({ name, label, ...lim[name], value: d[name] });
const people = stepper("people", "pessoas");
const hours = stepper("hours", "horas por semana");
const share = stepper("share", "por cento");
---

<section class="section est" id="estimativa" aria-labelledby="est-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="est-title" class="section-title">Faça a conta da sua equipe</h2>
      <p class="section-lede">Complete a frase com os números da sua empresa. A conta é feita aqui na página; nada é enviado.</p>
    </header>

    <div class="est-grid" data-estimator>
      <form class="sentence" aria-labelledby="est-title" data-est-form>
        <p>
          Na minha empresa,
          <span class="num" role="group" aria-labelledby="lbl-people">
            <button type="button" class="step" data-step="people" data-dir="-1" aria-label="Menos uma pessoa">−</button>
            <input id="est-people" name="people" type="number" inputmode="numeric" min={people.min} max={people.max} step={people.step} value={people.value} aria-describedby="hint-people" />
            <button type="button" class="step" data-step="people" data-dir="1" aria-label="Mais uma pessoa">+</button>
          </span>
          <label for="est-people" id="lbl-people">pessoas</label> passam
          <span class="num" role="group" aria-labelledby="lbl-hours">
            <button type="button" class="step" data-step="hours" data-dir="-1" aria-label="Menos uma hora">−</button>
            <input id="est-hours" name="hours" type="number" inputmode="numeric" min={hours.min} max={hours.max} step={hours.step} value={hours.value} aria-describedby="hint-hours" />
            <button type="button" class="step" data-step="hours" data-dir="1" aria-label="Mais uma hora">+</button>
          </span>
          <label for="est-hours" id="lbl-hours">horas por semana</label>, cada uma, em tarefas repetitivas.
        </p>
        <p>
          <label for="est-cost">Cada pessoa custa</label>
          <span class="money">
            <span aria-hidden="true">R$</span>
            <input id="est-cost" name="cost" type="text" inputmode="decimal" autocomplete="off" value={moneyInput(d.cost)} data-min={lim.cost.min} data-max={lim.cost.max} aria-describedby="est-cost-error hint-cost" />
          </span>
          por mês, com encargos.
        </p>
        <p>
          Se
          <span class="num" role="group" aria-labelledby="lbl-share">
            <button type="button" class="step" data-step="share" data-dir="-1" aria-label="Menos 5 por cento">−</button>
            <input id="est-share" name="share" type="number" inputmode="numeric" min={share.min} max={share.max} step={share.step} value={share.value} aria-describedby="hint-share" />
            <button type="button" class="step" data-step="share" data-dir="1" aria-label="Mais 5 por cento">+</button>
          </span>
          <label for="est-share" id="lbl-share">% desse trabalho</label> fosse automático…
        </p>
        <p class="field-error" id="est-cost-error" data-cost-error hidden></p>
        <ul role="list" class="hints">
          <li id="hint-people">Pessoas: quem digita, confere, cobra, responde ou organiza a mesma coisa toda semana.</li>
          <li id="hint-hours">Horas: se não souber, pergunte à equipe quanto tempo vai em cópia, cobrança e conferência.</li>
          <li id="hint-cost">Custo: salário mais encargos e benefícios; uma média serve.</li>
          <li id="hint-share">Parte automática: uma hipótese sua, de 10% a 60%. Começamos em 30% para não exagerar.</li>
        </ul>

        <!-- Celular: o resultado fica longe dos campos, então um resumo acompanha a rolagem. -->
        <p class="est-mini tabular" aria-hidden="true">
          <span><strong data-mini="freed">{num(r.freed)}</strong> h por mês</span>
          <span><strong data-mini="month">{brl(r.month)}</strong> por mês</span>
        </p>
      </form>

      <div class="answer" data-est-result>
        <p class="answer-tag">Estimativa ilustrativa</p>
        <p class="answer-lead">…a equipe ganharia cerca de</p>
        <p class="answer-big tabular"><span data-res="freed">{num(r.freed)}</span> <span class="answer-unit">horas por mês</span></p>
        <div class="bar" aria-hidden="true"><span data-res-bar style={`--p:${freedPct}%`}></span></div>
        <p class="answer-of">
          de <strong class="tabular" data-res="repetitive">{num(r.repetitive)}</strong> horas por mês que hoje vão em tarefas repetitivas.
        </p>
        <dl class="answer-list">
          <div>
            <dt>Equivale a</dt>
            <dd class="tabular" data-res-fte>{fteText(r.fte)}</dd>
          </div>
          <div>
            <dt>Em horas de trabalho</dt>
            <dd class="tabular"><span data-res="month">{brl(r.month)}</span> por mês</dd>
          </div>
          <div>
            <dt>Em um ano</dt>
            <dd class="tabular"><span data-res="year">{brl(r.year)}</span></dd>
          </div>
        </dl>
        <a class="btn btn-primary btn-block" href={initialMail} data-est-mail>
          <Icon name="mail" class="no-nudge" />
          <span>Mandar esta conta por <span class="nowrap">e-mail</span></span>
        </a>
        <p class="answer-note">
          Não é promessa de resultado. Horas liberadas viram capacidade para atender mais ou fazer trabalho de mais valor; não
          são economia automática de salário.
        </p>
        <p class="visually-hidden" aria-live="polite" data-est-live></p>
      </div>
    </div>

    <details class="how">
      <summary>
        <span>Como a conta é feita</span>
        <Icon name="plus" class="no-nudge" />
      </summary>
      <ul role="list" class="checks">
        <li>Horas repetitivas por mês = pessoas × horas por semana × {WEEKS_PER_MONTH} semanas (o mês tem cerca de 4,3; usamos {WEEKS_PER_MONTH} para não inflar).</li>
        <li>Horas liberadas = horas repetitivas × a parte que você indicou como automática.</li>
        <li>Custo da hora = custo mensal ÷ {HOURS_PER_MONTH} horas, o divisor usado na CLT para 44 horas semanais. Um divisor maior deixa a hora mais barata e o resultado mais baixo.</li>
        <li>Tempo integral = horas liberadas ÷ {FULL_TIME_HOURS} horas (44 horas por semana nas mesmas {WEEKS_PER_MONTH} semanas).</li>
        <li>Fora da conta: erros evitados, multas por atraso, clientes a mais atendidos e o custo da automação.</li>
      </ul>
    </details>
  </div>
</section>

<script>
  import { brl, estimate, estimateMail, estimateSummary, fteText, num, parseMoney } from "../data/estimator";
  import { talkMailto } from "../data/site";

  const form = document.querySelector<HTMLFormElement>("[data-est-form]");
  const result = document.querySelector<HTMLElement>("[data-est-result]");
  const mail = document.querySelector<HTMLAnchorElement>("[data-est-mail]");
  const bar = document.querySelector<HTMLElement>("[data-res-bar]");
  const live = document.querySelector<HTMLElement>("[data-est-live]");
  const costError = document.querySelector<HTMLElement>("[data-cost-error]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (form && result) {
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    const res = (name: string) => result.querySelector<HTMLElement>(`[data-res="${name}"]`);
    const mini = (name: string) => form.querySelector<HTMLElement>(`[data-mini="${name}"]`);
    const shown = new Map<string, number>();
    const frames = new Map<string, number>();
    const cost = field("cost");
    const costMin = Number(cost.dataset.min);
    const costMax = Number(cost.dataset.max);
    let lastCost = parseMoney(cost.value) ?? costMin;
    let liveTimer: number | undefined;

    // Número fora do intervalo (ou campo vazio) usa o limite mais próximo; o campo é corrigido ao sair dele.
    const clamp = (input: HTMLInputElement) => {
      const v = Number(input.value);
      const fallback = Number(input.defaultValue);
      return Math.min(Math.max(Number.isFinite(v) && input.value !== "" ? v : fallback, Number(input.min)), Number(input.max));
    };

    // Custo digitado: aceita "4000", "4.000" e "4.000,50"; fora do formato ou do intervalo, avisa e mantém o último válido.
    const readCost = () => {
      const value = parseMoney(cost.value);
      let message = "";
      if (value === null) message = "Digite só números no custo, por exemplo 3.500 ou 3.500,50.";
      else if (value < costMin || value > costMax) message = `Use um custo entre ${brl(costMin)} e ${brl(costMax)}.`;
      if (costError) {
        costError.textContent = message;
        costError.hidden = message === "";
      }
      cost.setAttribute("aria-invalid", String(message !== ""));
      if (!message && value !== null) lastCost = value;
      return lastCost;
    };

    // O número desliza até o novo valor; com movimento reduzido, troca direto.
    const tween = (el: HTMLElement | null, key: string, to: number, fmt: (n: number) => string) => {
      if (!el) return;
      const from = shown.get(key) ?? to;
      shown.set(key, to);
      cancelAnimationFrame(frames.get(key) ?? 0);
      if (reduce.matches || from === to) {
        el.textContent = fmt(to);
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 320, 1);
        const e = 1 - (1 - t) ** 3;
        el.textContent = fmt(from + (to - from) * e);
        if (t < 1) frames.set(key, requestAnimationFrame(step));
      };
      frames.set(key, requestAnimationFrame(step));
    };

    const update = (announce = true) => {
      const x = { people: clamp(field("people")), hours: clamp(field("hours")), cost: readCost(), share: clamp(field("share")) };
      const r = estimate(x);
      tween(res("freed"), "freed", r.freed, (n) => num(n));
      tween(res("repetitive"), "repetitive", r.repetitive, (n) => num(n));
      tween(res("month"), "month", r.month, brl);
      tween(res("year"), "year", r.year, brl);
      tween(mini("freed"), "mini-freed", r.freed, (n) => num(n));
      tween(mini("month"), "mini-month", r.month, brl);
      const fte = result.querySelector<HTMLElement>("[data-res-fte]");
      if (fte) fte.textContent = fteText(r.fte);
      bar?.style.setProperty("--p", `${Math.round((r.freed / r.repetitive) * 100)}%`);
      if (mail) mail.href = talkMailto("Estimativa de horas liberadas", estimateMail(x));

      // O leitor de tela ouve só o resultado final, quando a pessoa para de ajustar.
      window.clearTimeout(liveTimer);
      if (announce && live) liveTimer = window.setTimeout(() => (live.textContent = estimateSummary(x)), 700);
    };

    form.addEventListener("input", () => update());
    form.addEventListener("submit", (event) => event.preventDefault());
    for (const name of ["people", "hours", "share"]) {
      const input = field(name);
      input.addEventListener("change", () => {
        input.value = String(clamp(input));
        update();
      });
    }
    // Botões de menos e mais: o mesmo passo do campo.
    for (const btn of form.querySelectorAll<HTMLButtonElement>("[data-step]")) {
      btn.addEventListener("click", () => {
        const input = field(btn.dataset.step ?? "");
        const step = Number(input.step) || 1;
        input.value = String(Math.min(Math.max(clamp(input) + step * Number(btn.dataset.dir), Number(input.min)), Number(input.max)));
        update();
      });
    }
    // Ao sair do campo de custo, o valor válido volta formatado ("4000" vira "4.000").
    cost.addEventListener("change", () => {
      if (cost.getAttribute("aria-invalid") !== "true") cost.value = num(lastCost, Number.isInteger(lastCost) ? 0 : 2);
    });
    update(false);
  }
</script>

<style>
  .est {
    background: var(--surface);
  }

  .est-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  /* ---- A frase ---- */
  .sentence {
    display: grid;
    gap: var(--s-5);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 2.1;
    letter-spacing: -0.012em;
  }

  .sentence label {
    cursor: pointer;
  }

  .num,
  .money {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    vertical-align: middle;
    padding: 0.2rem;
    border-radius: 999px;
    background: var(--goiaba-soft);
    line-height: 1;
  }

  .num input,
  .money input {
    width: 3.2ch;
    min-height: 3rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--jabu);
    font: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .num input::-webkit-outer-spin-button,
  .num input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .num:focus-within,
  .money:focus-within {
    box-shadow: 0 0 0 3px var(--goiaba-ink);
  }

  .num input:focus-visible,
  .money input:focus-visible {
    outline: none;
  }

  .money {
    padding-inline: 0.9rem;
    gap: 0.3rem;
    color: var(--goiaba-ink);
  }

  .money input {
    width: 5.6ch;
    text-align: left;
  }

  .money:has(input[aria-invalid="true"]) {
    box-shadow: 0 0 0 3px var(--goiaba-ink);
  }

  .step {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--surface);
    color: var(--jabu);
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: var(--shadow-1);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: transform var(--d-fast) var(--ease-out);
  }

  .step:active {
    transform: scale(0.92);
  }

  .field-error {
    font-family: var(--font-body);
    font-size: var(--t-sm);
    font-weight: 650;
    line-height: 1.5;
    color: var(--goiaba-ink);
  }

  .hints {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: var(--t-sm);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--ink-3);
  }

  .est-mini {
    display: none;
  }

  /* ---- A resposta ---- */
  .answer {
    display: grid;
    gap: var(--s-3);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--r-xl);
    background: var(--goiaba-soft);
    color: var(--jabu);
  }

  .answer-tag {
    justify-self: start;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--t-xs);
    font-weight: 700;
  }

  .answer-lead {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 600;
  }

  .answer-big {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 2.4rem + 4vw, 6rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .answer-unit {
    display: inline-block;
    font-size: 0.3em;
    letter-spacing: -0.01em;
  }

  .bar {
    height: 12px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.8);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    width: var(--p);
    border-radius: inherit;
    background: var(--goiaba-ink);
    transition: width var(--d-slow) var(--ease-out);
  }

  .answer-of {
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .answer-list {
    display: grid;
    margin-block: var(--s-2);
    border-top: 1px solid rgb(42 20 48 / 0.14);
  }

  .answer-list div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid rgb(42 20 48 / 0.14);
  }

  .answer-list dt {
    color: var(--ink-2);
  }

  .answer-list dd {
    font-weight: 700;
  }

  .answer-note {
    font-size: var(--t-xs);
    color: var(--ink-2);
  }

  /* ---- Premissas ---- */
  .how {
    margin-top: var(--s-6);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .how summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.5rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .how summary::-webkit-details-marker {
    display: none;
  }

  .how summary :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform var(--d-base) var(--ease-out);
  }

  .how[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .how ul {
    padding-bottom: var(--s-5);
    font-size: var(--t-sm);
    color: var(--ink-2);
    max-width: 70ch;
  }

  @media (max-width: 63.99rem) {
    .est-grid {
      grid-template-columns: 1fr;
    }

    .est-mini {
      position: sticky;
      bottom: calc(0.75rem + env(safe-area-inset-bottom));
      z-index: 2;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--s-1) var(--s-4);
      padding: var(--s-3) var(--s-4);
      border-radius: var(--r-md);
      background: var(--jabu);
      color: #fbf3fb;
      font-family: var(--font-body);
      font-size: var(--t-sm);
      font-weight: 400;
      line-height: 1.4;
      letter-spacing: 0;
      box-shadow: 0 12px 28px -12px rgb(42 20 48 / 0.6);
    }

    .est-mini strong {
      font-family: var(--font-display);
      font-size: var(--t-md);
    }
  }

  @media (max-width: 30rem) {
    .sentence {
      line-height: 2.25;
    }
  }
</style>
