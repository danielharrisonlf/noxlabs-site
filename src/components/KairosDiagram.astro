---
/**
 * Topologia do Kairos desenhada na gramática do site:
 * círculo vazado = interface, círculo anil = serviço, quadrado = banco próprio,
 * barras = fila, linha cheia = requisição, linha tracejada = evento.
 * Duas composições: horizontal (>= 75rem) e vertical, com espinha central.
 */
interface Props {
  id?: string;
}

const { id = "kairos" } = Astro.props;

type Svc = { name: string; sub: string; x: number; db: boolean };

// Horizontal: ordem pensada para o barramento de eventos ficar curto.
const services: Svc[] = [
  { name: "Identidade", sub: "OAuth 2.1", x: 150, db: true },
  { name: "Notificações", sub: "3 canais", x: 330, db: true },
  { name: "Auditoria", sub: "append-only", x: 510, db: true },
  { name: "Projetos", sub: "tarefas, sprints", x: 690, db: true },
  { name: "Tempo real", sub: "WebSocket", x: 870, db: false },
  { name: "MCP", sub: "49 ferramentas", x: 1050, db: false },
];
const SY = 372; // linha dos serviços
const SR = 26;
const GX = 600;
const GY = 228;
const GR = 40;
const clients = [
  { name: "Workspace", sub: "React", x: 360 },
  { name: "Insights", sub: "Vue", x: 600 },
  { name: "Agentes de IA", sub: "Claude, ChatGPT, Cursor", x: 840 },
];
const CY = 96;
const CR = 22;
const BUS = 488; // barramento de eventos
const consumers = [330, 510, 870];
const producer = 690;

// Vertical: espinha em x=180, serviços dos dois lados.
const vServices = [
  { name: "Identidade", sub: "OAuth 2.1", side: "l", y: 300, db: true },
  { name: "Projetos", sub: "tarefas, sprints", side: "r", y: 300, db: true },
  { name: "Notificações", sub: "3 canais", side: "l", y: 400, db: true },
  { name: "Tempo real", sub: "WebSocket", side: "r", y: 400, db: false },
  { name: "Auditoria", sub: "append-only", side: "l", y: 500, db: true },
  { name: "MCP", sub: "49 ferramentas", side: "r", y: 500, db: false },
] as const;
const VR = 18;
const SPINE = 180;
const vx = (side: "l" | "r") => (side === "l" ? 146 : 214);
---

<figure class="kd" aria-labelledby={`${id}-cap`}>
  <div class="kd-canvas">
    <svg class="kd-wide" viewBox="0 0 1200 580" role="img" aria-labelledby={`${id}-t1 ${id}-d1`}>
      <title id={`${id}-t1`}>Arquitetura do Kairos</title>
      <desc id={`${id}-d1`}>
        Workspace em React, Insights em Vue e agentes de IA acessam um gateway. O gateway encaminha para seis serviços:
        identidade, notificações, auditoria, projetos, tempo real e MCP. Identidade, notificações, auditoria e projetos têm
        banco próprio. Projetos grava cada alteração com um evento na mesma transação; os eventos seguem por filas Redis e
        BullMQ para notificações, auditoria e tempo real. O servidor MCP chama projetos com o token do usuário.
      </desc>

      <!-- Requisições: clientes para o gateway -->
      <g class="kd-req">
        {clients.map((c) => <line x1={c.x} y1={CY + CR} x2={GX} y2={GY - GR} />)}
        {services.map((s) => <line x1={GX} y1={GY + GR} x2={s.x} y2={SY - SR} />)}
      </g>

      <!-- Module Federation: Insights dentro do Workspace -->
      <line class="kd-mf" x1={360 + CR} y1={CY} x2={600 - CR} y2={CY} />

      <!-- MCP chama Projetos com o token do usuário -->
      <path class="kd-mcp" d={`M ${1050 - 8} ${SY + SR - 2} C 1000 ${SY + 92}, 760 ${SY + 92}, ${690 + 10} ${SY + SR - 1}`} />

      <!-- Barramento de eventos -->
      <g class="kd-evt">
        <line x1={consumers[0]} y1={BUS} x2={consumers[2]} y2={BUS} />
        <line x1={producer} y1={SY + SR} x2={producer} y2={BUS} />
        {consumers.map((x) => <line x1={x} y1={BUS} x2={x} y2={SY + SR + 12} />)}
      </g>
      {consumers.map((x) => <path class="kd-arrow" d={`M ${x - 6} ${SY + SR + 14} L ${x} ${SY + SR + 4} L ${x + 6} ${SY + SR + 14} Z`} />)}
      <g class="kd-queue">
        <rect x={600 - 34} y={BUS - 15} width="68" height="8" />
        <rect x={600 - 34} y={BUS - 4} width="68" height="8" />
        <rect x={600 - 34} y={BUS + 7} width="68" height="8" />
      </g>
      <text class="kd-name kd-halo" x="600" y={BUS + 44} text-anchor="middle">Outbox e filas Redis/BullMQ</text>
      <text class="kd-sub kd-halo" x="600" y={BUS + 64} text-anchor="middle">alteração e evento gravados na mesma transação</text>

      <!-- Clientes -->
      {
        clients.map((c) => (
          <g>
            <circle class="kd-client" cx={c.x} cy={CY} r={CR} />
            <text class="kd-name" x={c.x} y={CY - CR - 30} text-anchor="middle">{c.name}</text>
            <text class="kd-sub" x={c.x} y={CY - CR - 11} text-anchor="middle">{c.sub}</text>
          </g>
        ))
      }

      <!-- Gateway -->
      <circle class="kd-svc" cx={GX} cy={GY} r={GR} />
      <text class="kd-name kd-halo" x={GX + GR + 14} y={GY - 4}>Gateway</text>
      <text class="kd-sub kd-halo" x={GX + GR + 14} y={GY + 16}>REST, WebSocket e /mcp</text>

      <!-- Serviços -->
      {
        services.map((s) => (
          <g>
            <circle class="kd-svc" cx={s.x} cy={SY} r={SR} />
            {s.db && <rect class="kd-db" x={s.x + 2} y={SY + 2} width="24" height="24" />}
            <text class="kd-name kd-halo" x={s.x + SR + 12} y={SY - 4}>{s.name}</text>
            <text class="kd-sub kd-halo" x={s.x + SR + 12} y={SY + 15}>{s.sub}</text>
          </g>
        ))
      }
    </svg>

    <svg class="kd-tall" viewBox="0 0 360 560" role="img" aria-labelledby={`${id}-t2 ${id}-d2`}>
      <title id={`${id}-t2`}>Arquitetura do Kairos</title>
      <desc id={`${id}-d2`}>
        Workspace, Insights e agentes de IA acessam um gateway, que encaminha para seis serviços: identidade, projetos,
        notificações, tempo real, auditoria e MCP. Identidade, projetos, notificações e auditoria têm banco próprio.
      </desc>

      <g class="kd-req">
        {[60, 180, 300].map((x) => <line x1={x} y1={70 + 17} x2={SPINE} y2={170 - 28} />)}
        <line x1={SPINE} y1={170 + 28} x2={SPINE} y2={500} />
        {vServices.map((s) => <line x1={SPINE} y1={s.y} x2={s.side === "l" ? vx("l") + VR : vx("r") - VR} y2={s.y} />)}
      </g>
      <line class="kd-mf" x1={60 + 17} y1="70" x2={180 - 17} y2="70" />

      {
        [
          { x: 60, n: "Workspace" },
          { x: 180, n: "Insights" },
          { x: 300, n: "Agentes de IA" },
        ].map((c) => (
          <g>
            <circle class="kd-client" cx={c.x} cy="70" r="17" />
            <text class="kd-name" x={c.x} y="36" text-anchor="middle">{c.n}</text>
          </g>
        ))
      }

      <circle class="kd-svc" cx={SPINE} cy="170" r="28" />
      <text class="kd-name kd-halo" x={SPINE + 40} y="166">Gateway</text>
      <text class="kd-sub kd-halo" x={SPINE + 40} y="184">REST, WS e /mcp</text>

      {
        vServices.map((s) => {
          const x = vx(s.side);
          const left = s.side === "l";
          return (
            <g>
              <circle class="kd-svc" cx={x} cy={s.y} r={VR} />
              {s.db && <rect class="kd-db" x={left ? x - 18 : x + 1} y={s.y + 1} width="17" height="17" />}
              <text class="kd-name" x={left ? x - VR - 10 : x + VR + 10} y={s.y - 3} text-anchor={left ? "end" : "start"}>
                {s.name}
              </text>
              <text class="kd-sub" x={left ? x - VR - 10 : x + VR + 10} y={s.y + 15} text-anchor={left ? "end" : "start"}>
                {s.sub}
              </text>
            </g>
          );
        })
      }
    </svg>
  </div>

  <figcaption id={`${id}-cap`} class="kd-legend">
    <ul role="list">
      <li><svg viewBox="0 0 20 20" aria-hidden="true"><circle class="kd-client" cx="10" cy="10" r="8"></circle></svg>Interface</li>
      <li><svg viewBox="0 0 20 20" aria-hidden="true"><circle class="kd-svc" cx="10" cy="10" r="9"></circle></svg>Serviço NestJS</li>
      <li>
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle class="kd-svc" cx="9" cy="9" r="8"></circle><rect class="kd-db" x="9" y="9" width="10" height="10"></rect></svg>
        Banco próprio (schema no PostgreSQL)
      </li>
      <li class="kd-wide-only"><svg viewBox="0 0 20 20" aria-hidden="true"><g class="kd-queue"><rect x="2" y="4" width="16" height="3"></rect><rect x="2" y="9" width="16" height="3"></rect><rect x="2" y="14" width="16" height="3"></rect></g></svg>Fila de eventos</li>
      <li><svg viewBox="0 0 28 20" aria-hidden="true"><line class="kd-req-l" x1="1" y1="10" x2="27" y2="10"></line></svg>Requisição</li>
      <li class="kd-wide-only"><svg viewBox="0 0 28 20" aria-hidden="true"><line class="kd-evt-l" x1="1" y1="10" x2="27" y2="10"></line></svg>Evento</li>
    </ul>
  </figcaption>
</figure>

<style>
  .kd {
    --kd-bg: var(--bg-2);
    background: var(--kd-bg);
    border: 1px solid var(--rule-strong);
  }

  .kd-canvas {
    padding: clamp(1rem, 0.5rem + 2vw, 2.5rem) clamp(0.5rem, 0.2rem + 1.5vw, 2rem) var(--s-4);
  }

  .kd-wide {
    display: none;
    width: 100%;
    height: auto;
  }

  .kd-tall {
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
  }

  .kd-wide-only {
    display: none !important;
  }

  @media (min-width: 75rem) {
    .kd-wide-only {
      display: inline-flex !important;
    }
    .kd-wide {
      display: block;
    }
    .kd-tall {
      display: none;
    }
  }

  .kd :global(text) {
    font-family: var(--font-text);
    fill: var(--fg);
  }

  .kd-name {
    font-size: 15px;
    font-weight: 600;
  }

  .kd-sub {
    font-size: 13.5px;
    fill: var(--fg-2) !important;
  }

  .kd-tall .kd-name {
    font-size: 14px;
  }

  .kd-tall .kd-sub {
    font-size: 12.5px;
  }

  /* Halo cartográfico: linhas passam por trás dos rótulos sem sujá-los. */
  .kd-halo {
    paint-order: stroke;
    stroke: var(--kd-bg);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  .kd-req line,
  .kd-req-l {
    stroke: var(--fg);
    stroke-width: 1.25;
    opacity: 0.55;
  }

  .kd-mf {
    stroke: var(--fg);
    stroke-width: 1.25;
    stroke-dasharray: 2 4;
  }

  .kd-mcp {
    fill: none;
    stroke: var(--fg);
    stroke-width: 1.25;
    stroke-dasharray: 2 4;
  }

  .kd-evt line,
  .kd-evt-l {
    stroke: var(--anil-tinta);
    stroke-width: 2;
    stroke-dasharray: 7 5;
  }

  .kd-arrow {
    fill: var(--anil-tinta);
  }

  .kd-client {
    fill: var(--kd-bg);
    stroke: var(--fg);
    stroke-width: 2;
  }

  .kd-svc {
    fill: var(--anil);
  }

  .kd-db {
    fill: var(--fg);
    mix-blend-mode: multiply;
  }

  :global(:root[data-theme="dark"]) .kd-db {
    mix-blend-mode: normal;
    opacity: 0.9;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .kd-db {
      mix-blend-mode: normal;
      opacity: 0.9;
    }
  }

  .kd-queue rect {
    fill: var(--fg);
  }

  .kd-legend {
    border-top: 1px solid var(--rule);
    padding: var(--s-4) clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .kd-legend ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    font-size: var(--t-xs);
    color: var(--fg-2);
  }

  .kd-legend li {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }

  .kd-legend svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  .kd-legend svg[viewBox="0 0 28 20"] {
    width: 1.75rem;
  }
</style>
