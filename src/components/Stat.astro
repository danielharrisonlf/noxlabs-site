---
/**
 * Bloco de dado de mercado: número grande, frase curta e a fonte com o ano.
 * O número conta até o valor quando entra na tela (motion.ts), exceto faixas
 * como "60 a 70%", que ficam paradas para não mostrar valores falsos; o HTML já traz
 * o valor final, e o leitor de tela lê a frase completa, que não se mexe.
 */
import { type Stat, formatStat } from "../data/stats";

interface Props {
  stat: Stat;
  index?: number;
  /** Fundo do azulejo; a cor não carrega significado, só ritmo. */
  tone?: "lila" | "goiaba" | "caju" | "white";
}

const { stat, index = 0, tone = "white" } = Astro.props;
const shown = formatStat(stat);
---

<figure class:list={["stat", "tile", `tile-${tone}`]} data-reveal style={`--i:${index}`}>
  <!-- Tudo numa linha: espaço entre os elementos apareceria entre o número e o "%". -->
  <p class="stat-value tabular" aria-hidden="true">{stat.prefix}{stat.prefix ? <span>{shown}</span> : <span data-count={stat.value} data-decimals={stat.decimals ?? 0}>{shown}</span>}{stat.suffix && <span class="stat-suffix">{stat.suffix}</span>}</p>
  <p class="stat-text">
    <span class="visually-hidden">{stat.prefix}{shown}{stat.suffix}: </span>
    {stat.text}
  </p>
  <figcaption class="fonte">
    Fonte: <a href={stat.source.url}>{stat.source.org}, {stat.source.title}</a> (publicação de {stat.source.year}).{
      stat.note && ` ${stat.note}`
    }
  </figcaption>
</figure>

<style>
  .stat {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: clamp(1.35rem, 1rem + 1vw, 2rem);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.9rem + 1.8vw, 3.5rem);
    white-space: nowrap;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--jabu);
  }

  .stat-suffix {
    font-size: 0.5em;
    letter-spacing: -0.01em;
    margin-left: 0.1em;
  }

  .stat-text {
    font-size: var(--t-base);
    line-height: 1.45;
    max-width: 32ch;
  }

  .stat .fonte {
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px solid rgb(42 20 48 / 0.12);
    color: var(--ink-2);
  }
</style>
