---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  mailto?: string;
}

const { mailto = site.talkMailto } = Astro.props;
const here = Astro.url.pathname;
---

<header class="header">
  <div class="header-bar">
    <a class="header-home" href="/" aria-label="Noxlabs, página inicial">
      <Logo />
    </a>

    <nav class="header-nav" id="site-nav" aria-label="Principal" data-open="false">
      <ul role="list" class="nav-list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a
                href={item.href}
                data-nav-link={item.id}
                aria-current={item.href === here ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="menu-foot">
        <a class="btn btn-primary btn-block" href={mailto}>
          Marcar conversa de 30 min
          <Icon name="arrow-right" />
        </a>
        <a class="menu-mail" href={site.mailto}>{site.email}</a>
      </div>
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary btn-sm header-cta" href={mailto}>Marcar conversa</a>
      <button
        class="menu-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>(".header");
  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("site-nav");
  const outside = [document.querySelector("main"), document.querySelector("footer"), document.querySelector("[data-dock]")];

  // A barra ganha fundo e borda quando a página sai do topo.
  const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Menu em tela cheia abaixo de 64rem, com foco preso dentro e o resto da página inerte.
  const setMenu = (open: boolean, focusBack = true) => {
    if (!menuBtn || !menu) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    menu.dataset.open = String(open);
    root.classList.toggle("menu-open", open);
    for (const el of outside) if (el instanceof HTMLElement) el.inert = open;
    if (open) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
    else if (focusBack) menuBtn.focus({ preventScroll: true });
  };

  menuBtn?.addEventListener("click", () => setMenu(menuBtn.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setMenu(false, false);
  });
  document.addEventListener("keydown", (event) => {
    if (menuBtn?.getAttribute("aria-expanded") !== "true") return;
    if (event.key === "Escape") {
      setMenu(false);
      return;
    }
    if (event.key !== "Tab" || !menu) return;
    const items = [menuBtn, ...menu.querySelectorAll<HTMLElement>("a, button")];
    const i = items.indexOf(document.activeElement as HTMLElement);
    const next = event.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : i === items.length - 1 ? 0 : i + 1;
    event.preventDefault();
    items[next].focus();
  });
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false, false);
  });

  // Seção atual na navegação da página inicial.
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) {
    if (a.getAttribute("href")?.startsWith("/#")) links.set(a.dataset.navLink ?? "", a);
  }
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
  if (sections.length && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        const current = sections.find((s) => visible.has(s.id))?.id;
        for (const [id, a] of links) {
          if (id === current) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    for (const s of sections) io.observe(s);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: env(safe-area-inset-top) max(var(--gutter), env(safe-area-inset-right)) 0
      max(var(--gutter), env(safe-area-inset-left));
    transition:
      background-color var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out);
  }

  .header[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    box-shadow: 0 1px 0 var(--line);
    backdrop-filter: blur(14px) saturate(1.3);
  }

  .header-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-width: var(--max);
    height: var(--header-h);
    margin-inline: auto;
  }

  .header-home {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
    border-radius: var(--r-sm);
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: 0.15rem;
  }

  .nav-list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.8rem;
    border-radius: var(--r-sm);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--d-fast) var(--ease-out),
      background-color var(--d-fast) var(--ease-out);
  }

  /* Seção atual: um traço de marca-texto sob o link. */
  .nav-list a::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.45rem;
    height: 0.35rem;
    border-radius: 2px;
    background: var(--marca);
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--d-base) var(--ease-out);
  }

  .nav-list a[aria-current] {
    color: var(--ink);
  }

  .nav-list a[aria-current]::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .nav-list a:hover {
      color: var(--ink);
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }
  }

  .nav-list li {
    position: relative;
    isolation: isolate;
  }

  .menu-foot {
    display: none;
  }

  .header-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    cursor: pointer;
  }

  .burger {
    position: relative;
    width: 1.15rem;
    height: 0.7rem;
  }

  .burger span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--d-base) var(--ease-out);
  }

  .burger span:first-child {
    top: 0;
  }

  .burger span:last-child {
    top: calc(100% - 2px);
  }

  .menu-toggle[aria-expanded="true"] .burger span:first-child {
    transform: translateY(calc(0.35rem - 1px)) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .burger span:last-child {
    transform: translateY(calc(-0.35rem + 1px)) rotate(-45deg);
  }

  /* ---- Abaixo de 64rem: menu em tela cheia ---- */
  @media (max-width: 63.99rem) {
    .menu-toggle {
      display: inline-grid;
    }

    .header-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--s-6);
      height: 100dvh;
      padding: calc(env(safe-area-inset-top) + var(--header-h) + 1rem) max(var(--gutter), env(safe-area-inset-right))
        calc(env(safe-area-inset-bottom) + 1.5rem) max(var(--gutter), env(safe-area-inset-left));
      background: var(--bg);
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      opacity: 0;
      transition:
        opacity var(--d-base) var(--ease-out),
        visibility 0s linear var(--d-base);
    }

    .header-nav[data-open="true"] {
      visibility: visible;
      opacity: 1;
      transition:
        opacity var(--d-base) var(--ease-out),
        visibility 0s;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-list li {
      border-bottom: 1px solid var(--line);
    }

    .nav-list a {
      display: flex;
      width: 100%;
      min-height: 3.5rem;
      padding: 0.5rem 0;
      border-radius: 0;
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 1.2rem + 2vw, 2.1rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--ink);
    }

    .nav-list a::after {
      left: 0;
      right: auto;
      width: 3rem;
      bottom: 0.9rem;
    }

    .menu-foot {
      display: grid;
      gap: var(--s-3);
      justify-items: center;
    }

    .menu-mail {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      color: var(--ink-2);
      font-size: var(--t-sm);
      overflow-wrap: anywhere;
    }

    @media (prefers-reduced-motion: no-preference) {
      .header-nav[data-open="true"] .nav-list li {
        animation: menu-item 420ms var(--ease-out) both;
        animation-delay: calc(60ms + var(--i) * 35ms);
      }
    }

    :global(html.menu-open) {
      overflow: hidden;
    }

    :global(html.menu-open) .header {
      background: var(--bg);
      box-shadow: none;
      backdrop-filter: none;
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  /* Celular: o CTA vai para a base da tela (MobileCta). */
  @media (max-width: 39.99rem) {
    .header-cta {
      display: none;
    }
  }
</style>
