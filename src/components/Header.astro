---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
---

<header class="header">
  <div class="header-pill">
    <a class="header-home" href="/" aria-label="Noxlabs, página inicial">
      <Logo id="lg-h" />
    </a>

    <nav class="header-nav" id="site-nav" aria-label="Principal" data-open="false">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema claro e escuro">
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn-primary btn-sm header-cta" href={site.diagnosisMailto}>
        <span class="cta-long">Pedir diagnóstico</span>
        <span class="cta-short">Diagnóstico</span>
      </a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <Icon name="menu" class="i-menu" />
        <Icon name="close" class="i-close" />
      </button>
    </div>

    <span class="header-progress" aria-hidden="true"></span>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  const currentTheme = (): "light" | "dark" => {
    const set = root.dataset.theme;
    if (set === "light" || set === "dark") return set;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };

  const labelTheme = () => {
    if (!themeBtn) return;
    const next = currentTheme() === "dark" ? "claro" : "escuro";
    themeBtn.setAttribute("aria-label", `Usar tema ${next}`);
  };

  themeBtn?.addEventListener("click", () => {
    const next = currentTheme() === "dark" ? "light" : "dark";
    const apply = () => {
      root.dataset.theme = next;
      labelTheme();
    };
    // Troca de céu com uma transição de visão, quando o navegador tem e o movimento é bem-vindo.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "startViewTransition" in document) document.startViewTransition(apply);
    else apply();
    try {
      localStorage.setItem("noxlabs-theme", next);
    } catch {
      // Armazenamento bloqueado: o tema vale só para esta visita.
    }
  });
  labelTheme();

  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("site-nav");

  const setMenu = (open: boolean) => {
    if (!menuBtn || !menu) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    menu.dataset.open = String(open);
  };

  menuBtn?.addEventListener("click", () => setMenu(menuBtn.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setMenu(false);
  });
  document.addEventListener("click", (event) => {
    if (menuBtn?.getAttribute("aria-expanded") !== "true") return;
    const target = event.target as HTMLElement;
    if (!target.closest(".header-pill")) setMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuBtn?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      menuBtn.focus();
    }
  });
  window.matchMedia("(min-width: 70rem)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false);
  });

  // Seção atual: o link correspondente acende enquanto a seção ocupa o meio da tela.
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) {
    links.set(a.dataset.navLink ?? "", a);
  }
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const link = links.get(entry.target.id);
          if (!link) continue;
          if (entry.isIntersecting) {
            for (const other of links.values()) other.removeAttribute("aria-current");
            link.setAttribute("aria-current", "true");
          } else if (link.getAttribute("aria-current") === "true") {
            link.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    for (const section of sections) observer.observe(section);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 0.75rem var(--gutter) 0;
    pointer-events: none;
  }

  .header-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 76rem;
    min-height: 3.75rem;
    margin-inline: auto;
    padding: 0.4rem 0.45rem 0.4rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    box-shadow: var(--shadow-1);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    pointer-events: auto;
  }

  .header-home {
    margin-right: auto;
    padding-block: var(--s-2);
    text-decoration: none;
    border-radius: var(--r-sm);
  }

  .header-nav ul {
    display: flex;
    gap: 0.1rem;
  }

  .header-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    border-radius: var(--r-pill);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--fg-2);
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  /* Ponto de luz sob o link da seção atual */
  .header-nav a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    width: 0.3rem;
    height: 0.3rem;
    margin-left: -0.15rem;
    border-radius: 50%;
    background: var(--sodio);
    box-shadow: 0 0 8px var(--sodio);
    opacity: 0;
    transform: scale(0.2);
    transition:
      opacity 250ms var(--ease-out),
      transform 400ms var(--ease-spring);
  }

  .header-nav a[aria-current="true"] {
    color: var(--fg);
  }

  .header-nav a[aria-current="true"]::after {
    opacity: 1;
    transform: scale(1);
  }

  @media (hover: hover) {
    .header-nav a:hover {
      color: var(--fg);
      background: color-mix(in srgb, var(--fg) 7%, transparent);
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  .header-cta {
    margin-left: var(--s-1);
  }

  .cta-short {
    display: none;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms var(--ease-out);
  }

  .icon-btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    grid-area: 1 / 1;
    transition: transform 400ms var(--ease-spring);
  }

  @media (hover: hover) {
    .icon-btn:hover {
      background: color-mix(in srgb, var(--fg) 8%, transparent);
    }
    .theme-toggle:hover :global(svg) {
      transform: rotate(-18deg);
    }
  }

  .theme-toggle :global(.i-sun) {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.i-sun) {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.i-moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.i-sun) {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.i-moon) {
      display: none;
    }
  }

  .menu-toggle {
    display: none;
  }

  .menu-toggle :global(.i-close) {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] :global(.i-close) {
    display: block;
  }

  .menu-toggle[aria-expanded="true"] :global(.i-menu) {
    display: none;
  }

  /* Progresso da leitura: um rastro que cresce na borda de baixo da cápsula. */
  .header-progress {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--sodio), var(--freio) 60%, var(--mercurio));
    transform-origin: left center;
    transform: scaleX(0);
    opacity: 0.9;
  }

  @supports (animation-timeline: scroll()) {
    .header-progress {
      animation: read-progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 69.99rem) {
    .menu-toggle {
      display: inline-grid;
    }

    .header-nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      display: none;
      padding: var(--s-3);
      border: 1px solid var(--line);
      border-radius: var(--r-lg);
      background: var(--bg-2);
      box-shadow: var(--shadow-2);
    }

    .header-nav[data-open="true"] {
      display: block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .header-nav[data-open="true"] {
        animation: menu-in 320ms var(--ease-out);
      }
    }

    .header-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .header-nav a {
      display: flex;
      width: 100%;
      min-height: 3.25rem;
      padding-inline: var(--s-4);
      font-family: var(--font-display);
      font-size: var(--t-lg);
      font-weight: 500;
      color: var(--fg);
    }

    .header-nav a::after {
      left: auto;
      right: var(--s-4);
      top: 50%;
      bottom: auto;
      margin: -0.15rem 0 0;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  @media (max-width: 30rem) {
    .header-pill {
      padding-left: 0.85rem;
      gap: 0;
    }
    .cta-long {
      display: none;
    }
    .cta-short {
      display: inline;
    }
    .header-cta {
      padding-inline: 0.95rem;
    }
  }

  @media (max-width: 23.5rem) {
    .header :global(.logo-word) {
      font-size: 1.2rem;
    }
  }
</style>
