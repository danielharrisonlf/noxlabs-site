---
/**
 * Cabeçalho. Acima de 68.75rem: navegação em linha e um botão. Abaixo: só a
 * marca e "Menu", que abre uma folha que sobe da base da tela (a ação
 * principal fica na zona do polegar). A folha prende o foco, trava a rolagem
 * do fundo e fecha ao tocar num link, fora dela, com Esc, no "Fechar" ou com
 * o gesto de voltar. No celular, o cabeçalho some ao rolar para baixo e volta
 * ao rolar para cima.
 */
import { nav, site, whatsappHref } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";

interface Props {
  mailto?: string;
}

const { mailto = site.talkMailto } = Astro.props;
const here = Astro.url.pathname;
const whats = whatsappHref();
---

<header class="header" data-header>
  <div class="header-bar">
    <a class="header-home" href="/" aria-label="Noxlabs, página inicial">
      <Logo />
    </a>

    <nav class="header-nav" aria-label="Principal">
      <ul role="list" class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} data-nav-link={item.id} aria-current={item.href === here ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="btn btn-primary btn-sm header-cta" href={mailto}>Pedir uma conversa</a>
      <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-menu-toggle>
        <span data-menu-label>Menu</span>
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="sheet-backdrop" data-menu-backdrop hidden></div>
<div class="sheet" id="site-nav" role="dialog" aria-modal="true" aria-label="Menu" data-open="false" hidden>
  <div class="sheet-grip" aria-hidden="true"></div>

  <div class="sheet-scroll">
    <div class="sheet-extra">
      <div class="sheet-group">
        <p class="sheet-h">Outros contatos</p>
        {
          whats && (
            <a class="sheet-row" href={whats}>
              <Icon name="phone" class="no-nudge" />
              <span>Chamar no WhatsApp</span>
            </a>
          )
        }
        <div class="sheet-row sheet-mail">
          <a href={site.mailto}>{site.email}</a>
          <button type="button" class="sheet-copy" data-copy={site.email} data-copy-scope="menu">
            <Icon name="copy" class="no-nudge" />
            <span data-copy-label>Copiar</span>
          </button>
        </div>
      </div>
      <div class="sheet-group">
        <p class="sheet-h">Leia também</p>
        <div class="sheet-ext">
          <a href={site.links.blog}>Blog <Icon name="arrow-up-right" class="no-nudge" /></a>
          <a href={site.links.portfolio}>Portfólio do Daniel <Icon name="arrow-up-right" class="no-nudge" /></a>
        </div>
      </div>
    </div>

    <ul role="list" class="sheet-nav" aria-label="Seções">
      {
        nav.map((item, i) => (
          <li style={`--i:${nav.length - i}`}>
            <a href={item.href} data-nav-link={item.id} data-sheet-link aria-current={item.href === here ? "page" : undefined}>
              <span>{item.label}</span>
              <span class="here" aria-hidden="true">
                Você está aqui
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="sheet-cta">
    <a class="btn btn-primary btn-block" href={mailto}>
      <Icon name="mail" class="no-nudge" />
      Pedir uma conversa de 30 min
    </a>
    <p>Abre o seu e-mail com um roteiro pronto.</p>
  </div>
</div>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const label = toggle?.querySelector<HTMLElement>("[data-menu-label]");
  const sheet = document.getElementById("site-nav");
  const backdrop = document.querySelector<HTMLElement>("[data-menu-backdrop]");
  const outside = () => [document.querySelector("main"), document.querySelector("footer"), document.querySelector("[data-dock]")];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = window.matchMedia("(min-width: 68.75rem)");
  let open = false;
  let closeTimer: number | undefined;
  let pending: string | null = null;
  let nextHref: string | null = null;

  /* ---- Cabeçalho: fundo ao sair do topo; no celular, some ao descer e volta ao subir ---- */
  let lastY = window.scrollY;
  // Durante a rolagem que o próprio menu dispara, o cabeçalho fica visível.
  let holdUntil = 0;
  const onScroll = () => {
    const y = window.scrollY;
    header?.toggleAttribute("data-scrolled", y > 8);
    if (!open && !desktop.matches && header && !header.contains(document.activeElement) && performance.now() > holdUntil) {
      if (y > lastY + 6 && y > 160) header.dataset.hidden = "true";
      else if (y < lastY - 6 || y < 160) delete header.dataset.hidden;
    } else if (header) delete header.dataset.hidden;
    if (Math.abs(y - lastY) > 6) lastY = y;
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /* ---- Menu ---- */
  const focusables = () =>
    [toggle, ...(sheet?.querySelectorAll<HTMLElement>("a[href], button:not([disabled])") ?? [])].filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );

  const show = (value: boolean, focusBack = true) => {
    if (!toggle || !sheet || !backdrop || value === open) return;
    open = value;
    window.clearTimeout(closeTimer);
    toggle.setAttribute("aria-expanded", String(value));
    if (label) label.textContent = value ? "Fechar" : "Menu";
    for (const el of outside()) if (el instanceof HTMLElement) el.inert = value;
    if (value) {
      sheet.hidden = false;
      backdrop.hidden = false;
      delete header?.dataset.hidden;
      root.classList.add("menu-open");
      // Um quadro para o navegador aplicar o estado inicial antes da transição.
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          sheet.dataset.open = "true";
          backdrop.dataset.open = "true";
        }),
      );
      sheet.querySelector<HTMLElement>("[data-sheet-link]")?.focus({ preventScroll: true });
    } else {
      sheet.dataset.open = "false";
      backdrop.dataset.open = "false";
      root.classList.remove("menu-open");
      closeTimer = window.setTimeout(
        () => {
          sheet.hidden = true;
          backdrop.hidden = true;
        },
        reduce.matches ? 0 : 320,
      );
      if (focusBack) toggle.focus({ preventScroll: true });
    }
  };

  // O gesto de voltar fecha o menu: abrir empilha um estado no histórico.
  const openMenu = () => {
    history.pushState({ noxMenu: true }, "");
    show(true);
  };
  const closeMenu = (focusBack = true) => {
    if (!open) return;
    show(false, focusBack);
    if (history.state?.noxMenu) history.back();
  };

  window.addEventListener("popstate", () => {
    if (open) show(false, pending === null && nextHref === null);
    if (nextHref) {
      const href = nextHref;
      nextHref = null;
      location.assign(href);
      return;
    }
    if (pending) {
      const target = document.querySelector<HTMLElement>(pending);
      const hash = pending;
      pending = null;
      // Espera o navegador restaurar a rolagem do estado anterior; só então rola até a seção.
      if (target)
        window.setTimeout(() => {
          holdUntil = performance.now() + 1500;
          history.replaceState(null, "", hash);
          target.scrollIntoView({ behavior: reduce.matches ? "auto" : "smooth", block: "start" });
          target.focus({ preventScroll: true });
        }, 40);
    }
  });

  toggle?.addEventListener("click", () => (open ? closeMenu() : openMenu()));
  backdrop?.addEventListener("click", () => closeMenu());

  sheet?.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[href]");
    if (!link || !open) return;
    const url = new URL(link.href, location.href);
    const samePage = url.origin === location.origin && url.pathname === location.pathname && url.hash;
    // Fecha o menu primeiro (desfazendo o estado do histórico) e só então rola ou navega.
    event.preventDefault();
    if (samePage) pending = url.hash;
    else nextHref = link.href;
    if (history.state?.noxMenu) history.back();
    else {
      show(false, false);
      window.dispatchEvent(new PopStateEvent("popstate"));
    }
  });

  document.addEventListener("keydown", (event) => {
    if (!open) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeMenu();
      return;
    }
    if (event.key !== "Tab") return;
    const items = focusables();
    const i = items.indexOf(document.activeElement as HTMLElement);
    const next = event.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : i === items.length - 1 ? 0 : i + 1;
    event.preventDefault();
    items[next]?.focus();
  });

  desktop.addEventListener("change", (event) => {
    if (event.matches) closeMenu(false);
  });

  // Seções alvo ganham tabindex para receber o foco depois da navegação.
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-sheet-link]")) {
    const id = a.getAttribute("href")?.split("#")[1];
    const target = id ? document.getElementById(id) : null;
    if (target && !target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
  }

  /* ---- Seção atual (página inicial) ---- */
  const links = new Map<string, HTMLAnchorElement[]>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) {
    if (!a.getAttribute("href")?.startsWith("/#")) continue;
    const id = a.dataset.navLink ?? "";
    links.set(id, [...(links.get(id) ?? []), a]);
  }
  const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => el !== null);
  if (sections.length && "IntersectionObserver" in window) {
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        const current = sections.find((s) => visible.has(s.id))?.id;
        for (const [id, list] of links) {
          for (const a of list) {
            if (id === current) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          }
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );
    for (const s of sections) io.observe(s);
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding: env(safe-area-inset-top) max(var(--gutter), env(safe-area-inset-right)) 0
      max(var(--gutter), env(safe-area-inset-left));
    transition:
      background-color var(--d-base) var(--ease-out),
      box-shadow var(--d-base) var(--ease-out),
      transform 360ms var(--ease-out);
  }

  .header[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    box-shadow: 0 1px 0 var(--line);
    backdrop-filter: blur(12px) saturate(1.2);
  }

  .header[data-hidden="true"] {
    transform: translateY(calc(-100% - 2px));
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-width: var(--max);
    height: var(--header-h);
    margin-inline: auto;
  }

  .header-home {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    margin-right: auto;
    border-radius: var(--r-sm);
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: 0.1rem;
  }

  .nav-list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border-radius: 12px;
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      color var(--d-fast) var(--ease-out),
      background-color var(--d-fast) var(--ease-out);
  }

  .nav-list a[aria-current] {
    color: var(--ink);
    background: var(--goiaba-soft);
  }

  @media (hover: hover) {
    .nav-list a:hover {
      color: var(--ink);
      background: color-mix(in srgb, var(--ink) 6%, transparent);
    }

    .nav-list a[aria-current]:hover {
      background: var(--goiaba-soft);
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 3rem;
    padding: 0 1rem 0 1.1rem;
    border: 0;
    border-radius: 999px;
    background: var(--jabu);
    color: #fff;
    font-size: 1rem;
    font-weight: 650;
    -webkit-tap-highlight-color: transparent;
  }

  .burger {
    position: relative;
    width: 1.1rem;
    height: 0.7rem;
  }

  .burger span {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform var(--d-base) var(--ease-out);
  }

  .burger span:first-child {
    top: 0;
  }

  .burger span:last-child {
    top: calc(100% - 2px);
  }

  .menu-toggle[aria-expanded="true"] .burger span:first-child {
    transform: translateY(calc(0.35rem - 1px)) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .burger span:last-child {
    transform: translateY(calc(-0.35rem + 1px)) rotate(-45deg);
  }

  /* ---- Folha do menu ---- */
  .sheet,
  .sheet-backdrop {
    display: none;
  }

  @media (max-width: 68.74rem) {
    .header-nav {
      display: none;
    }

    :global(html.js) .menu-toggle {
      display: inline-flex;
    }

    .sheet-backdrop {
      position: fixed;
      inset: 0;
      z-index: 55;
      display: block;
      background: rgb(42 20 48 / 0.42);
      opacity: 0;
      transition: opacity 260ms var(--ease-out);
    }

    .sheet-backdrop[data-open="true"] {
      opacity: 1;
    }

    .sheet {
      position: fixed;
      inset: auto 0 0;
      z-index: 58;
      display: flex;
      flex-direction: column;
      max-height: calc(100dvh - var(--header-h) - env(safe-area-inset-top) - 0.5rem);
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      background: var(--jabu);
      color: #fbf3fb;
      box-shadow: 0 -20px 50px -20px rgb(42 20 48 / 0.6);
      transform: translateY(104%);
      transition: transform 360ms var(--ease-out);
      overscroll-behavior: contain;
    }

    .sheet[data-open="true"] {
      transform: none;
    }

    .sheet[hidden],
    .sheet-backdrop[hidden] {
      display: none;
    }

    :global(html.menu-open) {
      overflow: hidden;
    }

    :global(html.menu-open) body {
      overflow: hidden;
    }

    :global(html.menu-open) .header {
      background: var(--bg);
      box-shadow: 0 1px 0 var(--line);
    }
  }

  @media (max-width: 39.99rem) {
    .header-cta {
      display: none;
    }
  }

  .sheet-grip {
    flex: none;
    width: 2.75rem;
    height: 5px;
    margin: 0.6rem auto 0.25rem;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.28);
  }

  .sheet-scroll {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-3) max(var(--gutter), env(safe-area-inset-right)) var(--s-2) max(var(--gutter), env(safe-area-inset-left));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .sheet-extra {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.06);
  }

  .sheet-group {
    display: grid;
    gap: var(--s-1);
  }

  .sheet-h {
    font-size: var(--t-xs);
    font-weight: 650;
    color: #d9c5df;
  }

  .sheet-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 3rem;
    color: #fbf3fb;
    font-size: var(--t-sm);
    text-decoration: none;
  }

  .sheet-row svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .sheet-mail {
    justify-content: space-between;
  }

  .sheet-mail a {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    min-width: 0;
    overflow-wrap: anywhere;
    color: inherit;
    text-decoration: none;
  }

  .sheet-copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 3rem;
    padding: 0 1rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    color: var(--caju);
    font-size: var(--t-sm);
    font-weight: 650;
  }

  .sheet-copy svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .sheet-ext {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .sheet-ext a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 3rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    color: #fbf3fb;
    font-size: var(--t-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .sheet-ext svg {
    width: 1rem;
    height: 1rem;
  }

  .sheet-nav {
    display: grid;
    gap: 2px;
  }

  .sheet-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: 3.5rem;
    padding: 0 var(--s-4);
    border-radius: var(--r-sm);
    color: #fbf3fb;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.6vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--d-fast) var(--ease-out);
  }

  .sheet-nav a:active {
    background: rgb(255 255 255 / 0.12);
  }

  .here {
    display: none;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--caju);
    color: var(--jabu);
    font-family: var(--font-body);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .sheet-nav a[aria-current] {
    background: rgb(255 255 255 / 0.1);
  }

  .sheet-nav a[aria-current] .here {
    display: inline-block;
  }

  .sheet-cta {
    flex: none;
    display: grid;
    gap: var(--s-2);
    padding: var(--s-3) max(var(--gutter), env(safe-area-inset-right)) max(1rem, env(safe-area-inset-bottom))
      max(var(--gutter), env(safe-area-inset-left));
    box-shadow: 0 -16px 20px -12px rgb(42 20 48 / 0.9);
    position: relative;
  }

  .sheet-cta .btn-primary {
    --btn-bg: var(--goiaba);
    --btn-fg: var(--jabu);
    box-shadow: none;
  }

  .sheet-cta p {
    font-size: var(--t-xs);
    text-align: center;
    color: #d9c5df;
  }

  .sheet :focus-visible {
    outline-color: var(--caju);
  }

  /* Telas baixas (360×640, paisagem): links menores, nada cortado. */
  @media (max-height: 44rem) {
    .sheet-nav a {
      min-height: 3rem;
      font-size: 1.3rem;
    }

    .sheet-cta p {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet[data-open="true"] .sheet-nav li {
      animation: sheet-item 420ms var(--ease-out) both;
      animation-delay: calc(80ms + var(--i) * 30ms);
    }
  }

  @keyframes sheet-item {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
