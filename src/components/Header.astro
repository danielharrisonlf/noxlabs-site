---
import { nav, site } from "../data/site";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
---

<header class="header">
  <div class="header-pill">
    <a class="header-home" href="/" aria-label="Noxlabs, página inicial">
      <Logo id="lg-h" />
    </a>

    <nav class="header-nav" id="site-nav" aria-label="Principal" data-open="false">
      <ul role="list" class="nav-list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} data-nav-link={item.id}>
                <span class="nav-num tabular" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <!-- Indicador da seção atual: desliza até o link e se enche com o progresso da seção. -->
      <span class="nav-ind" aria-hidden="true"><span class="nav-ind-fill"></span></span>

      <div class="menu-foot">
        <a class="btn btn-primary" href={site.diagnosisMailto}>
          Pedir diagnóstico de 30 min
          <Icon name="mail" class="no-nudge" />
        </a>
        <div class="menu-row">
          <a class="menu-mail" href={site.mailto}>{site.email}</a>
          <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Alternar tema claro e escuro">
            <Icon name="moon" class="i-moon" />
            <Icon name="sun" class="i-sun" />
          </button>
        </div>
      </div>
      <svg class="menu-trails" viewBox="0 0 400 300" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
        <path d="M 420 120 C 300 160, 180 260, -20 300" pathLength="1"></path>
        <path d="M 420 170 C 320 200, 200 280, 40 330" pathLength="1"></path>
      </svg>
    </nav>

    <div class="header-actions">
      <button
        class="icon-btn theme-toggle header-theme"
        type="button"
        data-theme-toggle
        aria-label="Alternar tema claro e escuro"
      >
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <a class="btn btn-primary btn-sm header-cta" href={site.diagnosisMailto}>Pedir diagnóstico</a>
      <button
        class="icon-btn menu-toggle"
        type="button"
        aria-controls="site-nav"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <span class="burger" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>

    <span class="header-progress" aria-hidden="true"></span>
  </div>
</header>

<script>
  import { reducedMotion } from "../scripts/motion";

  const root = document.documentElement;
  const themeBtns = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")];

  const currentTheme = (): "light" | "dark" => {
    const set = root.dataset.theme;
    if (set === "light" || set === "dark") return set;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };

  const labelTheme = () => {
    const next = currentTheme() === "dark" ? "claro" : "escuro";
    for (const b of themeBtns) b.setAttribute("aria-label", `Usar tema ${next}`);
  };

  for (const btn of themeBtns) {
    btn.addEventListener("click", () => {
      const next = currentTheme() === "dark" ? "light" : "dark";
      const apply = () => {
        root.dataset.theme = next;
        labelTheme();
      };
      try {
        localStorage.setItem("noxlabs-theme", next);
      } catch {
        // Armazenamento bloqueado: o tema vale só para esta visita.
      }
      if (reducedMotion() || !("startViewTransition" in document)) {
        apply();
        return;
      }
      // O tema novo se abre num círculo a partir do botão (ver theme-reveal em global.css).
      const r = btn.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      root.style.setProperty("--vt-x", `${x}px`);
      root.style.setProperty("--vt-y", `${y}px`);
      root.style.setProperty("--vt-r", `${radius}px`);
      root.classList.add("theme-vt");
      const vt = document.startViewTransition(apply);
      vt.finished.finally(() => root.classList.remove("theme-vt"));
    });
  }
  labelTheme();

  // Menu: tela cheia abaixo de 70rem, com foco preso dentro e o resto da página inerte.
  const menuBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("site-nav");
  const outside = [document.querySelector("main"), document.querySelector("footer"), document.querySelector("[data-dock]")];

  const setMenu = (open: boolean, focusBack = true) => {
    if (!menuBtn || !menu) return;
    menuBtn.setAttribute("aria-expanded", String(open));
    menuBtn.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    menu.dataset.open = String(open);
    root.classList.toggle("menu-open", open);
    for (const el of outside) if (el instanceof HTMLElement) el.inert = open;
    if (open) menu.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
    else if (focusBack) menuBtn.focus({ preventScroll: true });
  };

  menuBtn?.addEventListener("click", () => setMenu(menuBtn.getAttribute("aria-expanded") !== "true"));
  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) setMenu(false, false);
  });
  document.addEventListener("keydown", (event) => {
    if (menuBtn?.getAttribute("aria-expanded") !== "true") return;
    if (event.key === "Escape") {
      setMenu(false);
      return;
    }
    if (event.key !== "Tab" || !menu) return;
    // Tab circula entre o botão do menu e os itens do menu.
    const items = [menuBtn, ...menu.querySelectorAll<HTMLElement>("a, button")];
    const i = items.indexOf(document.activeElement as HTMLElement);
    const next = event.shiftKey ? (i <= 0 ? items.length - 1 : i - 1) : i === items.length - 1 ? 0 : i + 1;
    event.preventDefault();
    items[next].focus();
  });
  window.matchMedia("(min-width: 70rem)").addEventListener("change", (event) => {
    if (event.matches) setMenu(false, false);
  });

  // Seção atual e progresso dentro dela, no indicador que desliza sob os links.
  const list = document.querySelector<HTMLElement>(".nav-list");
  const ind = document.querySelector<HTMLElement>(".nav-ind");
  const links = new Map<string, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) links.set(a.dataset.navLink ?? "", a);
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && list && ind) {
    let active: HTMLElement | null = null;
    let frame = 0;

    const place = () => {
      if (!active) {
        ind.dataset.on = "false";
        return;
      }
      const link = links.get(active.id);
      if (!link) return;
      ind.dataset.on = "true";
      ind.style.setProperty("--ix", `${link.offsetLeft + 12}px`);
      ind.style.setProperty("--iw", `${Math.max(link.offsetWidth - 24, 8) / 100}`);
    };

    const measure = () => {
      frame = 0;
      const mid = window.scrollY + window.innerHeight * 0.45;
      let current: HTMLElement | null = null;
      for (const s of sections) if (s.offsetTop <= mid) current = s;
      if (current && mid > current.offsetTop + current.offsetHeight) current = null;
      if (current !== active) {
        for (const a of links.values()) a.removeAttribute("aria-current");
        if (current) links.get(current.id)?.setAttribute("aria-current", "true");
        active = current;
        place();
      }
      if (active) {
        const p = (mid - active.offsetTop) / active.offsetHeight;
        ind.style.setProperty("--sp", `${Math.min(Math.max(p, 0), 1)}`);
      }
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(measure);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      place();
      onScroll();
    });
    document.fonts?.ready.then(place);
    measure();
  }
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: calc(0.75rem + env(safe-area-inset-top)) max(var(--gutter), env(safe-area-inset-right)) 0
      max(var(--gutter), env(safe-area-inset-left));
    pointer-events: none;
    view-transition-name: site-header;
  }

  .header-pill {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    max-width: 76rem;
    min-height: 3.75rem;
    margin-inline: auto;
    padding: 0.4rem 0.45rem 0.4rem 1.1rem;
    border-radius: var(--r-pill);
    isolation: isolate;
    pointer-events: auto;
  }

  /* O vidro fica num pseudo-elemento: backdrop-filter na própria cápsula viraria o
     bloco de contenção do menu fixo em tela cheia. */
  .header-pill::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    border: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    border-radius: inherit;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    box-shadow: var(--shadow-1);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
  }

  .header-home {
    position: relative;
    z-index: 2;
    margin-right: auto;
    padding-block: var(--s-2);
    text-decoration: none;
    border-radius: var(--r-sm);
  }

  .header-nav {
    position: relative;
  }

  .nav-list {
    display: flex;
    gap: 0.1rem;
  }

  .nav-list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.85rem;
    border-radius: var(--r-pill);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--fg-2);
    text-decoration: none;
    transition:
      color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  .nav-num {
    display: none;
  }

  .nav-list a[aria-current="true"] {
    color: var(--fg);
  }

  @media (hover: hover) {
    .nav-list a:hover {
      color: var(--fg);
      background: color-mix(in srgb, var(--fg) 7%, transparent);
    }
  }

  /* Trilho de 100px escalado até a largura do link; o preenchimento é o progresso da seção. */
  .nav-ind {
    position: absolute;
    left: 0;
    bottom: 0.3rem;
    width: 100px;
    height: 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--fg) 14%, transparent);
    transform-origin: left center;
    transform: translateX(var(--ix, 0)) scaleX(var(--iw, 0));
    opacity: 0;
    pointer-events: none;
    transition:
      transform 520ms var(--ease-out),
      opacity 300ms var(--ease-out);
  }

  .nav-ind[data-on="true"] {
    opacity: 1;
  }

  .nav-ind-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--sodio), var(--freio));
    box-shadow: 0 0 8px color-mix(in srgb, var(--sodio) 70%, transparent);
    transform-origin: left center;
    transform: scaleX(var(--sp, 0));
  }

  .menu-foot,
  .menu-trails {
    display: none;
  }

  .header-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  .header-cta {
    margin-left: var(--s-1);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--fg);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      transform 300ms var(--ease-spring);
  }

  .icon-btn:active {
    transform: scale(0.92);
  }

  .icon-btn :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    grid-area: 1 / 1;
    transition: transform 500ms var(--ease-spring);
  }

  @media (hover: hover) {
    .icon-btn:hover {
      background: color-mix(in srgb, var(--fg) 8%, transparent);
    }
    .theme-toggle:hover :global(svg) {
      transform: rotate(-25deg);
    }
  }

  .theme-toggle :global(.i-sun) {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.i-sun) {
    display: block;
  }

  :global(:root[data-theme="dark"]) .theme-toggle :global(.i-moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.i-sun) {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.i-moon) {
      display: none;
    }
  }

  /* Duas linhas que viram um xis. */
  .menu-toggle {
    display: none;
  }

  .burger {
    position: relative;
    width: 1.25rem;
    height: 0.75rem;
  }

  .burger span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.75px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 420ms var(--ease-out),
      top 0s;
  }

  .burger span:first-child {
    top: 0;
  }

  .burger span:last-child {
    top: calc(100% - 1.75px);
  }

  .menu-toggle[aria-expanded="true"] .burger span:first-child {
    transform: translateY(calc(0.375rem - 0.875px)) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .burger span:last-child {
    transform: translateY(calc(-0.375rem + 0.875px)) rotate(-45deg);
  }

  /* Progresso de leitura: só nas páginas sem seções no menu (casos, 404). */
  .header-progress {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--sodio), var(--freio) 60%, var(--mercurio));
    transform-origin: left center;
    transform: scaleX(0);
    opacity: 0.9;
  }

  :global(body:has(#servicos)) .header-progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .header-progress {
      animation: read-progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* ---- Abaixo de 70rem: menu em tela cheia ---- */
  @media (max-width: 69.99rem) {
    .menu-toggle {
      display: inline-grid;
    }

    .header-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      height: 100dvh;
      padding: calc(env(safe-area-inset-top) + 6.5rem) max(var(--gutter), env(safe-area-inset-right))
        calc(env(safe-area-inset-bottom) + 1.5rem) max(var(--gutter), env(safe-area-inset-left));
      background: var(--bg);
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      clip-path: inset(0 0 100% 0);
      transition:
        clip-path 380ms var(--ease-in-out),
        visibility 0s linear 380ms;
      pointer-events: auto;
    }

    .header-nav[data-open="true"] {
      visibility: visible;
      clip-path: inset(0 0 0 0);
      transition:
        clip-path 520ms var(--ease-out),
        visibility 0s;
    }

    .nav-list {
      flex-direction: column;
      gap: 0;
    }

    .nav-list li {
      border-bottom: 1px solid var(--line);
    }

    .nav-list a {
      display: flex;
      align-items: baseline;
      gap: var(--s-4);
      width: 100%;
      min-height: 3.75rem;
      padding: 0.6rem 0;
      border-radius: 0;
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 1.2rem + 3vw, 2.75rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      color: var(--fg);
    }

    .nav-num {
      display: inline;
      font-family: var(--font-text);
      font-size: var(--t-xs);
      font-weight: 700;
      letter-spacing: 0;
      color: var(--sodio);
    }

    .nav-list a[aria-current="true"] .nav-num {
      text-shadow: 0 0 10px var(--sodio);
    }

    .nav-ind {
      display: none;
    }

    .menu-foot {
      display: grid;
      gap: var(--s-4);
      margin-top: auto;
      padding-top: var(--s-7);
    }

    .menu-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--s-3);
    }

    .menu-mail {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      color: var(--fg-2);
      font-size: var(--t-sm);
      overflow-wrap: anywhere;
    }

    .menu-row .theme-toggle {
      border: 1px solid var(--line-2);
    }

    .menu-trails {
      display: block;
      position: absolute;
      right: 0;
      bottom: 0;
      width: min(100%, 28rem);
      height: 16rem;
      pointer-events: none;
      z-index: -1;
    }

    .menu-trails path {
      fill: none;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-dasharray: 1;
    }

    .menu-trails path:first-child {
      stroke: var(--sodio);
    }

    .menu-trails path:last-child {
      stroke: var(--mercurio);
      opacity: 0.7;
    }

    /* Coreografia de abertura: links sobem em sequência e os rastros se desenham. */
    @media (prefers-reduced-motion: no-preference) {
      .header-nav[data-open="true"] .nav-list li {
        animation: menu-item 560ms var(--ease-out) both;
        animation-delay: calc(120ms + var(--i) * 45ms);
      }

      .header-nav[data-open="true"] .menu-foot {
        animation: menu-item 560ms var(--ease-out) 420ms both;
      }

      .header-nav[data-open="true"] .menu-trails path {
        animation: menu-trail 1.4s var(--ease-out) 250ms both;
      }
    }

    .menu-trails path {
      stroke-dashoffset: 0;
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  @keyframes menu-item {
    from {
      opacity: 0;
      translate: 0 22px;
    }
  }

  @keyframes menu-trail {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* Celular: a cápsula leva só a marca e o menu; tema vai para o menu e o CTA para a base. */
  @media (max-width: 39.99rem) {
    .header-theme,
    .header-cta {
      display: none;
    }

    .header-pill {
      padding-left: 0.95rem;
    }
  }
</style>
