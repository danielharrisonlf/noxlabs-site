---
/**
 * Fecho da página: como começa (quatro passos) e o contato, lado a lado, na
 * única faixa escura do site. O e-mail abre com um roteiro; WhatsApp e agenda
 * aparecem sozinhos quando estiverem configurados em src/data/site.ts.
 */
import { steps } from "../data/content";
import { mailScript, site, talkMailto, whatsappHref } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  /** Assunto do e-mail, quando a página pede um contexto (ex.: uma página de caso). */
  topic?: string;
  title?: string;
}

const { topic, title = "Do primeiro e-mail à primeira rotina funcionando" } = Astro.props;
const mailto = topic ? talkMailto(topic) : site.talkMailto;
const whats = whatsappHref();
const subject = topic ? `${site.talkSubject}: ${topic}` : site.talkSubject;
---

<section class="contact dark" id="contato" aria-labelledby="contato-title" data-copy-scope>
  <div class="wrap">
    <h2 id="contato-title" class="contact-title" data-reveal>{title}</h2>

    <div class="contact-grid">
      <ol role="list" class="steps">
        {
          steps.map((step, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="step-n tabular" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>
                  <span class="visually-hidden">Passo {i + 1}: </span>
                  {step.title}
                </h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="start" data-reveal style="--i:1">
        <h3 class="start-title">Comece pelo primeiro passo</h3>
        <p class="start-lede">Escreva em poucas linhas como é a rotina hoje. Eu leio e respondo pessoalmente.</p>
        <div class="start-actions" data-cta-anchor>
          <a class="btn btn-primary btn-block" href={mailto}>
            <Icon name="mail" class="no-nudge" />
            Escrever o e-mail
          </a>
          {
            whats && (
              <a class="btn btn-secondary btn-block" href={whats}>
                <Icon name="phone" class="no-nudge" />
                Chamar no WhatsApp
              </a>
            )
          }
          {
            site.scheduleUrl && (
              <a class="btn btn-secondary btn-block" href={site.scheduleUrl}>
                <Icon name="calendar" class="no-nudge" />
                Escolher horário na agenda
              </a>
            )
          }
          <button class="btn btn-secondary btn-block" type="button" data-copy={site.email} data-copy-done="E-mail copiado">
            <span class="copy-icon"><Icon name="copy" class="no-nudge" /></span>
            <span class="check-icon"><Icon name="check" class="no-nudge" /></span>
            <span data-copy-label>Copiar e-mail</span>
          </button>
        </div>
        <p class="contact-email"><a href={site.mailto}>{site.email}</a></p>
        <p class="contact-status" role="status" aria-live="polite" data-copy-status></p>

        <div class="script">
          <p class="script-h">O e-mail já abre com este roteiro</p>
          <p class="script-subject"><span>Assunto:</span> {subject}</p>
          <ul role="list">
            {mailScript.map((line) => <li>{line}</li>)}
          </ul>
          <p class="script-note">Não precisa de nada pronto. Duas linhas bastam para começar.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 3rem + 5vw, 7.5rem);
  }

  .contact-title {
    max-width: 20ch;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    font-size: var(--t-2xl);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--s-7) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .steps {
    display: grid;
    gap: var(--s-6);
  }

  .steps li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-4);
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.1);
    color: var(--caju);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .steps h3 {
    margin-bottom: var(--s-1);
    font-size: var(--t-lg);
  }

  .steps p {
    color: var(--ink-2);
    max-width: 44ch;
  }

  .start {
    display: grid;
    gap: var(--s-4);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--r-xl);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--line);
  }

  .start-title {
    font-size: var(--t-xl);
  }

  .start-lede {
    color: var(--ink-2);
  }

  .start-actions {
    display: grid;
    gap: var(--s-2);
  }

  .copy-icon,
  .check-icon {
    display: inline-flex;
  }

  .check-icon,
  [data-copied="true"] .copy-icon {
    display: none;
  }

  [data-copied="true"] .check-icon {
    display: inline-flex;
    color: var(--caju);
  }

  .contact-email a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration-color: var(--goiaba);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }

  .contact-status:empty {
    display: none;
  }

  .contact-status {
    font-size: var(--t-sm);
  }

  .script {
    padding-top: var(--s-4);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
  }

  .script-h {
    font-weight: 700;
    margin-bottom: var(--s-2);
  }

  .script-subject {
    color: var(--ink-2);
    margin-bottom: var(--s-2);
  }

  .script-subject span {
    color: var(--ink-3);
  }

  .script li {
    padding-block: 0.4rem;
    border-bottom: 1px dashed var(--line-2);
    color: var(--ink-2);
  }

  .script-note {
    margin-top: var(--s-3);
    color: var(--ink-3);
  }

  @media (max-width: 63.99rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
