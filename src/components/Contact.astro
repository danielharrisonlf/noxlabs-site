---
import { mailScript, site } from "../data/site";
import Icon from "./Icon.astro";

/* Faixa de rastros ao pé do bloco: entram pela esquerda e sobem em direção ao roteiro. */
const trails = [
  { d: "M -20 250 C 360 250, 760 190, 1220 40", tone: "sodio" },
  { d: "M -20 220 C 420 215, 820 150, 1220 60", tone: "mercurio" },
  { d: "M -20 275 C 480 270, 860 210, 1220 90", tone: "freio" },
  { d: "M -20 200 C 300 190, 700 120, 1220 20", tone: "sodio" },
] as const;
---

<section class="contact night grain" id="contato" aria-labelledby="contato-title">
  <svg class="contact-trails" viewBox="0 0 1200 280" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    {
      trails.map((t) => (
        <g class={`tone-${t.tone}`}>
          <path class="ct-glow" d={t.d} />
          <path class="ct-core" d={t.d} />
        </g>
      ))
    }
  </svg>

  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 id="contato-title">Traga o problema. Saia com um próximo passo.</h2>
      <p class="contact-lede">
        Escreva em poucas linhas o que está travando: um processo manual, um sistema lento, uma ideia de produto, uma conta
        de nuvem alta. Eu leio e respondo pessoalmente para marcarmos os 30 minutos.
      </p>

      <div class="contact-actions">
        <a class="btn btn-primary" href={site.diagnosisMailto}>
          Escrever o e-mail
          <Icon name="mail" class="no-nudge" />
        </a>
        {
          site.scheduleUrl && (
            <a class="btn btn-ghost" href={site.scheduleUrl}>
              Escolher horário na agenda
            </a>
          )
        }
        <button class="btn btn-ghost" type="button" data-copy={site.email}>
          <span class="copy-icon"><Icon name="copy" class="no-nudge" /></span>
          <span class="check-icon"><Icon name="check" class="no-nudge" /></span>
          <span data-copy-label>Copiar e-mail</span>
        </button>
      </div>

      <p class="contact-email">
        <a href={site.mailto}>{site.email}</a>
      </p>
      <p class="contact-status" role="status" aria-live="polite" data-copy-status></p>
    </div>

    <aside class="letter" aria-labelledby="letter-title">
      <h3 id="letter-title">O e-mail já abre com este roteiro</h3>
      <p class="letter-subject">
        <span>Assunto</span>
        Diagnóstico de 30 min com a Noxlabs
      </p>
      <ul role="list" class="letter-lines">
        {mailScript.map((line) => <li>{line}</li>)}
      </ul>
      <p class="letter-note">Não precisa de apresentação pronta. Rascunho serve.</p>
    </aside>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const label = button?.querySelector<HTMLElement>("[data-copy-label]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  let timer: number | undefined;

  button?.addEventListener("click", async () => {
    const value = button.dataset.copy ?? "";
    window.clearTimeout(timer);
    try {
      await navigator.clipboard.writeText(value);
      button.dataset.copied = "true";
      if (label) label.textContent = "E-mail copiado";
      if (status) status.textContent = "";
    } catch {
      button.dataset.copied = "false";
      if (status) status.textContent = "O navegador não permitiu copiar. Selecione o endereço acima e copie manualmente.";
    }
    timer = window.setTimeout(() => {
      delete button.dataset.copied;
      if (label) label.textContent = "Copiar e-mail";
    }, 2400);
  });
</script>

<style>
  .contact {
    --band: clamp(7rem, 4rem + 12vw, 15rem);
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 3rem + 7vw, 9rem) calc(var(--band) + 1.5rem);
    background:
      radial-gradient(90% 80% at 75% 40%, var(--haze), transparent 60%),
      radial-gradient(60% 60% at 0% 100%, var(--haze-2), transparent 60%),
      linear-gradient(180deg, var(--sky-low), var(--sky-mid) 45%, var(--sky-top));
    background-color: var(--bg);
  }

  .contact-trails {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: var(--band);
    pointer-events: none;
  }

  .contact-trails path {
    fill: none;
    stroke: var(--c);
    stroke-linecap: round;
  }

  .tone-sodio {
    --c: var(--sodio);
  }
  .tone-freio {
    --c: var(--freio);
  }
  .tone-mercurio {
    --c: var(--mercurio);
  }

  .ct-glow {
    stroke-width: 10;
    opacity: calc(var(--trail-glow) * 0.6);
  }

  .ct-core {
    stroke-width: 1.5;
    opacity: 0.7;
  }

  .contact-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7) clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .contact-copy {
    display: grid;
    gap: var(--s-5);
  }

  .contact h2 {
    font-size: var(--t-display);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 12ch;
  }

  .contact-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--fg-2);
    max-width: 46ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .copy-icon,
  .check-icon {
    display: inline-flex;
  }

  .check-icon,
  [data-copied="true"] .copy-icon {
    display: none;
  }

  [data-copied="true"] .check-icon {
    display: inline-flex;
    color: var(--sodio);
  }

  .contact-email a {
    font-size: var(--t-md);
    font-weight: 700;
    color: var(--fg);
    text-decoration-color: color-mix(in srgb, var(--fg) 40%, transparent);
    overflow-wrap: anywhere;
  }

  .contact-status {
    min-height: 1.5em;
    font-size: var(--t-sm);
  }

  .letter {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg-2);
    box-shadow: var(--shadow-2);
  }

  .letter h3 {
    font-size: var(--t-lg);
    margin-bottom: var(--s-4);
  }

  .letter-subject {
    display: grid;
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid var(--line);
    font-weight: 700;
  }

  .letter-subject span {
    font-size: var(--t-xs);
    font-weight: 400;
    color: var(--fg-3);
  }

  .letter-lines li {
    padding-block: 0.45rem;
    border-bottom: 1px dashed var(--line);
    color: var(--fg-2);
  }

  .letter-note {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    color: var(--fg-3);
  }

  @media (max-width: 63.99rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .letter {
      max-width: 32rem;
    }
  }

  @media (max-width: 40rem) {
    .contact-actions .btn {
      width: 100%;
    }
  }
</style>
