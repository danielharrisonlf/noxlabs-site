---
import { mailScript, site, talkMailto, whatsappHref } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  /** Assunto do e-mail, quando a página pede um contexto (ex.: contabilidade). */
  topic?: string;
  title?: string;
}

const { topic, title = "Conte qual rotina está tomando o tempo da sua equipe." } = Astro.props;
const mailto = topic ? talkMailto(topic) : site.talkMailto;
const whats = whatsappHref();
const subject = topic ? `${site.talkSubject}: ${topic}` : site.talkSubject;
---

<section class="contact band" id="contato" aria-labelledby="contato-title">
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <h2 id="contato-title" data-reveal>{title}</h2>
      <p class="contact-lede" data-reveal style="--i:1">
        Escreva em poucas linhas como é a rotina hoje. Eu leio, respondo pessoalmente e marcamos uma conversa de 30 minutos
        para ver se a automação compensa no seu caso.
      </p>

      <div class="contact-actions" data-reveal style="--i:2" data-cta-anchor>
        <a class="btn btn-primary" href={mailto}>
          <Icon name="mail" class="no-nudge" />
          Escrever o e-mail
        </a>
        {
          site.scheduleUrl && (
            <a class="btn btn-secondary" href={site.scheduleUrl}>
              <Icon name="calendar" class="no-nudge" />
              Escolher horário na agenda
            </a>
          )
        }
        {
          whats && (
            <a class="btn btn-secondary" href={whats}>
              <Icon name="phone" class="no-nudge" />
              Chamar no WhatsApp
            </a>
          )
        }
        <button class="btn btn-secondary" type="button" data-copy={site.email}>
          <span class="copy-icon"><Icon name="copy" class="no-nudge" /></span>
          <span class="check-icon"><Icon name="check" class="no-nudge" /></span>
          <span data-copy-label>Copiar e-mail</span>
        </button>
      </div>

      <p class="contact-email">
        <a href={site.mailto}>{site.email}</a>
      </p>
      <p class="contact-status" role="status" aria-live="polite" data-copy-status></p>
    </div>

    <aside class="letter" aria-labelledby="letter-title" data-reveal style="--i:1">
      <h3 id="letter-title">O e-mail já abre com este roteiro</h3>
      <p class="letter-subject">
        <span>Assunto</span>
        {subject}
      </p>
      <ul role="list" class="letter-lines">
        {mailScript.map((line) => <li>{line}</li>)}
      </ul>
      <p class="letter-note">Não precisa de nada pronto. Duas linhas já bastam para começar.</p>
    </aside>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const label = button?.querySelector<HTMLElement>("[data-copy-label]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  let timer: number | undefined;

  button?.addEventListener("click", async () => {
    const value = button.dataset.copy ?? "";
    window.clearTimeout(timer);
    try {
      await navigator.clipboard.writeText(value);
      button.dataset.copied = "true";
      if (label) label.textContent = "E-mail copiado";
      if (status) status.textContent = "";
    } catch {
      button.dataset.copied = "false";
      if (status) status.textContent = "O navegador não permitiu copiar. Selecione o endereço acima e copie manualmente.";
    }
    timer = window.setTimeout(() => {
      delete button.dataset.copied;
      if (label) label.textContent = "Copiar e-mail";
    }, 2400);
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
  }

  /* Papel quadriculado claro no canto, a mesma folha do topo da página. */
  .contact::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(60% 80% at 90% 20%, #000, transparent 70%);
    pointer-events: none;
  }

  .contact-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7) clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .contact-copy {
    display: grid;
    gap: var(--s-5);
  }

  .contact h2 {
    font-size: var(--t-2xl);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.022em;
    max-width: 18ch;
  }

  .contact-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 48ch;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .copy-icon,
  .check-icon {
    display: inline-flex;
  }

  .check-icon,
  [data-copied="true"] .copy-icon {
    display: none;
  }

  [data-copied="true"] .check-icon {
    display: inline-flex;
    color: var(--marca);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-copied="true"] .check-icon :global(path) {
      stroke-dasharray: 22;
      animation: check-draw 380ms var(--ease-out) both;
    }

    [data-copied="true"] [data-copy-label] {
      display: inline-block;
      animation: copy-label 300ms var(--ease-out);
    }
  }

  @keyframes check-draw {
    from {
      stroke-dashoffset: 22;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes copy-label {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  .contact-email a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--t-md);
    font-weight: 700;
    color: var(--ink);
    text-decoration-color: var(--marca);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }

  .contact-status {
    min-height: 1.5em;
    font-size: var(--t-sm);
  }

  /* O roteiro do e-mail, como uma folha branca sobre a mesa verde. */
  .letter {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: var(--r-lg);
    background: #ffffff;
    color: #0f2a22;
    box-shadow: 0 30px 60px -28px rgb(0 0 0 / 0.6);
    rotate: -1.2deg;
  }

  .letter h3 {
    font-size: var(--t-lg);
    margin-bottom: var(--s-4);
  }

  .letter-subject {
    display: grid;
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-3);
    border-bottom: 1px solid #d6e0d7;
    font-weight: 700;
  }

  .letter-subject span {
    font-size: var(--t-xs);
    font-weight: 500;
    color: #52665d;
  }

  .letter-lines li {
    padding-block: 0.45rem;
    border-bottom: 1px dashed #d6e0d7;
    color: #3a5047;
  }

  .letter-note {
    margin-top: var(--s-4);
    font-size: var(--t-sm);
    color: #52665d;
  }

  @media (max-width: 63.99rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .letter {
      max-width: 32rem;
      rotate: none;
    }
  }

  @media (max-width: 40rem) {
    .contact-actions .btn {
      width: 100%;
    }
  }
</style>
