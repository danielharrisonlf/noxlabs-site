---
import { clinicflow, moreCases, srcset, whatsapp } from "../data/cases";
import Icon from "./Icon.astro";

const pair = [clinicflow, whatsapp];
/* Os quatro primeiros ficam à vista; os outros, a um clique. */
const shown = moreCases.slice(0, 4);
const folded = moreCases.slice(4);
---

<section class="section cases" id="casos" aria-labelledby="casos-title">
  <div class="wrap">
    <div class="pair">
      <header class="cases-head" data-reveal="head">
        <h2 id="casos-title" class="section-title">Casos que você pode abrir.</h2>
        <p class="section-lede">
          Sem logo de cliente nem depoimento inventado. São sistemas que construí, com código aberto sempre que possível e
          resultado descrito como ele é.
        </p>
      </header>

      {
        pair.map((c, i) => (
          <article
            class:list={["case", `case-${i + 1}`]}
            aria-labelledby={`${c.slug}-title`}
            data-reveal="tilt"
            style={`--i:${i}`}
          >
            {c.image && (
              <a class="case-frame" href={`/casos/${c.slug}/`} tabindex="-1" aria-hidden="true" data-tilt>
                <img
                  src={c.image.src}
                  srcset={srcset(c.image.src, c.image.width)}
                  sizes="(min-width: 64rem) 46vw, 92vw"
                  width={c.image.width}
                  height={c.image.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  style={`view-transition-name: shot-${c.slug}`}
                />
                <span class="case-glare" aria-hidden="true"></span>
              </a>
            )}
            <div class="case-meta">
              <h3 id={`${c.slug}-title`}>
                <a href={`/casos/${c.slug}/`} style={`view-transition-name: title-${c.slug}`}>
                  {c.name}
                </a>
              </h3>
              <p class="case-summary">{c.summary}</p>
              <p class="case-proves">Serviço relacionado: {c.proves}</p>
              <a class="text-link" href={`/casos/${c.slug}/`} aria-label={`Ler o caso ${c.name}`}>
                Ler o caso
                <Icon name="arrow-right" />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="more">
      <h3 class="more-title">Também construí</h3>
      <ul class="more-list" role="list">
        {
          shown.map((c, i) => (
            <li class="more-item" data-reveal style={`--i:${i % 2}`}>
              <div class="more-top">
                <p class="more-name">{c.name}</p>
                <p class:list={["more-vis", c.visibility === "público" ? "is-public" : "is-private"]}>
                  {c.visibility === "público" ? "Código público" : "Código privado"}
                </p>
              </div>
              <p class="more-summary">{c.summary}</p>
              <div class="more-foot">
                <p class="more-stack">{c.stack}</p>
                {c.link && (
                  <a class="text-link" href={c.link.href} aria-label={`${c.link.label} de ${c.name}`}>
                    {c.link.label}
                    <Icon name="arrow-up-right" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      {
        folded.length > 0 && (
          <details class="more-fold">
            <summary>
              <span class="fold-open">Ver os outros {folded.length}</span>
              <span class="fold-close">Mostrar menos</span>
              <Icon name="plus" class="fold-icon" />
            </summary>
            <ul class="more-list" role="list">
              {folded.map((c) => (
                <li class="more-item">
                  <div class="more-top">
                    <p class="more-name">{c.name}</p>
                    <p class:list={["more-vis", c.visibility === "público" ? "is-public" : "is-private"]}>
                      {c.visibility === "público" ? "Código público" : "Código privado"}
                    </p>
                  </div>
                  <p class="more-summary">{c.summary}</p>
                  <div class="more-foot">
                    <p class="more-stack">{c.stack}</p>
                    {c.link && (
                      <a class="text-link" href={c.link.href} aria-label={`${c.link.label} de ${c.name}`}>
                        {c.link.label}
                        <Icon name="arrow-up-right" />
                      </a>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </div>
  </div>
</section>

<script>
  import { finePointer, reducedMotion } from "../scripts/motion";

  // Moldura inclina levemente para o ponteiro e um reflexo segue o cursor (desktop).
  if (finePointer() && !reducedMotion()) {
    for (const frame of document.querySelectorAll<HTMLElement>("[data-tilt]")) {
      let raf = 0;
      let rx = 0;
      let ry = 0;
      let gx = 50;
      let gy = 50;
      const apply = () => {
        raf = 0;
        frame.style.setProperty("--rx", `${rx}deg`);
        frame.style.setProperty("--ry", `${ry}deg`);
        frame.style.setProperty("--gx", `${gx}%`);
        frame.style.setProperty("--gy", `${gy}%`);
      };
      frame.addEventListener("pointermove", (e) => {
        const r = frame.getBoundingClientRect();
        const u = (e.clientX - r.left) / r.width;
        const v = (e.clientY - r.top) / r.height;
        ry = (u - 0.5) * 7;
        rx = (0.5 - v) * 5;
        gx = u * 100;
        gy = v * 100;
        frame.dataset.hot = "true";
        if (!raf) raf = requestAnimationFrame(apply);
      });
      frame.addEventListener("pointerleave", () => {
        rx = 0;
        ry = 0;
        delete frame.dataset.hot;
        if (!raf) raf = requestAnimationFrame(apply);
      });
    }
  }
</script>

<style>
  /*
   * Duas colunas desencontradas: o primeiro caso sobe até o topo da seção à
   * esquerda; o título ocupa o vão acima do segundo, à direita.
   */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "one head"
      "one two";
    grid-template-rows: auto 1fr;
    gap: clamp(2.5rem, 4vw, 4rem) clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .cases-head {
    grid-area: head;
    align-self: end;
  }

  .case-1 {
    grid-area: one;
  }

  .case-2 {
    grid-area: two;
  }

  .case-frame {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: block;
    padding: clamp(0.75rem, 1.5vw, 1.25rem) clamp(0.75rem, 1.5vw, 1.25rem) 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--bg-3);
    box-shadow: var(--shadow-2);
    transform: perspective(1100px) rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 600ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }

  .case-frame[data-hot="true"] {
    transition:
      transform 140ms linear,
      box-shadow 500ms var(--ease-out);
  }

  .case-glare {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      40% 50% at var(--gx, 50%) var(--gy, 50%),
      rgb(255 255 255 / 0.22),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }

  .case-frame[data-hot="true"] .case-glare {
    opacity: 1;
  }

  .case-frame img {
    width: 100%;
    height: auto;
    border-radius: var(--r-sm) var(--r-sm) 0 0;
    box-shadow: 0 -1px 0 var(--line), 0 20px 40px -20px rgb(0 0 0 / 0.4);
    transition: transform 700ms var(--ease-out);
  }

  /* Faixa de luz que atravessa a moldura no hover. */
  .case-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .case:hover .case-frame {
      box-shadow:
        0 2px 6px rgb(17 26 69 / 0.08),
        0 44px 80px -34px rgb(17 26 69 / 0.45);
    }
    .case:hover .case-frame img {
      transform: scale(1.02);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .case:hover .case-frame::after {
      transform: translateX(100%);
      transition: transform 900ms var(--ease-out);
    }
  }

  .case-meta {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-5);
    max-width: 46ch;
  }

  .case-meta h3 {
    font-size: var(--t-xl);
  }

  .case-meta h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 400ms var(--ease-out);
  }

  @media (hover: hover) {
    .case:hover h3 a {
      background-size: 100% 2px;
    }
  }

  .case-summary {
    color: var(--fg-2);
  }

  .case-proves {
    font-size: var(--t-sm);
    color: var(--fg-3);
  }

  .more {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .more-title {
    font-size: var(--t-xl);
    margin-bottom: var(--s-5);
  }

  .more-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
  }

  .more-item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-block: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .more-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
  }

  .more-name {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .more-vis {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--fg-3);
  }

  .more-vis::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .more-vis.is-public::before {
    background: var(--mercurio);
    border-color: var(--mercurio);
  }

  .more-summary {
    color: var(--fg-2);
    max-width: 52ch;
  }

  .more-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--s-4);
    font-size: var(--t-sm);
  }

  .more-stack {
    color: var(--fg-3);
  }

  .more-fold summary {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 3rem;
    margin-top: var(--s-3);
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-pill);
    font-size: var(--t-sm);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    transition:
      border-color 200ms var(--ease-out),
      background-color 200ms var(--ease-out);
  }

  .more-fold summary::-webkit-details-marker {
    display: none;
  }

  .more-fold :global(.fold-icon) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--sodio);
    transition: transform 400ms var(--ease-spring);
  }

  .fold-close,
  .more-fold[open] .fold-open {
    display: none;
  }

  .more-fold[open] .fold-close {
    display: inline;
  }

  .more-fold[open] :global(.fold-icon) {
    transform: rotate(45deg);
  }

  .more-fold[open] summary {
    margin-bottom: var(--s-4);
  }

  @media (hover: hover) {
    .more-fold summary:hover {
      border-color: var(--fg);
      background: var(--bg-2);
    }
  }

  @media (max-width: 63.99rem) {
    .pair {
      grid-template-columns: 1fr;
      grid-template-areas:
        "head"
        "one"
        "two";
      grid-template-rows: auto;
    }

  }

  @media (max-width: 47.99rem) {
    .more-list {
      grid-template-columns: 1fr;
    }
  }
</style>
