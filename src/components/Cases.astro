---
import { clinicflow, moreCases, whatsapp } from "../data/cases";
import Icon from "./Icon.astro";

const pair = [clinicflow, whatsapp];
---

<section class="section cases" id="casos" aria-labelledby="casos-title">
  <div class="wrap">
    <header class="cases-head">
      <h2 id="casos-title" class="section-title">Mais trabalho para abrir e conferir.</h2>
      <p class="section-lede">
        Sem logo de cliente nem depoimento inventado. São sistemas que construí, com código aberto sempre que possível e
        resultado descrito como ele é.
      </p>
    </header>

    <div class="pair">
      {
        pair.map((c) => (
          <article class="case" aria-labelledby={`${c.slug}-title`}>
            {c.image && (
              <a class="case-frame" href={`/casos/${c.slug}/`} tabindex="-1" aria-hidden="true">
                <img
                  src={c.image.src}
                  width={c.image.width}
                  height={c.image.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  style={`view-transition-name: shot-${c.slug}`}
                />
              </a>
            )}
            <div class="case-meta">
              <h3 id={`${c.slug}-title`}>
                <a href={`/casos/${c.slug}/`}>{c.name}</a>
              </h3>
              <p class="case-summary">{c.summary}</p>
              <p class="case-proves">Serviço relacionado: {c.proves}</p>
              <a class="text-link" href={`/casos/${c.slug}/`} aria-label={`Ler o caso ${c.name}`}>
                Ler o caso
                <Icon name="arrow-right" />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="more">
      <h3 class="more-title">Também construí</h3>
      <ul class="more-list" role="list">
        {
          moreCases.map((c) => (
            <li class="more-item">
              <div class="more-top">
                <p class="more-name">{c.name}</p>
                <p class:list={["more-vis", c.visibility === "público" ? "is-public" : "is-private"]}>
                  {c.visibility === "público" ? "Código público" : "Código privado"}
                </p>
              </div>
              <p class="more-summary">{c.summary}</p>
              <div class="more-foot">
                <p class="more-stack">{c.stack}</p>
                {c.link && (
                  <a class="text-link" href={c.link.href} aria-label={`${c.link.label} de ${c.name}`}>
                    {c.link.label}
                    <Icon name="arrow-up-right" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cases-head {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 5vw, 5rem) clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .case:nth-child(2) {
    margin-top: clamp(4rem, 12vw, 10rem);
  }

  .case-frame {
    position: relative;
    display: block;
    padding: clamp(0.75rem, 1.5vw, 1.25rem) clamp(0.75rem, 1.5vw, 1.25rem) 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background:
      radial-gradient(90% 80% at 0% 100%, var(--haze), transparent 60%),
      linear-gradient(160deg, var(--sky-top), var(--sky-low));
    box-shadow: var(--shadow-2);
    transition:
      transform 500ms var(--ease-spring),
      box-shadow 500ms var(--ease-out);
  }

  .case-frame img {
    width: 100%;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    object-position: top left;
    border-radius: var(--r-sm) var(--r-sm) 0 0;
    box-shadow: 0 -1px 0 var(--line), 0 20px 40px -20px rgb(0 0 0 / 0.4);
    transition: transform 700ms var(--ease-out);
  }

  .case:nth-child(2) .case-frame img {
    aspect-ratio: 4 / 3.4;
  }

  /* Faixa de luz que atravessa a moldura no hover. */
  .case-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
    transform: translateX(-100%);
    pointer-events: none;
  }

  @media (hover: hover) {
    .case:hover .case-frame {
      transform: translateY(-6px);
    }
    .case:hover .case-frame img {
      transform: scale(1.025);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .case:hover .case-frame::after {
      transform: translateX(100%);
      transition: transform 900ms var(--ease-out);
    }
  }

  .case-meta {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-5);
    max-width: 46ch;
  }

  .case-meta h3 {
    font-size: var(--t-xl);
  }

  .case-meta h3 a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 400ms var(--ease-out);
  }

  @media (hover: hover) {
    .case:hover h3 a {
      background-size: 100% 2px;
    }
  }

  .case-summary {
    color: var(--fg-2);
  }

  .case-proves {
    font-size: var(--t-sm);
    color: var(--fg-3);
  }

  .more {
    margin-top: clamp(5rem, 10vw, 9rem);
  }

  .more-title {
    font-size: var(--t-xl);
    margin-bottom: var(--s-6);
  }

  .more-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 4rem);
  }

  .more-item {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-block: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .more-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
  }

  .more-name {
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .more-vis {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--t-xs);
    font-weight: 700;
    color: var(--fg-3);
  }

  .more-vis::before {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }

  .more-vis.is-public::before {
    background: var(--mercurio);
    border-color: var(--mercurio);
  }

  .more-summary {
    color: var(--fg-2);
    max-width: 52ch;
  }

  .more-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 var(--s-4);
    font-size: var(--t-sm);
  }

  .more-stack {
    color: var(--fg-3);
  }

  @media (max-width: 63.99rem) {
    .pair,
    .more-list {
      grid-template-columns: 1fr;
    }

    .case:nth-child(2) {
      margin-top: 0;
    }
  }
</style>
