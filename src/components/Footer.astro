---
import { site } from "../data/site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

const groups = [
  {
    title: "O que eu faço",
    links: [
      { label: "Automação de rotinas", href: "/#solucoes" },
      { label: "Atendimento e WhatsApp com IA", href: "/#solucoes" },
      { label: "Sistemas sob medida", href: "/#solucoes" },
      { label: "Painéis e integrações", href: "/#solucoes" },
    ],
  },
  {
    title: "Para conhecer",
    links: [
      { label: "Exemplos por ramo", href: "/#na-sua-empresa" },
      { label: "Projetos", href: "/#casos" },
      { label: "A conta da sua equipe", href: "/#estimativa" },
      { label: "Perguntas", href: "/#perguntas" },
    ],
  },
  {
    title: "Contato",
    links: [
      { label: site.email, href: site.mailto },
      { label: "LinkedIn", href: site.links.linkedin },
      { label: "Blog", href: site.links.blog },
      { label: "Portfólio do Daniel", href: site.links.portfolio },
    ],
  },
];
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Logo />
      <p>Automações, atendimento pelo WhatsApp com IA e sistemas sob medida para pequenas e médias empresas de qualquer ramo.</p>
    </div>
    {
      groups.map((group) => (
        <nav class="footer-group" aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul role="list">
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <p class="footer-legal">
      © {year} Noxlabs. Este site não usa cookies nem rastreadores. Os números de mercado citados são de terceiros, com a fonte
      ao lado de cada um.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 5.5rem) var(--s-6);
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-7) var(--s-6);
  }

  .footer-brand {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .footer-brand p {
    color: var(--ink-2);
    max-width: 32ch;
  }

  .footer-group h2 {
    margin-bottom: var(--s-2);
    font-family: var(--font-body);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0;
  }

  .footer-group li a {
    display: inline-flex;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--d-fast) var(--ease-out);
  }

  @media (hover: hover) {
    .footer-group li a:hover {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: var(--goiaba);
      text-decoration-thickness: 3px;
    }
  }

  .footer-legal {
    grid-column: 1 / -1;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--t-xs);
  }

  @media (max-width: 60rem) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
