---
import { site } from "../data/site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();

const groups = [
  {
    title: "Noxlabs",
    links: [
      { label: "Serviços", href: "/#servicos" },
      { label: "Kairos", href: "/#kairos" },
      { label: "Casos", href: "/#casos" },
      { label: "Processo", href: "/#processo" },
      { label: "Perguntas", href: "/#perguntas" },
    ],
  },
  {
    title: "Produtos e escrita",
    links: [
      { label: "Kairos", href: site.links.kairos },
      { label: "Blog", href: site.links.blog },
      { label: "Portfólio do Daniel", href: site.links.portfolio },
    ],
  },
  {
    title: "Contato",
    links: [
      { label: site.email, href: site.mailto },
      { label: "GitHub", href: site.links.github },
      { label: "LinkedIn", href: site.links.linkedin },
    ],
  },
];
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Logo id="lg-f" />
      <p>Software e IA aplicada, do diagnóstico à operação.</p>
    </div>
    {
      groups.map((group) => (
        <nav class="footer-group" aria-label={group.title}>
          <h2>{group.title}</h2>
          <ul role="list">
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
    <p class="footer-legal">© {year} Noxlabs. Site estático, sem rastreadores nem cookies.</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) var(--s-6);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-7) var(--s-6);
  }

  .footer-brand {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .footer-brand p {
    color: var(--fg-2);
    max-width: 28ch;
  }

  .footer-group h2 {
    margin-bottom: var(--s-3);
    font-family: var(--font-text);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0;
  }

  .footer-group li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--fg-2);
    font-size: var(--t-sm);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 200ms var(--ease-out);
  }

  @media (hover: hover) {
    .footer-group li a:hover {
      color: var(--fg);
      text-decoration: underline;
      text-decoration-color: var(--sodio);
      text-decoration-thickness: 2px;
    }
  }

  .footer-legal {
    grid-column: 1 / -1;
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
    color: var(--fg-3);
    font-size: var(--t-xs);
  }

  @media (max-width: 60rem) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand,
    .footer-group:last-of-type {
      grid-column: 1 / -1;
    }
  }
</style>
