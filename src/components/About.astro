---
import { site } from "../data/site";
import Icon from "./Icon.astro";

const ways = [
  { title: "Você fala com quem constrói", text: "Sem gerente de conta no meio. A pessoa da conversa inicial é a que entrega." },
  { title: "Português claro, por escrito", text: "Proposta, andamento e decisões em texto simples, que o sócio entende sem tradução." },
  { title: "Honesto sobre limites", text: "Se a automação não compensa ou não é a pessoa certa para o problema, você ouve isso cedo." },
];
---

<section class="section about" id="sobre" aria-labelledby="sobre-title">
  <div class="wrap about-grid">
    <figure class="portrait" data-reveal>
      <img
        src="/img/daniel-harrison.webp"
        width="360"
        height="360"
        alt="Daniel Harrison, de camiseta preta, diante de uma parede vermelha."
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <strong>Daniel Harrison</strong>
        <span>Fundador da Noxlabs</span>
      </figcaption>
    </figure>

    <div class="about-copy" data-reveal style="--i:1">
      <h2 id="sobre-title" class="section-title">Quem cuida da sua rotina</h2>
      <p class="about-lede">
        Eu sou o Daniel Harrison, e a Noxlabs é o meu trabalho. Quem conversa com você é quem entende a rotina e constrói a
        solução; depois que ela entra em uso, você decide se eu continuo cuidando.
      </p>
      <p>
        Antes da Noxlabs, construí sistemas para empresas de engenharia, controle de acesso e locação de equipamentos: um
        portal de suporte com fila e controle de prazos, avisos automáticos por WhatsApp e Telegram, integração com catracas e
        leitores biométricos, câmeras de obra acompanhadas a distância.
      </p>
      <p>
        Hoje o foco é tirar trabalho repetitivo das empresas com automação e assistentes de IA que seguem as regras de cada
        negócio, com registro do que fazem e revisão humana onde importa.
      </p>

      <ul role="list" class="ways">
        {
          ways.map((w) => (
            <li>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>

      <p class="about-links">
        <a class="text-link" href={site.links.linkedin}>
          LinkedIn
          <Icon name="arrow-up-right" />
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .portrait {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: var(--s-4);
    max-width: 22rem;
  }

  .portrait img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-2);
    /* Etiqueta de marca-texto atrás da foto: um toque de papel colado. */
    outline: 10px solid var(--surface);
  }

  .portrait figcaption {
    display: grid;
    padding-left: var(--s-2);
  }

  .portrait figcaption span {
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .about-copy {
    display: grid;
    gap: var(--s-4);
  }

  .about-copy > p {
    color: var(--ink-2);
    max-width: 60ch;
  }

  .about-copy > .about-lede {
    font-size: var(--t-md);
    line-height: 1.5;
    color: var(--ink);
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }

  .ways h3 {
    font-size: var(--t-base);
    font-family: var(--font-text);
    font-weight: 700;
    letter-spacing: 0;
    margin-bottom: var(--s-1);
  }

  .ways p {
    font-size: var(--t-sm);
    color: var(--ink-2);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }

  @media (max-width: 52rem) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      position: static;
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: center;
      max-width: none;
    }

    .portrait img {
      outline-width: 6px;
      border-radius: var(--r-lg);
    }

    .ways {
      grid-template-columns: 1fr;
    }
  }
</style>
