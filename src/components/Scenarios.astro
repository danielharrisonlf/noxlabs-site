---
/**
 * "Como funcionaria na sua empresa": seis ramos com o mesmo peso, cada um
 * com uma conversa de exemplo no celular, o antes, o depois e o ganho.
 * Com JS vira um seletor de abas (chips que rolam de lado no celular);
 * sem JS, os seis cenários aparecem um embaixo do outro.
 */
import { scenarios } from "../data/sectors";
import { talkMailto } from "../data/site";
import Icon from "./Icon.astro";
import Ill from "./Ill.astro";

const first = scenarios[0].id;
---

<section class="section scen" id="na-sua-empresa" aria-labelledby="scen-title">
  <div class="wrap">
    <header class="section-head split" data-reveal>
      <h2 id="scen-title" class="section-title">Como funcionaria na sua empresa</h2>
      <p class="section-lede">
        Escolha o ramo mais parecido com o seu. O antes é o de muita empresa; o depois é o que dá para montar, começando pelo
        que você já usa.
      </p>
    </header>

    <div class="scen-box" data-scenarios>
      <div class="scen-tabs" role="tablist" aria-label="Escolha um ramo" data-scen-tabs>
        {
          scenarios.map((s) => (
            <button
              type="button"
              role="tab"
              class="scen-tab"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
              aria-selected={s.id === first ? "true" : "false"}
              tabindex={s.id === first ? 0 : -1}
              data-scen-tab={s.id}
            >
              <span class:list={["tile", `tile-${s.tone}`, "scen-tab-ill"]}>
                <Ill name={s.ill} />
              </span>
              {s.label}
            </button>
          ))
        }
      </div>

      {
        scenarios.map((s) => (
          <article
            class="scen-panel"
            role="tabpanel"
            id={`panel-${s.id}`}
            aria-labelledby={`tab-${s.id}`}
            data-scen-panel={s.id}
            data-active={s.id === first ? "true" : "false"}
          >
            <div class="phone" aria-label={`Conversa de exemplo: ${s.chatName}`} role="group">
              <div class="phone-screen">
                <p class="phone-head">
                  <span class:list={["tile", `tile-${s.tone}`, "phone-av"]}>
                    <Ill name={s.ill} />
                  </span>
                  <span>
                    {s.chatName}
                    <small>{s.chatRole}</small>
                  </span>
                </p>
                <div class="phone-msgs">
                  {s.chat.map((line) =>
                    line.from === "note" ? (
                      <p class="handoff">{line.text}</p>
                    ) : (
                      <p class:list={["bubble", line.from === "client" ? "in" : "out", { team: line.from === "team" }]}>
                        {line.text}
                        {"who" in line && line.who && <small>{line.who}</small>}
                      </p>
                    ),
                  )}
                </div>
              </div>
            </div>

            <div class="scen-copy">
              <h3 class="scen-name">{s.label}</h3>
              <div class="scen-cols">
                <div class="scen-today">
                  <h4>Hoje</h4>
                  <ul role="list">
                    {s.today.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
                <div class="scen-then">
                  <h4>Com a Noxlabs</h4>
                  <ul role="list" class="checks">
                    {s.then.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <p class="scen-gain">
                <span>O que você ganha</span>
                {s.gain}
              </p>
              <a class="text-link" href={talkMailto(`Como funcionaria no meu ramo (${s.label.toLowerCase()})`)}>
                Quero ver isso na minha empresa
                <Icon name="arrow-right" />
              </a>
            </div>
          </article>
        ))
      }
      <p class="example-note scen-note">Conversas de exemplo, com nomes fictícios. Não são casos de clientes.</p>
    </div>
  </div>
</section>

<script>
  const box = document.querySelector<HTMLElement>("[data-scenarios]");
  if (box) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-scen-tab]")];
    const panels = [...box.querySelectorAll<HTMLElement>("[data-scen-panel]")];
    box.dataset.enhanced = "true";

    const select = (id: string, focus = false) => {
      for (const t of tabs) {
        const on = t.dataset.scenTab === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on) {
          if (focus) t.focus();
          // O chip escolhido fica visível na faixa que rola de lado, sem mexer na página.
          const strip = t.parentElement;
          if (strip) {
            const left = t.offsetLeft - (strip.clientWidth - t.offsetWidth) / 2;
            strip.scrollTo({ left, behavior: "smooth" });
          }
        }
      }
      for (const p of panels) p.dataset.active = String(p.dataset.scenPanel === id);
    };

    for (const t of tabs) {
      t.addEventListener("click", () => select(t.dataset.scenTab ?? ""));
      t.addEventListener("keydown", (event) => {
        const i = tabs.indexOf(t);
        let next = -1;
        if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        if (next < 0) return;
        event.preventDefault();
        select(tabs[next].dataset.scenTab ?? "", true);
      });
    }
  }
</script>

<style>
  .scen {
    background: var(--tint);
  }

  /* ---- Abas: chips com o azulejo do ramo ---- */
  .scen-tabs {
    display: none;
    gap: var(--s-2);
    margin-bottom: var(--s-5);
  }

  .scen-box[data-enhanced="true"] .scen-tabs {
    display: flex;
    flex-wrap: wrap;
  }

  .scen-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0.3rem 1.1rem 0.3rem 0.35rem;
    border: 1px solid var(--line-2);
    border-radius: 16px;
    background: var(--surface);
    color: var(--ink);
    font-size: var(--t-sm);
    font-weight: 650;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--d-fast) var(--ease-out),
      color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out);
  }

  .scen-tab-ill {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.3rem;
    border-radius: 11px;
  }

  .scen-tab[aria-selected="true"] {
    background: var(--jabu);
    border-color: var(--jabu);
    color: #fff;
  }

  @media (hover: hover) {
    .scen-tab[aria-selected="false"]:hover {
      border-color: var(--ink);
    }
  }

  /* ---- Painel ---- */
  .scen-panel {
    display: grid;
    grid-template-columns: minmax(17rem, 22rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: start;
    padding: clamp(1rem, 0.6rem + 1.5vw, 2rem);
    border-radius: var(--r-xl);
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .scen-panel + .scen-panel {
    margin-top: var(--s-4);
  }

  .scen-box[data-enhanced="true"] .scen-panel + .scen-panel {
    margin-top: 0;
  }

  .scen-box[data-enhanced="true"] .scen-panel[data-active="false"] {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scen-box[data-enhanced="true"] .scen-panel[data-active="true"] .phone {
      animation: scen-in 420ms var(--ease-out) both;
    }

    .scen-box[data-enhanced="true"] .scen-panel[data-active="true"] .scen-copy {
      animation: scen-in 420ms var(--ease-out) 60ms both;
    }

    .scen-box[data-enhanced="true"] .scen-panel[data-active="true"] .phone-msgs > * {
      animation: scen-in 360ms var(--ease-out) both;
    }

    .phone-msgs > :nth-child(2) {
      animation-delay: 120ms !important;
    }

    .phone-msgs > :nth-child(3) {
      animation-delay: 240ms !important;
    }

    .phone-msgs > :nth-child(4) {
      animation-delay: 360ms !important;
    }

    .phone-msgs > :nth-child(5) {
      animation-delay: 480ms !important;
    }
  }

  @keyframes scen-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* ---- Celular de exemplo ---- */
  .phone {
    padding: 0.6rem;
    border-radius: 2.4rem;
    background: var(--jabu);
    box-shadow: var(--shadow-3);
  }

  .phone-screen {
    overflow: hidden;
    border-radius: 1.9rem;
    background: #f6eef6;
  }

  .phone-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    background: #fff;
    border-bottom: 1px solid var(--line);
    font-size: var(--t-sm);
    font-weight: 700;
    line-height: 1.2;
  }

  .phone-head small {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-3);
  }

  .phone-av {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.25rem;
    border-radius: 50%;
  }

  .phone-msgs {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    min-height: 24rem;
    padding: 1rem 0.85rem 1.25rem;
  }

  .bubble.team {
    background: var(--lila);
  }

  /* ---- Texto ---- */
  .scen-copy {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-3);
  }

  .scen-name {
    font-size: var(--t-xl);
  }

  .scen-box[data-enhanced="true"] .scen-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .scen-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  h4 {
    margin-bottom: var(--s-3);
    font-size: var(--t-md);
  }

  .scen-today h4 {
    color: var(--ink-3);
  }

  .scen-today ul {
    display: grid;
    gap: 0.7rem;
  }

  .scen-today li {
    position: relative;
    padding-left: 2rem;
    color: var(--ink-2);
  }

  .scen-today li::before {
    content: "";
    position: absolute;
    left: 0.2rem;
    top: 0.35em;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2px solid var(--line-2);
  }

  .scen-gain {
    display: grid;
    gap: 0.25rem;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-md);
    background: var(--goiaba-soft);
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .scen-gain span {
    font-family: var(--font-body);
    font-size: var(--t-xs);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--goiaba-ink);
  }

  .scen-note {
    margin-top: var(--s-3);
  }

  @media (max-width: 63.99rem) {
    .scen-cols {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 47.99rem) {
    /* Chips numa linha que rola de lado, com o próximo cortado na borda. */
    .scen-box[data-enhanced="true"] .scen-tabs {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * max(var(--gutter), env(safe-area-inset-left)));
      padding: 0.25rem max(var(--gutter), env(safe-area-inset-left)) 0.5rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding-inline: max(var(--gutter), env(safe-area-inset-left));
      scrollbar-width: none;
    }

    .scen-tabs::-webkit-scrollbar {
      display: none;
    }

    .scen-tab {
      scroll-snap-align: start;
      flex: none;
    }

    .scen-panel {
      grid-template-columns: 1fr;
      padding: 0.75rem;
      border-radius: var(--r-lg);
    }

    .phone {
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }

    .phone-msgs {
      min-height: 0;
    }

    .scen-copy {
      padding: 0 0.5rem 0.75rem;
    }
  }
</style>
