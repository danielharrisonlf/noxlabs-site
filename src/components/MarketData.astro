---
/**
 * Números do mercado, cada um com fonte e ano. Nenhum é resultado da Noxlabs.
 * Uma lista ao lado do título, separada por linhas: o número lidera a frase,
 * a fonte fica logo embaixo.
 */
import { statById } from "../data/stats";
import Stat from "./Stat.astro";

interface Props {
  ids: string[];
  title: string;
  lede: string;
  id?: string;
}

const { ids, title, lede, id = "numeros" } = Astro.props;
const items = ids.map(statById).filter((s) => s !== undefined);
---

{
  items.length > 0 && (
    <section class="section market" id={id} aria-labelledby={`${id}-title`}>
      <div class="wrap market-grid">
        <header class="market-head" data-reveal>
          <h2 id={`${id}-title`} class="section-title">
            {title}
          </h2>
          <p class="section-lede">{lede}</p>
        </header>
        <div class="market-list">
          {items.map((s, i) => (
            <Stat stat={s} index={i} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .market {
    background: var(--surface);
  }

  .market-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-6) clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .market-head {
    display: grid;
    gap: var(--s-4);
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .market-list {
    display: grid;
    border-top: 1px solid var(--line-2);
  }

  @media (max-width: 56rem) {
    .market-grid {
      grid-template-columns: 1fr;
    }

    .market-head {
      position: static;
    }
  }
</style>
