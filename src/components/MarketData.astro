---
/** Números do mercado, cada um com fonte e ano. Nenhum é resultado da Noxlabs. */
import { statById } from "../data/stats";
import Stat from "./Stat.astro";

interface Props {
  ids: string[];
  title: string;
  lede: string;
  id?: string;
}

const { ids, title, lede, id = "numeros" } = Astro.props;
const items = ids.map(statById).filter((s) => s !== undefined);
const tones = ["lila", "goiaba", "caju", "white"] as const;
// A grade tem quatro colunas no desktop e duas no tablet: use 4 dados para ela fechar sem buraco.
---

{
  items.length > 0 && (
    <section class="section market" id={id} aria-labelledby={`${id}-title`}>
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 id={`${id}-title`} class="section-title">
            {title}
          </h2>
          <p class="section-lede">{lede}</p>
        </header>
        <div class="market-grid">
          {items.map((s, i) => (
            <Stat stat={s} index={i} tone={tones[i % tones.length]} />
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .market-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (max-width: 75rem) {
    .market-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .market-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
