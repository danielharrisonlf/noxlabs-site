---
/** Bloco destacado da página inicial para escritórios de contabilidade. */
import { accountingPains, accountingScenarios } from "../data/segments";
import Icon from "./Icon.astro";
import Stat from "./Stat.astro";
import { statById } from "../data/stats";

const featured = accountingScenarios.slice(0, 3);
const sectorStats = ["cfc-escritorios", "contabil-retrabalho"].map(statById).filter((s) => s !== undefined);
---

<section class="acc band" id="contabilidade" aria-labelledby="acc-title">
  <div class="wrap">
    <div class="acc-top">
      <header class="acc-head" data-reveal>
        <p class="kicker"><Icon name="calculator" />Para escritórios de contabilidade</p>
        <h2 id="acc-title" class="section-title">O escritório cresce. A digitação, não.</h2>
        <p class="section-lede">
          Contabilidade é o primeiro foco da Noxlabs. O mês do escritório tem rotinas que se repetem para cada cliente, e é
          exatamente aí que a automação devolve mais horas.
        </p>
      </header>

      <div class="acc-pains" data-reveal style="--i:1">
        <h3>Soa familiar?</h3>
        <ul role="list">
          {
            accountingPains.map((p) => (
              <li>
                <Icon name={p.icon} />
                {p.text}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      sectorStats.length > 0 && (
        <div class="acc-stats">
          {sectorStats.map((s, i) => (
            <Stat stat={s} index={i} />
          ))}
        </div>
      )
    }

    <h3 class="acc-sub" data-reveal>Como funcionaria no seu escritório</h3>
    <ul role="list" class="acc-scenarios">
      {
        featured.map((s, i) => (
          <li class="scn" data-reveal style={`--i:${i}`}>
            <span class="scn-icon">
              <Icon name={s.icon} />
            </span>
            <h4>{s.title}</h4>
            <p class="scn-today">
              <strong>Hoje:</strong> {s.today}
            </p>
            <p class="scn-gain">{s.gain}</p>
          </li>
        ))
      }
    </ul>

    <div class="acc-cta" data-reveal>
      <a class="btn btn-primary" href="/contabilidade/">
        Ver os seis cenários para contabilidade
        <Icon name="arrow-right" />
      </a>
      <p>Coleta de documentos, prazos, status para o cliente, digitação, entrada de cliente novo e fechamento.</p>
    </div>
  </div>
</section>

<style>
  .acc {
    padding-block: var(--section-y);
    position: relative;
    overflow: hidden;
  }

  .acc-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s-7) clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .acc-head {
    display: grid;
    gap: var(--s-4);
  }

  .acc-head .kicker :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .acc-pains {
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .acc-pains h3 {
    font-size: var(--t-md);
    margin-bottom: var(--s-3);
  }

  .acc-pains li {
    display: flex;
    align-items: start;
    gap: var(--s-3);
    padding-block: 0.55rem;
    border-bottom: 1px dashed var(--line);
    color: var(--ink-2);
  }

  .acc-pains li:last-child {
    border-bottom: 0;
  }

  .acc-pains :global(svg) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2em;
    color: var(--marca);
  }

  .acc-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-5);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .acc-sub {
    margin-top: clamp(3rem, 2.5rem + 2vw, 5rem);
    margin-bottom: var(--s-5);
    font-size: var(--t-xl);
  }

  .acc-scenarios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .scn {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .scn-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-sm);
    background: rgb(255 225 90 / 0.14);
    color: var(--marca);
  }

  .scn-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .scn h4 {
    font-size: var(--t-lg);
  }

  .scn-today {
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .scn-today strong {
    color: var(--ink);
  }

  .scn-gain {
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-weight: 600;
  }

  .acc-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-5);
    margin-top: var(--s-7);
  }

  .acc-cta p {
    color: var(--ink-2);
    font-size: var(--t-sm);
    max-width: 44ch;
  }

  @media (max-width: 63.99rem) {
    .acc-top {
      grid-template-columns: 1fr;
    }

    .acc-scenarios {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .acc-cta .btn {
      width: 100%;
    }
  }
</style>
