---
import { principles, steps } from "../data/content";

/* Os nós alternam de altura; o rastro passa por eles em onda. */
const heights = [100, 40, 100, 40];
const wave =
  "M 0 122 C 60 122, 80 100, 125 100 C 230 100, 270 40, 375 40 C 480 40, 520 100, 625 100 C 730 100, 770 40, 875 40 C 930 40, 960 30, 1000 20";
---

<section class="section process" id="processo" aria-labelledby="processo-title">
  <div class="wrap">
    <header class="process-head">
      <h2 id="processo-title" class="section-title">Como um projeto anda.</h2>
      <p class="section-lede">Quatro etapas, nesta ordem. Ao fim de cada uma, você decide se segue.</p>
    </header>

    <div class="journey">
      <svg class="wave" viewBox="0 0 1000 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="wave-key" d={wave}></path>
        <path class="wave-glow" d={wave} pathLength="1"></path>
        <path class="wave-core" d={wave} pathLength="1"></path>
      </svg>

      <ol class="steps" role="list">
        {
          steps.map((step, i) => (
            <li class="step" style={`--ny:${heights[i]}`}>
              <span class="step-node tabular" aria-hidden="true">
                {i + 1}
              </span>
              <h3>
                <span class="visually-hidden">Etapa {i + 1}: </span>
                {step.title}
              </h3>
              <p class="step-meta">{step.meta}</p>
              <p class="step-text">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="principles">
      <h3 class="principles-title">O que vale em qualquer projeto</h3>
      <ul role="list" class="principles-list">
        {
          principles.map((p) => (
            <li>
              <h4>{p.title}</h4>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .process-head {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .journey {
    position: relative;
  }

  .wave {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: 100%;
    height: 140px;
    overflow: visible;
  }

  .wave path {
    fill: none;
    stroke-linecap: round;
  }

  .wave-key {
    stroke: var(--line-2);
    stroke-width: 1.25;
    stroke-dasharray: 2 7;
  }

  .wave-glow {
    stroke: var(--sodio);
    stroke-width: 10;
    opacity: var(--trail-glow);
  }

  .wave-core {
    stroke: var(--sodio);
    stroke-width: 2.25;
  }

  /* O rastro se desenha conforme a seção atravessa a tela. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .wave-glow,
      .wave-core {
        stroke-dasharray: 1;
        animation: wave-draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 50%;
      }

      .step-node {
        animation: node-wake linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 45%;
      }
    }
  }

  @keyframes wave-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes node-wake {
    from {
      background: var(--bg);
      color: var(--fg-2);
      box-shadow: 0 0 0 0 transparent;
    }
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .step {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--s-2);
    padding: calc(var(--ny) * 1px - 1.375rem) var(--s-4) 0;
    text-align: center;
  }

  .step-node {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: var(--s-4);
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-fg);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    box-shadow:
      0 0 0 6px color-mix(in srgb, var(--sodio) 18%, transparent),
      0 0 24px color-mix(in srgb, var(--sodio) 55%, transparent);
  }

  .step h3 {
    font-size: var(--t-lg);
  }

  .step-meta {
    font-size: var(--t-sm);
    font-weight: 700;
    color: var(--link);
  }

  .step-text {
    margin-top: var(--s-2);
    color: var(--fg-2);
    max-width: 30ch;
  }

  .principles {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--r-xl);
    background: var(--bg-3);
  }

  .principles-title {
    font-size: var(--t-xl);
    margin-bottom: var(--s-6);
  }

  .principles-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) clamp(1.5rem, 3vw, 3rem);
  }

  .principles-list h4 {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: var(--s-2);
    font-family: var(--font-text);
    font-size: var(--t-base);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .principles-list h4::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sodio);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sodio) 18%, transparent);
  }

  .principles-list p {
    padding-left: 1.4rem;
    color: var(--fg-2);
    max-width: 38ch;
  }

  /* Estreito: o rastro vira uma linha vertical à esquerda. */
  @media (max-width: 63.99rem) {
    .wave {
      display: none;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: var(--s-7);
      padding-left: 0;
    }

    .steps::before {
      content: "";
      position: absolute;
      left: 1.375rem;
      top: 1.5rem;
      bottom: 1.5rem;
      width: 2px;
      margin-left: -1px;
      border-radius: 2px;
      background: linear-gradient(180deg, var(--sodio), var(--freio) 60%, var(--mercurio));
      opacity: 0.6;
    }

    .step {
      justify-items: start;
      text-align: left;
      padding: 0 0 0 4.25rem;
    }

    .step-node {
      position: absolute;
      left: 0;
      top: -0.35rem;
      margin: 0;
    }

    .principles-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .principles-list {
      grid-template-columns: 1fr;
    }
  }
</style>
