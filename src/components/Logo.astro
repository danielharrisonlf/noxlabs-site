---
/**
 * Marca Noxlabs: um "n" desenhado por um único rastro de luz, como numa foto
 * de longa exposição, com a fonte da luz acesa na ponta. Wordmark em
 * Funnel Display minúscula.
 */
interface Props {
  wordmark?: boolean;
  class?: string;
  /** Prefixo único do gradiente quando há mais de uma marca na página. */
  id?: string;
}

const { wordmark = true, class: className, id = "lg" } = Astro.props;
const grad = `${id}-trail`;
---

<span class:list={["logo", className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={grad} x1="7" y1="26" x2="25" y2="8" gradientUnits="userSpaceOnUse">
        <stop offset="0" class="logo-stop-a"></stop>
        <stop offset="1" class="logo-stop-b"></stop>
      </linearGradient>
    </defs>
    <path class="logo-glow" d="M8 26V15.5a8 8 0 0 1 16 0V24" stroke={`url(#${grad})`}></path>
    <path class="logo-trail" d="M8 26V15.5a8 8 0 0 1 16 0V24" stroke={`url(#${grad})`}></path>
    <circle class="logo-source" cx="24" cy="25" r="2.6"></circle>
  </svg>
  {wordmark && <span class="logo-word">noxlabs</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg);
  }

  .logo-mark {
    width: 1.875rem;
    height: 1.875rem;
    flex: none;
    overflow: visible;
  }

  .logo-trail,
  .logo-glow {
    fill: none;
    stroke-linecap: round;
  }

  .logo-trail {
    stroke-width: 3.6;
  }

  .logo-glow {
    stroke-width: 8;
    opacity: var(--trail-glow);
  }

  .logo-stop-a {
    stop-color: var(--sodio);
  }

  .logo-stop-b {
    stop-color: var(--freio);
  }

  .logo-source {
    fill: var(--fg);
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
