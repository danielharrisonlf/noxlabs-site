---
/**
 * Marca Noxlabs: quatro azulejos que se encaixam. Cada empresa é uma peça
 * diferente (um arco de porta, um canto arredondado), e juntas formam um
 * bloco só: a rotina encaixada. Wordmark em Parkinsans 700, minúsculas.
 * O mesmo desenho está em scripts/og-image.mjs (favicon, ícones e OG).
 */
interface Props {
  wordmark?: boolean;
  class?: string;
}

const { wordmark = true, class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <rect class="lm-a" width="15" height="15" rx="4"></rect>
    <path class="lm-b" d="M17 15V8.5a7.5 7.5 0 0 1 15 0V15Z"></path>
    <path class="lm-c" d="M0 17h15v15H7.5A7.5 7.5 0 0 1 0 24.5Z"></path>
    <rect class="lm-a" x="17" y="17" width="15" height="15" rx="4"></rect>
  </svg>
  {wordmark && <span class="logo-word">noxlabs</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }

  .logo-mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  .lm-a {
    fill: var(--jabu);
  }

  .lm-b {
    fill: var(--goiaba);
  }

  .lm-c {
    fill: var(--caju);
  }

  :global(.dark) .lm-a {
    fill: #fbf3fb;
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
