---
/**
 * Marca Noxlabs: um quadrado de nanquim e um círculo anil sobreimpresso no
 * canto, como uma lua nascendo atrás de um bloco. Wordmark em Jost minúscula,
 * à maneira dos poemas concretos.
 */
interface Props {
  wordmark?: boolean;
  class?: string;
}

const { wordmark = true, class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <rect x="1" y="11" width="20" height="20" fill="currentColor"></rect>
    <circle cx="21" cy="11" r="10" class="logo-moon"></circle>
  </svg>
  {wordmark && <span class="logo-word">noxlabs</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
  }

  .logo-mark {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
  }

  .logo-moon {
    fill: var(--anil);
    mix-blend-mode: multiply;
  }

  :global(:root[data-theme="dark"]) .logo-moon {
    mix-blend-mode: normal;
    opacity: 0.92;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .logo-moon {
      mix-blend-mode: normal;
      opacity: 0.92;
    }
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }
</style>
