---
/**
 * Marca Noxlabs: um "n" cuja perna direita termina num visto. A rotina que
 * se resolve: o traço da letra vira o sinal de "feito". Ladrilho verde-pinho,
 * letra branca, visto em marca-texto. Wordmark em Bricolage Grotesque.
 */
interface Props {
  wordmark?: boolean;
  class?: string;
}

const { wordmark = true, class: className } = Astro.props;
---

<span class:list={["logo", className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" class="logo-tile"></rect>
    <path class="logo-n" d="M9.5 23V14.6a4.1 4.1 0 0 1 8.2 0v2"></path>
    <path class="logo-tick" d="M17.7 16.6V22.6L23.8 13.2"></path>
  </svg>
  {wordmark && <span class="logo-word">noxlabs</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
  }

  .logo-mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  .logo-tile {
    fill: var(--pine);
  }

  :global(.band) .logo-tile {
    fill: #ffffff;
    fill-opacity: 0.1;
  }

  .logo-n,
  .logo-tick {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .logo-n {
    stroke: #ffffff;
  }

  .logo-tick {
    stroke: var(--marca);
  }

  .logo-word {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }
</style>
