---
/**
 * Ícones de traço único (1.75px, pontas retas), desenhados para o site.
 * Decorativos por padrão: o texto ao lado ou o aria-label do controle
 * carrega o significado.
 */
type Name = "arrow-right" | "arrow-up-right" | "mail" | "copy" | "check" | "sun" | "moon" | "menu" | "close";

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-right" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7M8 7h9v9" />}
  {name === "mail" && (
    <>
      <path d="M3.5 5.5h17v13h-17z" />
      <path d="m3.5 6 8.5 7 8.5-7" />
    </>
  )}
  {name === "copy" && (
    <>
      <path d="M8.5 8.5h11v11h-11z" />
      <path d="M15.5 8.5v-4h-11v11h4" />
    </>
  )}
  {name === "check" && <path d="m4.5 12.5 5 5 10-11" />}
  {name === "sun" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
    </>
  )}
  {name === "moon" && <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" />}
  {name === "menu" && <path d="M3.5 7h17M3.5 12h17M3.5 17h17" />}
  {name === "close" && <path d="m5.5 5.5 13 13M18.5 5.5l-13 13" />}
</svg>
