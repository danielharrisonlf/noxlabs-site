---
/**
 * Ícones de traço único (1,75px, pontas arredondadas como um rastro de luz),
 * desenhados para o site. Decorativos por padrão: o texto ao lado ou o
 * aria-label do controle carrega o significado.
 */
type Name =
  | "arrow-right"
  | "arrow-left"
  | "arrow-up-right"
  | "mail"
  | "copy"
  | "check"
  | "sun"
  | "moon"
  | "menu"
  | "close"
  | "play"
  | "pause"
  | "replay"
  | "plus";

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-right" && <path d="M4.5 12h14.5M13.5 6.5 19 12l-5.5 5.5" />}
  {name === "arrow-left" && <path d="M19.5 12H5M10.5 6.5 5 12l5.5 5.5" />}
  {name === "arrow-up-right" && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === "mail" && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="3" />
      <path d="m4.5 7.5 7.5 5.5 7.5-5.5" />
    </>
  )}
  {name === "copy" && (
    <>
      <rect x="8.5" y="8.5" width="11" height="11" rx="2.5" />
      <path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2" />
    </>
  )}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7" />}
  {name === "sun" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    </>
  )}
  {name === "moon" && <path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "play" && <path d="M8 5.5v13l10.5-6.5L8 5.5Z" />}
  {name === "pause" && <path d="M8.5 5.5v13M15.5 5.5v13" />}
  {name === "replay" && <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3M4.5 4.5v4h4" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
</svg>
