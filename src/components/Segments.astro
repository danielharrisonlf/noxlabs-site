---
import { segments } from "../data/segments";
import { talkMailto } from "../data/site";
import Icon from "./Icon.astro";
---

<section class="section segs" id="segmentos" aria-labelledby="segmentos-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2 id="segmentos-title" class="section-title">Outros ramos, a mesma conta: tempo da equipe em tarefa repetida.</h2>
      <p class="section-lede">
        A rotina muda de nome em cada ramo, mas o padrão se repete. Alguns exemplos do que dá para tirar da mão da equipe.
      </p>
    </header>

    <ul role="list" class="seg-grid">
      {
        segments.map((s, i) => (
          <li class="seg" data-reveal style={`--i:${i % 3}`}>
            <div class="seg-top">
              <span class="seg-icon">
                <Icon name={s.icon} />
              </span>
              <h3>{s.name}</h3>
            </div>
            <p class="seg-pains">{s.pains}</p>
            <ul role="list" class="checks seg-ideas">
              {s.ideas.map((idea) => (
                <li>{idea}</li>
              ))}
            </ul>
            {s.proof &&
              (s.proof.href ? (
                <a class="seg-proof" href={s.proof.href}>
                  {s.proof.text}
                  <Icon name="arrow-right" />
                </a>
              ) : (
                <p class="seg-proof">{s.proof.text}</p>
              ))}
          </li>
        ))
      }
      <li class="seg seg-other" data-reveal style="--i:2">
        <h3>O seu ramo não está aqui?</h3>
        <p>
          Indústria pequena, escola, agência, cooperativa: se a equipe repete a mesma tarefa toda semana, vale a conversa.
        </p>
        <a class="btn btn-secondary" href={talkMailto("Automação no meu ramo")}>
          Contar como é a rotina
          <Icon name="arrow-right" />
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .seg-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .seg {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s-4);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .seg-top {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .seg-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-sm);
    background: var(--sunken);
    color: var(--pine-ink);
  }

  .seg-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .seg h3 {
    font-size: var(--t-md);
    line-height: 1.2;
  }

  .seg-pains {
    color: var(--ink-2);
    font-size: var(--t-sm);
  }

  .seg-ideas {
    font-size: var(--t-sm);
  }

  .seg-ideas li {
    color: var(--ink);
  }

  .seg-proof {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 2.75rem;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    font-size: var(--t-sm);
    font-weight: 650;
    color: var(--ink-2);
    text-decoration: none;
  }

  a.seg-proof {
    color: var(--caneta);
  }

  .seg-proof :global(svg) {
    flex: none;
    width: 1rem;
    height: 1rem;
    transition: transform var(--d-base) var(--ease-spring);
  }

  @media (hover: hover) {
    a.seg-proof:hover {
      text-decoration: underline;
    }

    a.seg-proof:hover :global(svg) {
      transform: translateX(3px);
    }
  }

  .seg-other {
    grid-template-rows: auto 1fr auto;
    border-style: dashed;
    border-color: var(--line-2);
    background: transparent;
    box-shadow: none;
  }

  .seg-other p {
    color: var(--ink-2);
  }

  .seg-other .btn {
    justify-self: start;
  }

  @media (max-width: 63.99rem) {
    .seg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 39.99rem) {
    .seg-grid {
      grid-template-columns: 1fr;
    }

    .seg-other .btn {
      justify-self: stretch;
    }
  }
</style>
